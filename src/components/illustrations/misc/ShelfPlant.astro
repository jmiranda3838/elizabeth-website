---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

/* A heartleaf philodendron in a terracotta pot: the left bookend of the Resources shelf.

   The drawing is 124 x 236. The pot stands on y = 200, which is where the shelf's plank
   begins; the last 36 units are the long vine that trails over the plank's front edge.
   Light comes from the upper right (the page's window light), so the pot is brightest on
   its right shoulder and every leaf carries its shadow on the half turned away.

   The mound of leaves is placed by hand, back to front. The two trailing vines grow their
   leaves from a fixed seed, so they are irregular but identical on every build. */

type Pt = [number, number];
interface Leaf {
  x: number;
  y: number;
  a: number;
  s: number;
  tone: number;
}

let seed = 23;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const jit = (a: number, b: number) => a + (b - a) * rnd();
const f = (n: number) => Math.round(n * 10) / 10;
const rad = (deg: number) => (deg * Math.PI) / 180;

// A heart-shaped leaf pointing along +x from its stalk, 16 long: two lobes at the stalk,
// a drawn-out tip. LEAF_SHADE is the half below the midrib.
const LEAF: Pt[] = [
  [0, 0],
  [-2.8, -2.6],
  [-1.6, -7.6],
  [3.8, -7.5],
  [8.8, -7.4],
  [12.2, -3.2],
  [16, 0.8],
  [11.8, 3],
  [8.6, 7.3],
  [3.6, 6.9],
  [-1.2, 6.5],
  [-2.6, 2.6],
  [0, 0],
];
const LEAF_SHADE: Pt[] = [
  [0, 0],
  [5, 1.3],
  [10.6, 1.3],
  [16, 0.8],
  [11.8, 3],
  [8.6, 7.3],
  [3.6, 6.9],
  [-1.2, 6.5],
  [-2.6, 2.6],
  [0, 0],
];

/** Does the leaf's lower half face away from the light (upper right)? If not, mirror it. */
const flipFor = (a: number) => (-Math.sin(rad(a)) - Math.cos(rad(a)) < 0 ? 1 : -1);

function stamp(shape: Pt[], l: Leaf): string {
  const c = Math.cos(rad(l.a)) * l.s;
  const s = Math.sin(rad(l.a)) * l.s;
  const k = flipFor(l.a);
  const p = shape.map(([x, y]): Pt => [l.x + x * c - y * k * s, l.y + x * s + y * k * c]);
  let d = `M${f(p[0][0])} ${f(p[0][1])}`;
  for (let i = 1; i < p.length; i += 3) {
    d += `C${f(p[i][0])} ${f(p[i][1])} ${f(p[i + 1][0])} ${f(p[i + 1][1])} ${f(p[i + 2][0])} ${f(p[i + 2][1])}`;
  }
  return d + "Z";
}
/** Midrib and two pairs of side veins */
function veins(l: Leaf): string {
  const c = Math.cos(rad(l.a)) * l.s;
  const s = Math.sin(rad(l.a)) * l.s;
  const k = flipFor(l.a);
  const at = (x: number, y: number) =>
    `${f(l.x + x * c - y * k * s)} ${f(l.y + x * s + y * k * c)}`;
  return (
    `M${at(0.4, 0)}Q${at(8, 1.2)} ${at(14.6, 0.8)}` +
    `M${at(3, 0.4)}Q${at(4.6, -2.6)} ${at(7.4, -4.6)}M${at(3.2, 0.5)}Q${at(4.8, 3)} ${at(7, 4.6)}` +
    `M${at(7.4, 0.9)}Q${at(9, -1)} ${at(11, -2.2)}M${at(7.6, 1)}Q${at(9.2, 2.4)} ${at(10.8, 3)}`
  );
}

/** A smooth stem through hand-placed points, plus a sampler (position + heading) */
function cane(pts: Pt[]) {
  const seg = (i: number): Pt[] => {
    const p0 = pts[Math.max(i - 1, 0)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(i + 2, pts.length - 1)];
    return [
      p1,
      [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6],
      [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6],
      p2,
    ];
  };
  let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const [, c1, c2, p] = seg(i);
    d += `C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p[0])} ${f(p[1])}`;
  }
  const at = (u: number) => {
    const x = Math.min(Math.max(u, 0), 0.9999) * (pts.length - 1);
    const i = Math.floor(x);
    const t = x - i;
    const m = 1 - t;
    const [a, b, c, e] = seg(i);
    const pos = (k: 0 | 1) =>
      m * m * m * a[k] + 3 * m * m * t * b[k] + 3 * m * t * t * c[k] + t * t * t * e[k];
    const der = (k: 0 | 1) =>
      3 * m * m * (b[k] - a[k]) + 6 * m * t * (c[k] - b[k]) + 3 * t * t * (e[k] - c[k]);
    return { x: pos(0), y: pos(1), ang: (Math.atan2(der(1), der(0)) * 180) / Math.PI };
  };
  return { d, at };
}

/** Leaves alternating down a trailing vine, each on a short stalk, smaller toward the tip */
function trail(pts: Pt[], n: number, from: number, big: number, small: number) {
  const vine = cane(pts);
  const leaves: Leaf[] = [];
  let stalks = "";
  for (let i = 0; i < n; i++) {
    const u = from + ((1 - from) * (i + jit(0.1, 0.5))) / n;
    const p = vine.at(u);
    const side = i % 2 ? 1 : -1;
    const a = p.ang + side * jit(48, 78);
    const len = jit(2.6, 4.4);
    const x = p.x + Math.cos(rad(a)) * len;
    const y = p.y + Math.sin(rad(a)) * len;
    stalks += `M${f(p.x)} ${f(p.y)}L${f(x)} ${f(y)}`;
    // hanging leaves turn their tips back down toward the floor
    const droop = a + (90 - a) * jit(0.2, 0.42);
    leaves.push({
      x,
      y,
      a: droop,
      s: (big + ((small - big) * i) / (n - 1)) * jit(0.9, 1.08),
      tone: i % 3 === 1 ? 0 : rnd() < 0.5 ? 1 : 2,
    });
  }
  // the unfurling tip
  const tip = vine.at(1);
  leaves.push({ x: tip.x, y: tip.y, a: tip.ang + 8, s: small * 0.62, tone: 3 });
  return { d: vine.d + stalks, leaves };
}

// 0 light, 1 mid, 2 deep, 3 the bronze-pink of a new leaf
const TONES = ["#b7c9bc", "#9cb3a5", "#839b8d", "#d6b9a9"];

// The mound: [stalk-end x, y, angle the tip points, size, tone], back to front
const back: Leaf[] = (
  [
    [50, 92, -124, 1.3, 2],
    [69, 82, -84, 1.34, 2],
    [87, 93, -42, 1.26, 2],
    [37, 110, -166, 1.2, 2],
    [99, 110, -12, 1.2, 2],
  ] as number[][]
).map(([x, y, a, s, tone]) => ({ x, y, a, s, tone }));
const middle: Leaf[] = (
  [
    [57, 103, -108, 1.4, 1],
    [79, 98, -58, 1.44, 1],
    [44, 119, -152, 1.34, 1],
    [92, 119, -24, 1.34, 1],
    [66, 93, -96, 1.02, 3],
  ] as number[][]
).map(([x, y, a, s, tone]) => ({ x, y, a, s, tone }));
const front: Leaf[] = (
  [
    [59, 119, -128, 1.3, 0],
    [77, 116, -48, 1.36, 0],
    [67, 111, -86, 1.06, 1],
    [50, 129, 168, 1.26, 1],
    [86, 128, 14, 1.3, 0],
    [69, 127, 64, 1.1, 0],
  ] as number[][]
).map(([x, y, a, s, tone]) => ({ x, y, a, s, tone }));

// Leaf stalks of the mound, from the crown of the plant to each leaf
const crown: Pt = [66, 131];
const stalks = [...back, ...middle, ...front]
  .map((l, i) => {
    const bx = crown[0] + (l.x - crown[0]) * 0.18 + (i % 2 ? 1.5 : -1.5);
    const mx = (bx + l.x) / 2 + (l.x < crown[0] ? -3 : 3);
    const my = (crown[1] + l.y) / 2 - 3;
    return `M${f(bx)} ${crown[1]}Q${f(mx)} ${f(my)} ${f(l.x)} ${f(l.y)}`;
  })
  .join("");

// The long vine that goes over the plank's edge, and a short one down the pot's sunny side
const longVine = trail(
  [
    [56, 131],
    [38, 127],
    [25, 139],
    [22, 160],
    [26, 182],
    [19, 203],
    [17, 219],
    [22, 231],
  ],
  9,
  0.16,
  1.12,
  0.72,
);
const shortVine = trail(
  [
    [76, 131],
    [91, 130],
    [100, 141],
    [101, 158],
    [97, 172],
    [101, 184],
  ],
  5,
  0.3,
  1.02,
  0.7,
);

const layers = [
  { leaves: back, dim: 0.86 },
  { leaves: middle, dim: 1 },
  { leaves: front, dim: 1 },
];
---

<svg
  class={className}
  style={style}
  aria-hidden="true"
  {...rest}
  viewBox="0 0 124 236"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="shelfplant-pot" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#b47a66"></stop>
      <stop offset="0.3" stop-color="#cc917a"></stop>
      <stop offset="0.72" stop-color="#e2b29b"></stop>
      <stop offset="0.9" stop-color="#e9c0aa"></stop>
      <stop offset="1" stop-color="#d7a48d"></stop>
    </linearGradient>
    <linearGradient id="shelfplant-rim" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#be846f"></stop>
      <stop offset="0.35" stop-color="#d79f88"></stop>
      <stop offset="0.8" stop-color="#eec6b1"></stop>
      <stop offset="1" stop-color="#dcaa93"></stop>
    </linearGradient>
  </defs>

  <!-- Where the saucer meets the plank -->
  <ellipse cx="64" cy="199.6" rx="33" ry="2.2" fill="#6f5443" fill-opacity="0.28"></ellipse>

  <!-- Back leaves and their stalks, behind the pot's rim -->
  <path d={stalks} stroke="#8aa192" stroke-width="0.9" stroke-linecap="round"></path>
  {
    layers.slice(0, 2).map((layer) =>
      layer.leaves.map((l) => (
        <g opacity={layer.dim}>
          <path
            d={stamp(LEAF, l)}
            fill={TONES[l.tone]}
            stroke="#6f8779"
            stroke-opacity="0.5"
            stroke-width="0.4"
          />
          <path d={stamp(LEAF_SHADE, l)} fill="#55695d" fill-opacity="0.2" />
          <path
            d={veins(l)}
            stroke="#f4f7f0"
            stroke-opacity="0.55"
            stroke-width="0.45"
            stroke-linecap="round"
          />
        </g>
      )),
    )
  }

  <!-- Saucer -->
  <path
    d="M39 191.5 H93 C94.6 191.5 95.4 192.8 94.8 194.2 L92.6 198.6 C92.2 199.5 91.4 200 90.4 200 H41.6 C40.6 200 39.8 199.5 39.4 198.6 L37.2 194.2 C36.6 192.8 37.4 191.5 39 191.5 Z"
    fill="url(#shelfplant-rim)"></path>
  <path d="M39 192 H93" stroke="#f3d4c2" stroke-width="0.9" stroke-linecap="round"></path>
  <path d="M41 199.4 H91" stroke="#a56e5b" stroke-opacity="0.5" stroke-width="0.8"></path>

  <!-- Pot body: a gentle taper, with the rim's shadow lying across its shoulder -->
  <path
    d="M40.5 139 H91.5 L85.6 189.4 C85.4 191 84.2 192 82.6 192 H49.4 C47.8 192 46.6 191 46.4 189.4 Z"
    fill="url(#shelfplant-pot)"></path>
  <path d="M40.5 139 H91.5 L90.9 144.4 C75 146.6 57 146.6 41.1 144.4 Z" fill="#8f5a48" opacity="0.3"
  ></path>
  <!-- Shadow side, and the light that slips round the right edge -->
  <path
    d="M40.5 139 L46.4 189.4 C46.6 191 47.8 192 49.4 192 H56 C52.6 176 50.4 158 50 139 Z"
    fill="#8f5a48"
    opacity="0.2"></path>
  <path
    d="M84 146 C83.6 160 82.4 174 80.6 188"
    stroke="#f6dccd"
    stroke-opacity="0.75"
    stroke-width="1.6"
    stroke-linecap="round"></path>
  <!-- Throwing rings, two blooms of mineral salts, one small chip in the rim -->
  <path
    d="M43.4 160 C58 162.6 74 162.6 88.8 160 M45 174 C59 176.4 73 176.4 87.2 174"
    stroke="#a56e5b"
    stroke-opacity="0.38"
    stroke-width="0.7"
    stroke-linecap="round"
    stroke-dasharray="14 3 22 4 9 3"></path>
  <path
    d="M50.6 178 C53 174 58.6 175.4 60 178.6 C63.6 177 68.4 179.4 67.6 183 C70.6 184.6 69.6 188.8 65.6 188.6 C62 190.4 55.6 190 53.4 187 C49.8 186.6 48.4 181.4 50.6 178 Z"
    fill="#f7e6da"
    opacity="0.14"></path>
  <path
    d="M79 150 C81 148.6 83.6 150 83 152.6 C84.6 155 82.4 157.6 80 156.4 C77.6 156.6 76.6 152 79 150 Z"
    fill="#f7e6da"
    opacity="0.2"></path>

  <!-- Rim -->
  <path
    d="M37.4 127.6 H94.6 C96.6 127.6 97.8 129 97.6 130.8 L96.9 136.6 C96.7 138.2 95.5 139.2 93.9 139.2 H38.1 C36.5 139.2 35.3 138.2 35.1 136.6 L34.4 130.8 C34.2 129 35.4 127.6 37.4 127.6 Z"
    fill="url(#shelfplant-rim)"></path>
  <path d="M37.6 128.3 H94.4" stroke="#f8dfd0" stroke-width="1" stroke-linecap="round"></path>
  <path d="M38 138.7 H94" stroke="#a56e5b" stroke-opacity="0.55" stroke-width="0.8"></path>
  <path d="M73.6 127.6 l1.6 2 l2.4 -0.6 l1 -1.4 Z" fill="#a56e5b" opacity="0.55"></path>

  <!-- Shadows the hanging leaves throw on the pot -->
  <path
    d="M41 131 C44 136 52 137.6 56 134 C58 138 66 144 72 146 C76 140 80 134 79 130 C84 136 92 137 97 132 L96.9 136.6 C96.7 138.2 95.5 139.2 93.9 139.2 H91.5 L88.4 166 C86.4 159 84.4 150 82 143 C70 150 52 146 41 131 Z"
    fill="#7a4f40"
    opacity="0.16"></path>

  <!-- The vines -->
  <path
    d={longVine.d + shortVine.d}
    stroke="#7f9686"
    stroke-width="1.05"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  {
    [...shortVine.leaves, ...longVine.leaves, ...layers[2].leaves].map((l) => (
      <g>
        <path
          d={stamp(LEAF, l)}
          fill={TONES[l.tone]}
          stroke="#6f8779"
          stroke-opacity="0.55"
          stroke-width="0.4"
        />
        <path d={stamp(LEAF_SHADE, l)} fill="#55695d" fill-opacity="0.2" />
        <path
          d={veins(l)}
          stroke="#f4f7f0"
          stroke-opacity="0.6"
          stroke-width="0.45"
          stroke-linecap="round"
        />
      </g>
    ))
  }
</svg>
