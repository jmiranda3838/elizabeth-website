---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

/* Three stems of dried lavender and a sprig of silver-dollar eucalyptus, tucked into the
   kraft pocket of the closing library card behind the patron photo, fanning out to its
   left. The drawing is 132 x 200; the stems gather at its lower right corner, which sits
   inside the pocket, so only the heads that clear the photo and the pocket show.

   Light comes from the upper right, as everywhere on the page. The lavender florets and
   the leaf jitter come from a fixed seed: irregular, but the same on every build. */

let seed = 1301;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const jit = (a: number, b: number) => a + (b - a) * rnd();
const f = (n: number) => Math.round(n * 10) / 10;
const rad = (deg: number) => (deg * Math.PI) / 180;

/** A small oval leaning out from a stem (a lavender floret) */
function dab(x: number, y: number, ang: number, rx: number, ry: number): string {
  const dx = Math.cos(rad(ang)) * rx;
  const dy = Math.sin(rad(ang)) * rx;
  const arc = `a${f(rx)} ${f(ry)} ${Math.round(ang)} 1 1 `;
  return `M${f(x - dx)} ${f(y - dy)}${arc}${f(2 * dx)} ${f(2 * dy)}${arc}${f(-2 * dx)} ${f(-2 * dy)}Z`;
}

/** A point, and the direction of travel, on a quadratic stem */
function along(b: number[], c: number[], t: number[], u: number) {
  const m = 1 - u;
  const x = m * m * b[0] + 2 * m * u * c[0] + u * u * t[0];
  const y = m * m * b[1] + 2 * m * u * c[1] + u * u * t[1];
  const ang =
    (Math.atan2(
      2 * m * (c[1] - b[1]) + 2 * u * (t[1] - c[1]),
      2 * m * (c[0] - b[0]) + 2 * u * (t[0] - c[0]),
    ) *
      180) /
    Math.PI;
  return { x, y, ang };
}

// --- Lavender: [base, bend, tip] for each stem
const LAV: number[][][] = [
  [
    [118, 196],
    [78, 128],
    [18, 62],
  ],
  [
    [120, 196],
    [70, 146],
    [4, 96],
  ],
  [
    [116, 196],
    [90, 120],
    [42, 44],
  ],
];
const TONES = ["#857c9b", "#a198b4", "#bfb7cb"];
let lavStems = "";
const florets = ["", "", ""];
for (const [b, c, t] of LAV) {
  lavStems += `M${b[0]} ${b[1]}Q${c[0]} ${c[1]} ${t[0]} ${t[1]}`;
  const whorls = 9 + Math.round(jit(0, 2));
  for (let w = 0; w < whorls; w++) {
    const u = 0.66 + (0.34 * w) / whorls;
    const p = along(b, c, t, u);
    const size = 1.25 * (1 - (0.4 * w) / whorls);
    const nx = Math.cos(rad(p.ang + 90));
    const ny = Math.sin(rad(p.ang + 90));
    florets[0] += dab(
      p.x - nx * 1.8 * size,
      p.y - ny * 1.8 * size,
      p.ang - 40,
      2.4 * size,
      1.35 * size,
    );
    florets[1] += dab(
      p.x + nx * 1.8 * size,
      p.y + ny * 1.8 * size,
      p.ang + 40,
      2.4 * size,
      1.35 * size,
    );
    if (w % 2 === 0 || rnd() < 0.45) {
      florets[2] += dab(
        p.x + jit(-0.5, 0.5),
        p.y + jit(-0.5, 0.5),
        p.ang + jit(-12, 12),
        2 * size,
        1.15 * size,
      );
    }
  }
}

// --- Eucalyptus: round leaves in pairs up an arching stem, smaller toward the tip
const EB = [122, 194];
const EC = [90, 138];
const ET = [6, 126];
const eStem = `M${EB[0]} ${EB[1]}Q${EC[0]} ${EC[1]} ${ET[0]} ${ET[1]}`;
interface Coin {
  x: number;
  y: number;
  r: number;
  a: number;
}
const coins: Coin[] = [];
const PAIRS = 5;
for (let i = 0; i < PAIRS; i++) {
  const u = 0.6 + (0.38 * i) / (PAIRS - 1);
  const p = along(EB, EC, ET, u);
  const r = 9.6 - i * 1.2 + jit(-0.5, 0.5);
  for (const side of [-1, 1]) {
    const a = p.ang + side * jit(62, 80);
    const reach = r * 0.78;
    coins.push({
      x: p.x + Math.cos(rad(a)) * reach,
      y: p.y + Math.sin(rad(a)) * reach,
      r: r * jit(0.92, 1.06),
      a: a,
    });
  }
}
// one leaf at the very tip
coins.push({ x: ET[0] - 3, y: ET[1] - 1.4, r: 4.2, a: 200 });

/** A slightly oval leaf, its stalk toward the stem, its midrib along `a` */
function coin(c: Coin): string {
  const rx = c.r;
  const ry = c.r * 0.9;
  return `M${f(c.x + rx)} ${f(c.y)}a${f(rx)} ${f(ry)} 0 1 1 ${f(-2 * rx)} 0a${f(rx)} ${f(ry)} 0 1 1 ${f(2 * rx)} 0Z`;
}
function rib(c: Coin): string {
  const bx = c.x - Math.cos(rad(c.a)) * c.r * 0.9;
  const by = c.y - Math.sin(rad(c.a)) * c.r * 0.9;
  const ex = c.x + Math.cos(rad(c.a)) * c.r * 0.55;
  const ey = c.y + Math.sin(rad(c.a)) * c.r * 0.55;
  return `M${f(bx)} ${f(by)}L${f(ex)} ${f(ey)}`;
}
// leaves farther from the light (lower left) are drawn first, so the lit ones overlap them
coins.sort((p, q) => p.x - p.y - (q.x - q.y));
---

<svg
  class={className}
  style={style}
  aria-hidden="true"
  {...rest}
  viewBox="0 0 132 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id="pocket-coin" cx="0.66" cy="0.3" r="0.85">
      <stop offset="0" stop-color="#c9d6cd"></stop>
      <stop offset="0.5" stop-color="#9fb3a7"></stop>
      <stop offset="1" stop-color="#6f877b"></stop>
    </radialGradient>
  </defs>

  <!-- Eucalyptus, lying behind the lavender -->
  <path d={eStem} stroke="#9a8f86" stroke-width="1.5" stroke-linecap="round"></path>
  <path
    d={eStem}
    stroke="#c7bdb2"
    stroke-width="0.5"
    stroke-linecap="round"
    transform="translate(0.4 -0.5)"></path>
  {
    coins.map((c) => (
      <>
        <path d={coin(c)} fill="url(#pocket-coin)" stroke="#6a8175" stroke-width="0.45" />
        <path d={rib(c)} stroke="#e4ece6" stroke-opacity="0.7" stroke-width="0.55" />
      </>
    ))
  }
  <!-- the waxy bloom that gives eucalyptus its silver -->
  {
    coins.map((c) => (
      <ellipse
        cx={f(c.x + c.r * 0.28)}
        cy={f(c.y - c.r * 0.34)}
        rx={f(c.r * 0.42)}
        ry={f(c.r * 0.24)}
        transform={`rotate(-30 ${f(c.x + c.r * 0.28)} ${f(c.y - c.r * 0.34)})`}
        fill="#ffffff"
        fill-opacity="0.32"
      />
    ))
  }

  <!-- Dried lavender -->
  <path d={lavStems} stroke="#8f9b86" stroke-width="0.95" stroke-linecap="round"></path>
  {florets.map((d, t) => <path d={d} fill={TONES[t]} />)}
</svg>
