---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

/* A single cosmos in a small glass bud vase, with a closed bud and a few threads of its
   feathery leaf. It stands on the Resources shelf beside the framed photo. The drawing
   is 48 x 132 and the vase's foot is at y = 132.

   Light comes from the upper right (the page's window light), as on the plant and the
   lavender bottle: the petals turned toward it are lit, the glass shines down its right
   side, and the shadow falls left. Petal edges are jittered from a fixed seed, so the
   bloom is irregular but the same on every build. */

type Pt = [number, number];

let seed = 41;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const jit = (a: number, b: number) => a + (b - a) * rnd();
const f = (n: number) => Math.round(n * 10) / 10;
const rad = (deg: number) => (deg * Math.PI) / 180;

// The bloom is drawn face-on around (0, 0) and then tipped back into a three-quarter view
// by the group transform below. A cosmos petal: narrow at the eye, widest near the end,
// and finished with three shallow teeth.
const PETAL: Pt[] = [
  [0, 0],
  [0.24, -0.12],
  [0.58, -0.25],
  [0.84, -0.23],
  [0.92, -0.2],
  [0.95, -0.12],
  [0.93, -0.07],
  [0.98, -0.03],
  [1.0, 0.01],
  [0.94, 0.06],
  [0.96, 0.13],
  [0.86, 0.22],
  [0.6, 0.25],
  [0.26, 0.12],
  [0, 0],
];

function petal(ang: number, len: number, wide: number): string {
  const c = Math.cos(rad(ang));
  const s = Math.sin(rad(ang));
  const p = PETAL.map(([x, y]): Pt => {
    const yy = y * wide;
    return [(x * c - yy * s) * len, (x * s + yy * c) * len];
  });
  // the two flanks are curves, the toothed end is straight segments
  let d = `M${f(p[0][0])} ${f(p[0][1])}`;
  d += `C${f(p[1][0])} ${f(p[1][1])} ${f(p[2][0])} ${f(p[2][1])} ${f(p[3][0])} ${f(p[3][1])}`;
  for (let i = 4; i <= 11; i++) d += `L${f(p[i][0])} ${f(p[i][1])}`;
  d += `C${f(p[12][0])} ${f(p[12][1])} ${f(p[13][0])} ${f(p[13][1])} ${f(p[14][0])} ${f(p[14][1])}Z`;
  return d;
}

function veins(ang: number, len: number): string {
  let d = "";
  for (const off of [-0.09, 0, 0.09]) {
    const pts: Pt[] = [0.18, 0.5, 0.78].map((u) => {
      const x = u * len;
      const y = off * len * (0.4 + u);
      return [
        x * Math.cos(rad(ang)) - y * Math.sin(rad(ang)),
        x * Math.sin(rad(ang)) + y * Math.cos(rad(ang)),
      ];
    });
    d += `M${f(pts[0][0])} ${f(pts[0][1])}Q${f(pts[1][0])} ${f(pts[1][1])} ${f(pts[2][0])} ${f(pts[2][1])}`;
  }
  return d;
}

// Eight petals. Those whose tips point up (y < 0) lie behind the eye in the tipped view
// and are drawn first, in shadow; the lit ones face the upper right.
const petals = Array.from({ length: 8 }, (_, i) => {
  const ang = 14 + i * 45 + jit(-7, 7);
  return { ang, len: jit(11.6, 13), wide: jit(0.92, 1.1) };
}).sort((a, b) => Math.sin(rad(a.ang)) - Math.sin(rad(b.ang)));

const back = petals.filter((p) => Math.sin(rad(p.ang)) < 0);
const front = petals.filter((p) => Math.sin(rad(p.ang)) >= 0);
// petals on the right-hand side of the bloom catch the window light
const lit = (a: number) => Math.cos(rad(a)) > 0.3;

// Stamens ringing the eye
let stamens = "";
for (let i = 0; i < 16; i++) {
  const a = rad(i * 22.5 + jit(-5, 5));
  const r = jit(2.7, 3.3);
  stamens += `M${f(Math.cos(a) * r)} ${f(Math.sin(a) * r)}h0`;
}
---

<svg
  class={className}
  style={style}
  aria-hidden="true"
  {...rest}
  viewBox="0 0 48 132"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id="budvase-petal" cx="0" cy="0" r="13" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#9a5552"></stop>
      <stop offset="0.28" stop-color="#bf7f7a"></stop>
      <stop offset="0.7" stop-color="#dba7a1"></stop>
      <stop offset="1" stop-color="#ecc6bf"></stop>
    </radialGradient>
    <radialGradient id="budvase-eye" cx="0.62" cy="0.34" r="0.8">
      <stop offset="0" stop-color="#f1d595"></stop>
      <stop offset="0.55" stop-color="#cf9f4c"></stop>
      <stop offset="1" stop-color="#8e6a2c"></stop>
    </radialGradient>
    <linearGradient id="budvase-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#c3cfcd" stop-opacity="0.8"></stop>
      <stop offset="0.32" stop-color="#e2eae8" stop-opacity="0.55"></stop>
      <stop offset="0.74" stop-color="#f4f8f6" stop-opacity="0.6"></stop>
      <stop offset="1" stop-color="#cfdbd8" stop-opacity="0.8"></stop>
    </linearGradient>
    <linearGradient id="budvase-water" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#9fb6b2" stop-opacity="0.5"></stop>
      <stop offset="0.6" stop-color="#cfe0dc" stop-opacity="0.32"></stop>
      <stop offset="1" stop-color="#a9bfbb" stop-opacity="0.5"></stop>
    </linearGradient>
    <linearGradient id="budvase-bud" x1="1" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#e4b3ac"></stop>
      <stop offset="1" stop-color="#a5625e"></stop>
    </linearGradient>
  </defs>

  <!-- Where the vase meets the plank -->
  <ellipse cx="23" cy="131.6" rx="13" ry="1.4" fill="#5d4a3c" fill-opacity="0.28"></ellipse>

  <!-- Stems: the bloom's, and a second carrying the bud, both seen again through the glass -->
  <path
    d="M23.4 96 C23.6 74 21 52 19.6 30 M23.8 96 C25.4 80 30 66 35.6 51.6"
    stroke="#7f9177"
    stroke-width="1.15"
    stroke-linecap="round"></path>
  <path
    d="M23.7 96 C23.9 76 21.5 52 20.2 30"
    stroke="#b7c4a9"
    stroke-width="0.4"
    stroke-linecap="round"></path>

  <!-- Feathery cosmos leaf: a forked rib with thread-fine leaflets -->
  <g stroke-linecap="round" stroke-linejoin="round">
    <path
      d="M22.4 74 C18.6 70.6 14.6 69.4 10.4 69.8 M18.8 71.2 C17.4 67.6 15.2 65.4 12.6 64.4 M16 70 C13.8 72 11.6 73 9 73.2 M14.4 69.6 C13.6 66.6 12.2 64.6 10.6 63.6 M20.6 72.6 C19.8 75.6 18.4 77.6 16.6 79"
      stroke="#8a9c80"
      stroke-width="0.85"></path>
    <path
      d="M24.4 86 C28 83.4 31.4 82.8 35.4 83.6 M28.4 83.8 C30 80.6 32.2 79 34.8 78.4 M31.6 83.2 C33.4 85.2 35.6 86.4 38 86.6 M26.4 85 C27.2 87.8 28.8 89.6 30.8 90.6"
      stroke="#97a98c"
      stroke-width="0.8"></path>
  </g>

  <!-- The bud, closed, its sepals still curled round it -->
  <g transform="translate(35.6 51.6) rotate(32)">
    <path
      d="M0 0 C-3.4 -1.4 -4.2 -6.6 -2.2 -10.2 C-1.2 -12 1.2 -12 2.2 -10.2 C4.2 -6.6 3.4 -1.4 0 0 Z"
      fill="url(#budvase-bud)"></path>
    <path
      d="M0.4 -1.4 C1.6 -4 1.8 -7.4 0.8 -10.4"
      stroke="#f3d4cd"
      stroke-width="0.5"
      stroke-linecap="round"
      opacity="0.8"></path>
    <path
      d="M0 0.4 C-2.6 -0.6 -3.8 -2.8 -3.6 -5.4 C-2.2 -3.8 -1 -2.6 0 -2.2 C1 -2.6 2.2 -3.8 3.6 -5.4 C3.8 -2.8 2.6 -0.6 0 0.4 Z"
      fill="#8a9c80"></path>
  </g>

  <!-- The bloom, tipped back toward the light -->
  <g transform="translate(19.6 24) rotate(-16) scale(1 0.66)">
    <g>
      {
        back.map((p) => (
          <>
            <path d={petal(p.ang, p.len, p.wide)} fill="url(#budvase-petal)" />
            <path
              d={petal(p.ang, p.len, p.wide)}
              fill="#5a3432"
              fill-opacity={lit(p.ang) ? 0.08 : 0.22}
            />
          </>
        ))
      }
    </g>
    <path
      d="M-4.2 0 A4.2 4.2 0 0 1 4.2 0 A4.2 4.2 0 0 1 -4.2 0 Z"
      fill="#6d3f3c"
      fill-opacity="0.35"></path>
    <g>
      {
        front.map((p) => (
          <>
            <path
              d={petal(p.ang, p.len, p.wide)}
              fill="url(#budvase-petal)"
              stroke="#a7625e"
              stroke-opacity="0.35"
              stroke-width="0.35"
            />
            {lit(p.ang) && (
              <path d={petal(p.ang, p.len, p.wide)} fill="#fff6f0" fill-opacity="0.28" />
            )}
            <path
              d={veins(p.ang, p.len)}
              stroke="#9a5552"
              stroke-opacity="0.32"
              stroke-width="0.32"
            />
          </>
        ))
      }
    </g>
    {
      back.map((p) => (
        <path d={veins(p.ang, p.len)} stroke="#7d4643" stroke-opacity="0.28" stroke-width="0.3" />
      ))
    }
    <!-- the eye: a domed disc ringed with stamens -->
    <circle r="3.3" fill="url(#budvase-eye)"></circle>
    <path d={stamens} stroke="#7b5a26" stroke-width="0.9" stroke-linecap="round"></path>
    <ellipse cx="0.9" cy="-1" rx="1.2" ry="0.8" fill="#fbecc0" fill-opacity="0.75"></ellipse>
  </g>

  <!-- The vase: a narrow neck flaring to a lip, a round belly, a flat foot -->
  <path
    d="M19.4 94.4 C19.4 93.2 20.2 92.6 21.2 92.6 H26.8 C27.8 92.6 28.6 93.2 28.6 94.4 C28.6 95.4 27.6 96 26.6 96.2 C26.8 100.8 27.6 104 30.4 107 C34.8 111 36.6 115 36.6 120 C36.6 125.6 34 129.4 30.6 131.4 H15.4 C12 129.4 9.4 125.6 9.4 120 C9.4 115 11.2 111 15.6 107 C18.4 104 19.2 100.8 19.4 96.2 C18.4 96 19.4 95.4 19.4 94.4 Z"
    fill="url(#budvase-glass)"
    stroke="#8ea4a1"
    stroke-width="0.75"
    stroke-linejoin="round"></path>
  <!-- water, with its meniscus, and the stems bent where they enter it -->
  <path
    d="M12.8 111.2 C16 112.4 30 112.4 33.2 111.2 C35.4 113.6 36.4 116.6 36.4 120 C36.4 125.6 33.8 129.2 30.6 131.2 H15.4 C12.2 129.2 9.6 125.6 9.6 120 C9.6 116.6 10.6 113.6 12.8 111.2 Z"
    fill="url(#budvase-water)"></path>
  <path
    d="M12.8 111.2 C16 112.4 30 112.4 33.2 111.2"
    stroke="#ffffff"
    stroke-opacity="0.8"
    stroke-width="0.6"></path>
  <path
    d="M23.4 96 C23.2 102 23 106 22.8 111.6 M23.8 96 C24 102 24.2 106 24.4 111.6"
    stroke="#8a9c80"
    stroke-width="0.9"
    stroke-linecap="round"
    opacity="0.85"></path>
  <path
    d="M22 112.2 C21 118 20.4 124 21.2 129.4 M25.4 112.2 C26.6 118 27.4 124 26.6 129.4"
    stroke="#7f9177"
    stroke-width="0.9"
    stroke-linecap="round"
    opacity="0.7"></path>
  <!-- shade on the side away from the window -->
  <path
    d="M11.4 116 C11.6 112.6 13.6 110.2 16 108.2 C13.8 112 13.2 116 13.4 120.6 C13.6 124.4 14.6 127 16.4 129.4 C12.6 128 11.2 124 11.4 116 Z"
    fill="#7f9794"
    opacity="0.26"></path>
  <!-- highlights: a long gleam down the belly, a glint on the shoulder and lip -->
  <path
    d="M32.8 113.8 C34.4 117 34.6 121.8 33.4 125.6"
    stroke="#ffffff"
    stroke-opacity="0.95"
    stroke-width="1.4"
    stroke-linecap="round"></path>
  <path
    d="M27.4 99.6 C27.8 102.6 28.8 104.6 30.6 106.4 M23 93.4 H27.6"
    stroke="#ffffff"
    stroke-opacity="0.75"
    stroke-width="0.65"
    stroke-linecap="round"></path>
  <path
    d="M10.8 128.2 C14 130 32 130 35.2 128.2"
    stroke="#ffffff"
    stroke-opacity="0.7"
    stroke-width="0.7"
    stroke-linecap="round"></path>
</svg>
