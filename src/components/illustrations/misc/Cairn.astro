const stones = stacks[variant] ?? stacks[1];
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 60 72"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Cairn: stacked trail-marker stones on a line of ground. Stones carry
       .cairn-stone so a page can give them a fill; by default they are line only. -->
  <path
    d="M3 67.5 Q30 71 57 67.5"
    stroke="currentColor"
    stroke-width="1.1"
    stroke-linecap="round"
    opacity="0.6"></path>
  {
    stones.map((d) => (
      <path
        class="cairn-stone"
        d={d}
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linejoin="round"
        fill="none"
      />
    ))
  }
  <!-- A few chisel ticks for texture -->
  <path
    d="M20 60 q3 -1 6 0 M36 58.5 q3 -1 5 0.5 M25 48.5 q2.5 -0.8 5 0"
    stroke="currentColor"
    stroke-width="0.9"
    stroke-linecap="round"
    opacity="0.55"></path>
</svg>
