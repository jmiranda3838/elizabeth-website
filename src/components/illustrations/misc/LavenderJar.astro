---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

/* A small glass bottle of dried lavender, tied at the neck with twine. It stands on the
   stack of books at the right end of the Resources shelf (and on the plank itself on
   phones). The drawing is 64 x 136 and the bottle's foot is at y = 136.

   The stems and their florets are grown from a fixed seed: irregular, but the same on
   every build. Light comes from the upper right, so the glass shines down its right side. */

let seed = 77;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const jit = (a: number, b: number) => a + (b - a) * rnd();
const f = (n: number) => Math.round(n * 10) / 10;
const rad = (deg: number) => (deg * Math.PI) / 180;

/** One floret: a small oval leaning out from the stem */
function dab(x: number, y: number, ang: number, rx: number, ry: number): string {
  const dx = Math.cos(rad(ang)) * rx;
  const dy = Math.sin(rad(ang)) * rx;
  const arc = `a${f(rx)} ${f(ry)} ${Math.round(ang)} 1 1 `;
  return `M${f(x - dx)} ${f(y - dy)}${arc}${f(2 * dx)} ${f(2 * dy)}${arc}${f(-2 * dx)} ${f(-2 * dy)}Z`;
}

// Seven stems fanning from the neck: [tip x, tip y, how far the stem bows sideways]
const tips: number[][] = [
  [8, 34, -5],
  [17, 17, -4],
  [25, 25, -2],
  [33, 7, 1],
  [41, 21, 2],
  [49, 13, 5],
  [57, 31, 5],
];
const TONES = ["#8d86a1", "#a59cb6", "#bdb5c9"];
let stems = "";
let inGlass = "";
let leaves = "";
const florets = ["", "", ""];
tips.forEach(([tx, ty, bow], i) => {
  const bx = 29.6 + i * 0.8;
  const by = 78.4;
  const cx = (bx + tx) / 2 + bow;
  const cy = (by + ty) / 2 + 10;
  stems += `M${f(bx)} ${by}Q${f(cx)} ${f(cy)} ${tx} ${ty}`;
  // inside the bottle the stems cross and splay toward the foot
  const fx = 42.5 - i * 3.5 + jit(-1, 1);
  inGlass += `M${f(bx)} ${by}C${f(bx)} 92 ${f(fx)} 104 ${f(fx + jit(-1.5, 1.5))} ${f(jit(126, 131))}`;
  const at = (u: number) => {
    const m = 1 - u;
    const x = m * m * bx + 2 * m * u * cx + u * u * tx;
    const y = m * m * by + 2 * m * u * cy + u * u * ty;
    const ang =
      (Math.atan2(2 * m * (cy - by) + 2 * u * (ty - cy), 2 * m * (cx - bx) + 2 * u * (tx - cx)) *
        180) /
      Math.PI;
    return { x, y, ang };
  };
  // the spike: whorls of florets up the last third, tighter and smaller toward the tip
  const whorls = 7 + Math.round(jit(0, 2));
  for (let w = 0; w < whorls; w++) {
    const u = 0.62 + (0.4 * w) / whorls + (w === 0 ? -0.04 : 0);
    const p = at(Math.min(u, 1));
    const size = 1 - (0.42 * w) / whorls;
    const nx = Math.cos(rad(p.ang + 90));
    const ny = Math.sin(rad(p.ang + 90));
    florets[0] += dab(
      p.x - nx * 1.7 * size,
      p.y - ny * 1.7 * size,
      p.ang - 38,
      2.3 * size,
      1.3 * size,
    );
    florets[1] += dab(
      p.x + nx * 1.7 * size,
      p.y + ny * 1.7 * size,
      p.ang + 38,
      2.3 * size,
      1.3 * size,
    );
    if (w % 2 === 0 || rnd() < 0.4) {
      florets[2] += dab(
        p.x + jit(-0.4, 0.4),
        p.y + jit(-0.4, 0.4),
        p.ang + jit(-12, 12),
        1.9 * size,
        1.1 * size,
      );
    }
  }
  // one or two narrow grey leaves low on the stem
  if (i % 2 === 0 || i === 3) {
    const p = at(jit(0.16, 0.3));
    const side = i < 3 ? -1 : 1;
    const a = p.ang + side * jit(24, 40);
    const len = jit(8, 11);
    const ex = p.x + Math.cos(rad(a)) * len;
    const ey = p.y + Math.sin(rad(a)) * len;
    const px = Math.cos(rad(a + 90)) * 0.9;
    const py = Math.sin(rad(a + 90)) * 0.9;
    const mx = (p.x + ex) / 2;
    const my = (p.y + ey) / 2;
    leaves += `M${f(p.x)} ${f(p.y)}Q${f(mx + px)} ${f(my + py)} ${f(ex)} ${f(ey)}Q${f(mx - px)} ${f(my - py)} ${f(p.x)} ${f(p.y)}Z`;
  }
});
---

<svg
  class={className}
  style={style}
  aria-hidden="true"
  {...rest}
  viewBox="0 0 64 136"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="lavjar-glass" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#b9cbc8" stop-opacity="0.75"></stop>
      <stop offset="0.3" stop-color="#dbe6e3" stop-opacity="0.55"></stop>
      <stop offset="0.75" stop-color="#f1f6f4" stop-opacity="0.6"></stop>
      <stop offset="1" stop-color="#cbdad7" stop-opacity="0.75"></stop>
    </linearGradient>
  </defs>

  <!-- Where the bottle meets what it stands on -->
  <ellipse cx="32" cy="135.6" rx="15.5" ry="1.5" fill="#5d4a3c" fill-opacity="0.26"></ellipse>

  <!-- Stems above the lip, then the same stems seen through the glass -->
  <path d={stems} stroke="#94a08a" stroke-width="0.75" stroke-linecap="round"></path>
  <path d={inGlass} stroke="#9aa58f" stroke-width="0.8" stroke-linecap="round"></path>

  <!-- The bottle: a short neck, soft shoulders, a heavy foot -->
  <path
    d="M26 81.4 V88 C26 91.6 17.4 93.4 17.4 101 V130 C17.4 133.2 19.4 135.4 22.6 135.4 H41.4 C44.6 135.4 46.6 133.2 46.6 130 V101 C46.6 93.4 38 91.6 38 88 V81.4 Z"
    fill="url(#lavjar-glass)"
    stroke="#8ea4a1"
    stroke-width="0.8"
    stroke-linejoin="round"></path>
  <path
    d="M19.2 100.6 C19.6 96.6 24 94.6 26.6 92.2 C23.4 96.6 22.4 102 22.4 110 V128 C22.4 130.6 21.2 131.6 19.2 130.4 Z"
    fill="#8ea4a1"
    opacity="0.22"></path>
  <path
    d="M19.4 129.6 C24 132.6 40 132.6 44.6 129.6"
    stroke="#ffffff"
    stroke-opacity="0.85"
    stroke-width="0.8"
    stroke-linecap="round"></path>
  <path d="M20 133.6 H44" stroke="#8ea4a1" stroke-opacity="0.5" stroke-width="0.6"></path>
  <path
    d="M43.2 101.4 C43.6 109 43.6 118 43.2 126"
    stroke="#ffffff"
    stroke-opacity="0.95"
    stroke-width="1.5"
    stroke-linecap="round"></path>
  <path
    d="M40 103 C40.2 106 40.2 109 40 112 M21 104 C20.8 110 20.8 116 21 122 M36.4 89.6 C39 92 41.6 93.6 43.4 96"
    stroke="#ffffff"
    stroke-opacity="0.7"
    stroke-width="0.7"
    stroke-linecap="round"></path>
  <!-- lip -->
  <path
    d="M25 77.8 H39 C40.2 77.8 40.8 78.6 40.8 79.6 C40.8 80.6 40.2 81.4 39 81.4 H25 C23.8 81.4 23.2 80.6 23.2 79.6 C23.2 78.6 23.8 77.8 25 77.8 Z"
    fill="#e6eeec"
    stroke="#8ea4a1"
    stroke-width="0.7"></path>
  <path d="M33 78.6 H38.6" stroke="#ffffff" stroke-width="0.7" stroke-linecap="round"></path>

  <!-- Twine wound round the neck, tied in a bow -->
  <path
    d="M25.6 83.6 C29.6 84.8 34.4 84.8 38.4 83.4 M25.6 85.4 C29.6 86.8 34.4 86.6 38.4 85.2 M25.8 87.2 C29.6 88.4 34.4 88.4 38.2 87"
    stroke="#bfa588"
    stroke-width="1.05"
    stroke-linecap="round"></path>
  <path
    d="M25.6 84.5 C29.6 85.8 34.4 85.7 38.4 84.3 M25.7 86.3 C29.6 87.6 34.4 87.5 38.3 86.1"
    stroke="#8f765c"
    stroke-opacity="0.55"
    stroke-width="0.4"></path>
  <path
    d="M34.4 86 C36.6 82.6 41.4 82.4 41.6 85.2 C41.8 87.6 37.6 88 34.4 86 C31.4 88.8 27.6 90.4 26.8 88 C26 85.8 30.6 84.6 34.4 86 Z M34.4 86 C36 89.6 38.6 92.4 41.2 94.6 M34.4 86 C34 90 32.4 93.6 30.4 96.4"
    stroke="#b2977a"
    stroke-width="0.8"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="34.4" cy="86" r="1.1" fill="#b2977a"></circle>

  <!-- Dried lavender -->
  <path d={leaves} fill="#a9b3a2" stroke="#8e9a87" stroke-width="0.3"></path>
  {florets.map((d, t) => <path d={d} fill={TONES[t]} />)}
</svg>
