---
interface Props {
  class?: string;
  style?: string;
  /** Which piece of wood: 1 = straight grain with a small knot, 2 = wavier grain, paler end */
  variant?: 1 | 2;
  [key: string]: unknown;
}
const { class: className = "", style = "", variant = 1, ...rest } = Astro.props;

// The front slat, drawn by hand so its edges are not ruler-straight. The handle end
// (top) is rounded over by use; the jaw end (bottom) is cut squarer.
const slat =
  "M11.6 3.2 C14.4 2.5 21.4 2.4 24.6 3.1 C26.9 3.6 27.9 5.2 28 7.4 C28.3 20 28.5 34 28.3 48 C28.2 60 28.4 72 28 82.4 C27.9 84 26.9 84.9 25.3 85 C21 85.4 15 85.4 10.9 85 C9.3 84.9 8.3 84 8.2 82.4 C7.8 70 8 58 7.9 46 C7.8 33 7.7 20 8.1 7.4 C8.2 5.2 9.3 3.7 11.6 3.2 Z";

const grain: Record<number, string[]> = {
  1: [
    "M11.4 7 C11 20 11.6 30 11.2 37",
    "M14.6 5.4 C15.2 16 14.2 27 14.8 37",
    "M18.6 5 C18.4 9 18.6 12 18.5 15 M18.5 25 C18.2 30 18.8 34 18.4 37",
    "M22 5.6 C22.6 15 21.8 27 22.4 37",
    "M25.2 7.4 C25 18 25.6 28 25.2 37",
    "M11.2 46 C11.6 58 11 70 11.4 82",
    "M14.6 46 C14.2 54 15.2 60 14.8 66 C14.4 72 15 78 14.6 83.4",
    "M18.2 46 C18.8 58 18 72 18.4 83.6",
    "M21.8 46 C22.4 56 21.4 64 22.2 72 C22.6 77 22 81 22.2 83.4",
    "M25.2 46 C24.8 58 25.6 70 25.2 82",
  ],
  2: [
    "M11.2 7.4 C12 18 10.8 28 11.6 37",
    "M14.2 5.6 C13.6 12 15.4 19 14.6 26 C14.2 30 15 34 14.6 37",
    "M17.8 5 C18.6 14 17.4 26 18.2 37",
    "M21.6 5.4 C21 13 22.6 21 21.8 29 C21.6 32 22 35 21.8 37",
    "M24.8 7 C25.4 17 24.4 28 25 37",
    "M11.4 46 C10.8 56 12 66 11.2 76 C11 78.6 11.4 80.6 11.4 82.2",
    "M14.8 46 C15.4 58 14.4 72 14.8 83.4",
    "M18.4 46 C17.8 54 19.2 62 18.4 70 C18 75 18.6 80 18.4 83.6",
    "M22 46 C22.6 58 21.6 70 22 83.4",
    "M25 46 C25.6 56 24.6 68 25.2 82",
  ],
};
const lines = grain[variant] ?? grain[1];
---

<svg
  class={className}
  style={style}
  aria-hidden="true"
  {...rest}
  viewBox="0 0 36 90"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- A wooden spring clothespin seen face-on, the way it sits when it pegs a print to
       a line: the front slat with its grain, the back slat showing as a sliver of
       thickness, the wire spring crossing in its groove with the coil peeping out at
       each side, and a soft cast shadow. The line runs behind it in the round notch at
       y 61; whatever it grips tucks under the lowest ~20 units (the jaws).
       The wood is currentColor; shading, grain and wire are fixed tones over it. -->

  <!-- cast shadow, falling down and to the right -->
  <path d={slat} transform="translate(3.4 3.8)" fill="#60665a" fill-opacity="0.13"></path>
  <path d={slat} transform="translate(2.4 2.6)" fill="#60665a" fill-opacity="0.15"></path>
  <path d={slat} transform="translate(1.4 1.6)" fill="#60665a" fill-opacity="0.16"></path>

  <!-- back slat: only its right edge and foot show -->
  <path d={slat} transform="translate(1.5 0.7)" fill="currentColor"></path>
  <path d={slat} transform="translate(1.5 0.7)" fill="#6f5136" fill-opacity="0.42"></path>

  <!-- front slat -->
  <path d={slat} fill="currentColor"></path>
  <!-- light from the upper left, shade down the right edge and toward the jaws -->
  <path
    d="M11.6 3.2 C9.3 3.7 8.2 5.2 8.1 7.4 C7.7 20 7.8 33 7.9 46 C8 58 7.8 70 8.2 82.4 L10.6 82.4 C10.2 70 10.4 58 10.3 46 C10.2 33 10.2 20 10.5 8.4 C10.6 6.4 11.4 5 13.4 4.4 C16 3.8 20 3.8 23 4.2 L24.6 3.1 C21.4 2.4 14.4 2.5 11.6 3.2 Z"
    fill="#fff"
    fill-opacity="0.42"></path>
  <path
    d="M25.6 4 C27.4 4.8 27.9 6 28 7.4 C28.3 20 28.5 34 28.3 48 C28.2 60 28.4 72 28 82.4 C27.9 84 26.9 84.9 25.3 85 L24.4 85 C25.4 84.4 25.7 83.4 25.8 82 C26.1 70 26 60 26.1 48 C26.3 34 26.1 20 25.9 8 C25.9 6.4 25.8 5 25.6 4 Z"
    fill="#7a5a3c"
    fill-opacity="0.26"></path>
  <path
    d="M8.1 70 C14 71.4 22 71.4 28.2 70 C28.2 74.4 28.1 78.6 28 82.4 C27.9 84 26.9 84.9 25.3 85 C21 85.4 15 85.4 10.9 85 C9.3 84.9 8.3 84 8.2 82.4 C8.1 78.4 8.1 74.2 8.1 70 Z"
    fill="#7a5a3c"
    fill-opacity="0.13"></path>

  <!-- the handle end is planed thinner: a pale chamfer and its lower edge -->
  <path
    d="M8.1 9 C8.1 5.6 9.4 3.8 11.6 3.2 C14.4 2.5 21.4 2.4 24.6 3.1 C26.9 3.6 27.9 5.2 28 9 C22 10 14 10 8.1 9 Z"
    fill="#fff"
    fill-opacity="0.22"></path>
  <path
    d="M8.1 9 C14 10 22 10 28 9"
    stroke="#8a6646"
    stroke-width="0.4"
    stroke-opacity="0.4"
    stroke-linecap="round"></path>

  <!-- grain, broken where the spring groove crosses -->
  <g stroke="#8a6646" stroke-width="0.45" stroke-linecap="round" stroke-opacity="0.5">
    {lines.map((d) => <path d={d} />)}
  </g>
  {
    variant === 1 ? (
      <g stroke="#7a5a3c" stroke-linecap="round" fill="none">
        <path
          d="M18.4 17 C19.4 17.8 19.8 19.6 19.4 21.4 C19 22.8 18 23 17.6 21.8 C17.2 20.2 17.4 18 18.4 17 Z"
          stroke-width="0.4"
          stroke-opacity="0.5"
          fill="#7a5a3c"
          fill-opacity="0.28"
        />
        <path
          d="M16.6 15 C15.8 18 15.8 22 16.8 25 M20.4 14.6 C21.4 17.6 21.4 22.4 20.2 25.4"
          stroke-width="0.4"
          stroke-opacity="0.4"
        />
      </g>
    ) : (
      <path
        d="M9.6 60.8 C12 58.6 14.6 58.4 16 60.4 M12 13 C12.8 11.4 14.2 11 15.2 12"
        stroke="#7a5a3c"
        stroke-width="0.4"
        stroke-opacity="0.45"
        stroke-linecap="round"
      />
    )
  }

  <!-- the round notch that holds the line: a pinch of shadow at each edge -->
  <path
    d="M7.9 58.6 C9.8 59.2 10.6 60.4 10.6 61.6 C10.6 62.8 9.8 64 7.9 64.6 Z M28.3 58.6 C26.4 59.2 25.6 60.4 25.6 61.6 C25.6 62.8 26.4 64 28.3 64.6 Z M8 73.2 C9 73.6 9.4 74.2 9.4 74.8 C9.4 75.4 9 76 8 76.4 Z M28.2 73.2 C27.2 73.6 26.8 74.2 26.8 74.8 C26.8 75.4 27.2 76 28.2 76.4 Z"
    fill="#5d4530"
    fill-opacity="0.34"></path>

  <!-- slat outline, heavier on the shadow side -->
  <path d={slat} stroke="#8a6646" stroke-width="0.7" stroke-opacity="0.7" stroke-linejoin="round"
  ></path>
  <path
    d="M27.6 5.4 C28.3 20 28.5 34 28.3 48 C28.2 60 28.4 72 28 82.4 C27.9 84 26.9 84.9 25.3 85 C21 85.4 15 85.4 10.9 85"
    stroke="#6f5136"
    stroke-width="0.9"
    stroke-opacity="0.55"
    stroke-linecap="round"></path>

  <!-- spring: the groove, the coil ends at either side, then the two wire arms -->
  <path
    d="M8 37.4 C14 38.2 22 38.2 28.3 37.4 L28.3 46 C22 46.8 14 46.8 7.9 46 Z"
    fill="#5d4530"
    fill-opacity="0.2"></path>
  <g stroke-linecap="round">
    <path
      d="M6.4 38.4 C4.6 38.6 3.8 40 3.8 41.8 C3.8 43.6 4.6 45 6.4 45.2 L8.4 45.2 L8.4 38.4 Z M29.8 38.4 C31.6 38.6 32.4 40 32.4 41.8 C32.4 43.6 31.6 45 29.8 45.2 L27.8 45.2 L27.8 38.4 Z"
      fill="#9a9c95"
      stroke="#6e706a"
      stroke-width="0.6"></path>
    <path
      d="M5.6 39.6 L5.6 44 M7.2 39.2 L7.2 44.4 M29 39.2 L29 44.4 M30.6 39.6 L30.6 44"
      stroke="#5f6764"
      stroke-width="0.5"
      stroke-opacity="0.8"></path>
    <path
      d="M4.9 39.9 L4.9 41.6 M30 39.5 L30 41.2"
      stroke="#fff"
      stroke-width="0.5"
      stroke-opacity="0.7"></path>
    <path
      d="M7 40.2 C13 40.9 23 40.9 29.2 40.2 M7 43.5 C13 44.2 23 44.2 29.2 43.5"
      stroke="#6e706a"
      stroke-width="1.9"></path>
    <path
      d="M7 40.2 C13 40.9 23 40.9 29.2 40.2 M7 43.5 C13 44.2 23 44.2 29.2 43.5"
      stroke="#b3b5ae"
      stroke-width="1.1"></path>
    <path
      d="M9 39.9 C14 40.4 20 40.4 24 40.1 M9 43.2 C14 43.7 20 43.7 24 43.4"
      stroke="#fff"
      stroke-width="0.45"
      stroke-opacity="0.75"></path>
  </g>
</svg>
