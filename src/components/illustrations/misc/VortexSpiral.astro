---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 60 60"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Hand-drawn vortex spiral, opening outward from the centre -->
  <path
    d="M30.5 30.5 C30 28.6 32.6 27.6 33.8 29.4 C35.6 32 33 35.8 29.4 35.6 C24.8 35.3 22.6 30.2 24.6 26.2 C27 21.4 34 20.6 37.8 24.4 C42.4 29 40.8 37.6 35 40.8 C27.8 44.8 18.6 41 16.6 33 C14.4 24.2 20.6 15.6 29.6 14.6 C39.6 13.5 47.8 21.4 47.6 31.4 C47.4 42.4 38 50.6 27.2 49.6 C17.6 48.8 9.6 41.6 8.6 31.8"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <path
    d="M8.6 31.8 C8.2 27.6 9 23.6 10.6 20"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-dasharray="2 3"></path>
</svg>
