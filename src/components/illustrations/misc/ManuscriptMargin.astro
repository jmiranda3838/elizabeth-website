---
import { stem, sprig, tipped, leaf, bud, rose, daisy, gilt } from "../frames/illumination";

interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

// A border vine for the outer margin: one stem swaying down the page, a curl in the
// hollow of every bend, a rose and a daisy where it crosses its own line.
const art = [
  stem(
    "M20 4 C13 14 12 27 20 38 C28 49 29 61 21 72 C13 83 12 96 20 108 C28 120 29 132 21 144 C14 154 13 167 19 179 C21 185 21 191 20 197",
    0.8,
  ),
  tipped(sprig([13.7, 22], [17, 20], [22, 21], [23.6, 24.6], { r: 2.6 }), "ivy"),
  tipped(sprig([27.8, 52], [24, 50], [19, 51], [17.4, 54.6], { r: 2.6, dir: -1 })),
  tipped(sprig([13.5, 88], [17, 86], [22, 87], [23.6, 90.6], { r: 2.6 }), "bud"),
  tipped(sprig([27.8, 124], [24, 122], [19, 123], [17.4, 126.6], { r: 2.6, dir: -1 }), "ivy"),
  tipped(sprig([14.2, 160], [17.4, 158], [22, 159], [23.6, 162.6], { r: 2.4 })),
  // Leaves on the outside of each bend
  leaf([14.4, 13, 166, 0.6]),
  leaf([13, 27, 204, 0.72]),
  leaf([27.2, 46, 14, 0.62]),
  leaf([28.2, 58, -24, 0.72]),
  leaf([14, 82, 150, 0.6]),
  leaf([12.9, 96, 196, 0.7]),
  leaf([27.4, 118, 26, 0.6]),
  leaf([28.2, 130, -14, 0.7]),
  leaf([14.6, 154, 158, 0.58]),
  leaf([13.8, 167, 198, 0.66]),
  // Finials
  bud([20, 5, -96, 0.84]),
  leaf([19.6, 191, 62, 0.62]),
  leaf([19.8, 192, 118, 0.6]),
  // Flowers at the crossings
  leaf([22, 70, -30, 0.7]),
  leaf([19, 74, 150, 0.66]),
  rose([20.8, 72, -10, 0.8]),
  leaf([22.6, 142, -40, 0.62]),
  leaf([19, 146, 140, 0.6]),
  daisy([21, 144, 0, 0.72]),
  gilt([20, 38, 0, 1.5]),
  gilt([20, 108, 180, 1.5]),
  gilt([31, 31, -40, 1.15]),
  gilt([8.6, 62, 160, 1.25]),
  gilt([32.4, 84, 20, 1]),
  gilt([8.4, 117, 190, 1.15]),
  gilt([32, 151, 10, 1.2]),
  gilt([10, 184, 200, 1]),
].join("");
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 40 200"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Illuminated margin vine. Shapes come from ../frames/illumination. -->
  <g set:html={art} />
</svg>
