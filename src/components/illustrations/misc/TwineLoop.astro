---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 48 64"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- A loop of garden twine for a hang tag: both ends come up through the tag's
       punched hole (at 24, 52), cinch in a small knot and flop over to one side.
       Themes through currentColor; the pale dashes are the twist of the ply. -->
  <path
    d="M23.4 52 C21 45 12.4 35 11.4 22.6 C10.4 10.6 20 4.4 27 8.4 C35.4 13.4 33.4 28 29.4 38.4 C27.4 44 25.6 48 24.8 52"
    stroke="#60665a"
    stroke-opacity="0.14"
    stroke-width="3.6"
    stroke-linecap="round"
    transform="translate(1.2 1.4)"></path>
  <path
    d="M23.4 52 C21 45 12.4 35 11.4 22.6 C10.4 10.6 20 4.4 27 8.4 C35.4 13.4 33.4 28 29.4 38.4 C27.4 44 25.6 48 24.8 52"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"></path>
  <path
    d="M23.4 52 C21 45 12.4 35 11.4 22.6 C10.4 10.6 20 4.4 27 8.4 C35.4 13.4 33.4 28 29.4 38.4 C27.4 44 25.6 48 24.8 52"
    stroke="#fff"
    stroke-opacity="0.5"
    stroke-width="1"
    stroke-dasharray="1.5 2.7"></path>
  <!-- the knot, and a frayed end -->
  <path
    d="M19.8 41.4 C22.4 44.4 26.6 44.6 29.2 41.8"
    stroke="currentColor"
    stroke-width="3"
    stroke-linecap="round"></path>
  <path
    d="M20.6 41.8 C22.8 43.8 26 44 28.4 42.2"
    stroke="#fff"
    stroke-opacity="0.45"
    stroke-width="0.9"
    stroke-dasharray="1.4 1.8"></path>
  <path
    d="M29 42.6 C32 45 34.4 45.6 37 44.6 M36 45 l2.4 1.6 M36.6 44.4 l2.6 -0.6"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"></path>
</svg>
