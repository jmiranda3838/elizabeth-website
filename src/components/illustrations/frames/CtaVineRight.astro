---
import { vineMarkup, RIGHT_VINE } from "./ctaVineArt";

interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  aria-hidden="true"
  {...rest}
  viewBox="8 30 172 490"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- A morning glory climbing a garden cane, rooted at the bottom edge. Shapes come
       from ./ctaVineArt; this is the right-hand plant, leaning in from its side. -->
  <g set:html={vineMarkup(RIGHT_VINE)} />
</svg>
