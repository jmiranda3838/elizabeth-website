---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 168 30"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- A small rule with a seedling at its centre: two hand-drawn lines that thin
       toward the ends, and a sprout with one leaf a little ahead of the other.
       Themes through currentColor; depth comes from fill and stroke opacity. -->
  <g stroke="currentColor" stroke-linecap="round">
    <path d="M66 22.6 C52 21.8 38 23.4 24 22.4" stroke-width="1.3" stroke-opacity="0.8"></path>
    <path d="M24 22.4 C17 21.9 11 22.6 5 22.2" stroke-width="0.8" stroke-opacity="0.55"></path>
    <path d="M102 22.4 C116 23.2 130 21.6 144 22.6" stroke-width="1.3" stroke-opacity="0.8"></path>
    <path d="M144 22.6 C151 23.1 157 22.2 163 22.6" stroke-width="0.8" stroke-opacity="0.55"></path>
  </g>
  <!-- the mound it grows from -->
  <path
    d="M70 23 C74 19.6 79 18.6 84.6 18.8 C90 19 94.6 20.4 98 23 C89 24.2 79 24.2 70 23 Z"
    fill="currentColor"
    fill-opacity="0.26"></path>
  <path
    d="M70 23 C74 19.6 79 18.6 84.6 18.8 C90 19 94.6 20.4 98 23"
    stroke="currentColor"
    stroke-width="0.9"
    stroke-linecap="round"
    stroke-opacity="0.7"></path>
  <!-- stem -->
  <path
    d="M84 19.4 C83.6 15.6 84.6 12.4 84 8.6"
    stroke="currentColor"
    stroke-width="1.3"
    stroke-linecap="round"></path>
  <!-- left leaf: the larger, lifted -->
  <path
    d="M84 10.4 C80.6 9.8 76.2 8 73.6 3.6 C78.4 2.4 83.4 5 84 10.4 Z"
    fill="currentColor"
    fill-opacity="0.42"></path>
  <path
    d="M84 10.4 C80.6 9.8 76.2 8 73.6 3.6 C78.4 2.4 83.4 5 84 10.4 Z M83.4 9.6 C80.6 7.6 78 5.8 75.4 4.4"
    stroke="currentColor"
    stroke-width="0.8"
    stroke-linejoin="round"
    stroke-linecap="round"></path>
  <!-- right leaf: smaller, still opening -->
  <path
    d="M84.2 12.6 C86.6 12.6 90.6 11.6 93 8.2 C89.2 6.6 85 8.4 84.2 12.6 Z"
    fill="currentColor"
    fill-opacity="0.24"></path>
  <path
    d="M84.2 12.6 C86.6 12.6 90.6 11.6 93 8.2 C89.2 6.6 85 8.4 84.2 12.6 Z M84.8 11.8 C87 10.6 89.2 9.6 91.4 8.6"
    stroke="currentColor"
    stroke-width="0.8"
    stroke-linejoin="round"
    stroke-linecap="round"></path>
  <!-- seed-dots where the lines give out -->
  <g fill="currentColor" fill-opacity="0.6">
    <circle cx="2.6" cy="22.2" r="1"></circle>
    <circle cx="165.4" cy="22.6" r="1"></circle>
  </g>
</svg>
