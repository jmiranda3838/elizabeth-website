---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 150 20"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- A printer's flower for under a page heading: a small five-petalled bloom
       with a sprig trailing away on each side, the two sides not quite alike.
       Themes through `color`; --botanical-leaf tints the sprigs apart from the bloom. -->
  <g style="color: var(--botanical-leaf, currentColor)">
    <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
      <!-- Left sprig: tapers out to a curled tip -->
      <path d="M69 10.6 C54 8.6 36 11.6 20 10 C14 9.4 9 9.6 5.4 11" stroke-width="0.75"></path>
      <path d="M5.4 11 C3 12 1.6 10.4 2.6 8.8 C3.4 7.6 5 8 5 9.2" stroke-width="0.6"></path>
      <!-- Right sprig: a little shorter, tip turned the other way -->
      <path d="M81 9.8 C96 11.8 112 8.6 128 10 C134 10.6 139 10.4 143 9.2" stroke-width="0.75"
      ></path>
      <path
        d="M143 9.2 C145.6 8.4 147.4 10 146.6 11.6 C146 12.8 144.4 12.6 144.2 11.4"
        stroke-width="0.6"></path>
      <!-- Stalks of the berries -->
      <path
        d="M13.4 7.6 L12.4 9.8 M17 12.8 L17.6 10.2 M135 13 L134.2 10.6 M138.6 7 L139.2 9.8"
        stroke-width="0.5"></path>
    </g>
    <!-- Leaves along the sprigs -->
    <g
      fill="currentColor"
      fill-opacity="0.36"
      stroke="currentColor"
      stroke-width="0.55"
      stroke-linejoin="round"
    >
      <path d="M62 10 C59.6 6.4 55 5 50.6 6.4 C53 9.6 57.6 11 62 10 Z"></path>
      <path d="M56 10 C54 13.2 50 14.6 46 13.6 C48.2 10.6 52 9.4 56 10 Z"></path>
      <path d="M40 10.4 C38.4 7.6 35 6.4 31.6 7.4 C33.4 10 36.6 11 40 10.4 Z"></path>
      <path d="M27 10.4 C25.6 12.6 22.8 13.6 20 13 C21.6 10.8 24.2 10 27 10.4 Z"></path>
      <path d="M88 10.4 C90.6 13.8 95 15 99.4 13.8 C97 10.6 92.6 9.4 88 10.4 Z"></path>
      <path d="M95 10.6 C96.8 7.4 100.6 6 104.6 6.8 C102.6 9.8 99 11.2 95 10.6 Z"></path>
      <path d="M111 9.6 C112.8 12 115.8 13 119 12.2 C117.2 9.8 114.2 9 111 9.6 Z"></path>
      <path d="M123 9.6 C124.2 7.6 126.6 6.8 129 7.4 C127.6 9.4 125.4 10 123 9.6 Z"></path>
    </g>
    <!-- Midribs -->
    <path
      d="M61 9.6 C57.6 8.4 54.4 7.2 51.6 6.6 M55 10.4 C52.2 11.6 49.4 12.8 47 13.4 M39.2 10 C36.8 9 34.4 8 32.4 7.6 M26.2 10.8 C24.4 11.6 22.4 12.4 20.8 12.8 M89 10.8 C92.2 12 95.6 13.2 98.4 13.6 M96 10.2 C98.6 9 101.4 7.8 103.8 7 M112 10 C114.2 10.8 116.4 11.6 118.2 12 M123.8 9.2 C125.4 8.6 127 8 128.4 7.6"
      stroke="currentColor"
      stroke-width="0.32"
      stroke-linecap="round"
      stroke-opacity="0.8"></path>
  </g>
  <!-- Berries -->
  <g fill="currentColor" stroke="currentColor" stroke-width="0.4">
    <circle cx="13.6" cy="7" r="1.2" fill-opacity="0.55"></circle>
    <circle cx="17" cy="13.4" r="0.9" fill-opacity="0.4"></circle>
    <circle cx="135.2" cy="13.6" r="1.2" fill-opacity="0.55"></circle>
    <circle cx="138.6" cy="6.4" r="0.9" fill-opacity="0.4"></circle>
  </g>
  <!-- Centre bloom -->
  <g transform="translate(75 10) rotate(-8)">
    <g
      fill="currentColor"
      fill-opacity="0.3"
      stroke="currentColor"
      stroke-width="0.55"
      stroke-linejoin="round"
    >
      <path d="M0 0 C-2.6 -1.4 -3.6 -4.8 -2 -6.8 C-0.8 -8.2 1.2 -8 2 -6.6 C3.2 -4.4 2.2 -1.4 0 0 Z"
      ></path>
      <path
        d="M0 0 C-2.6 -1.4 -3.6 -4.8 -2 -6.8 C-0.8 -8.2 1.2 -8 2 -6.6 C3.2 -4.4 2.2 -1.4 0 0 Z"
        transform="rotate(74)"></path>
      <path
        d="M0 0 C-2.6 -1.4 -3.6 -4.8 -2 -6.8 C-0.8 -8.2 1.2 -8 2 -6.6 C3.2 -4.4 2.2 -1.4 0 0 Z"
        transform="rotate(146) scale(0.94)"></path>
      <path
        d="M0 0 C-2.6 -1.4 -3.6 -4.8 -2 -6.8 C-0.8 -8.2 1.2 -8 2 -6.6 C3.2 -4.4 2.2 -1.4 0 0 Z"
        transform="rotate(215)"></path>
      <path
        d="M0 0 C-2.6 -1.4 -3.6 -4.8 -2 -6.8 C-0.8 -8.2 1.2 -8 2 -6.6 C3.2 -4.4 2.2 -1.4 0 0 Z"
        transform="rotate(288) scale(1.04)"></path>
    </g>
    <path
      d="M0 -1.6 V-4.6 M1.5 -0.5 L4.4 -1.4 M0.9 1.3 L2.7 3.7 M-0.9 1.3 L-2.7 3.7 M-1.5 -0.5 L-4.4 -1.4"
      stroke="currentColor"
      stroke-width="0.3"
      stroke-linecap="round"
      stroke-opacity="0.7"></path>
    <circle r="1.3" style="fill: var(--botanical-gilt, currentColor)"></circle>
  </g>
</svg>
