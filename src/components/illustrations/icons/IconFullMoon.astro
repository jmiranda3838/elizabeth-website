---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Full moon, engraved: a disc with soft maria, a rayed crater and shade
       hatched along its night limb, over two wisps of cloud. Themes through
       currentColor. -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="16" cy="14.4" r="10.2" fill="currentColor" fill-opacity="0.12" stroke-width="1.25"
    ></circle>
    <path
      d="M24.9 9.4 A10.2 10.2 0 0 1 9.4 22.2 C15.6 23.4 23.4 18.4 24.9 9.4 Z"
      fill="currentColor"
      fill-opacity="0.16"
      stroke="none"></path>
    <!-- Maria -->
    <g fill="currentColor" stroke="none">
      <path
        d="M9.2 11.8 C8.8 9 11.4 7 14 7.4 C16.4 7.8 17.6 9.8 16.4 11.6 C15.6 12.8 13.8 12.6 12.8 13.8 C11.6 15.4 9.6 14.4 9.2 11.8 Z"
        fill-opacity="0.3"></path>
      <path
        d="M17.6 14.2 C18.8 12.8 21.2 13 21.8 14.8 C22.4 16.6 20.8 18.2 19 17.8 C17.4 17.4 16.6 15.4 17.6 14.2 Z"
        fill-opacity="0.3"></path>
      <path
        d="M11.8 17.6 C12.8 16.8 14.6 17.2 14.8 18.4 C15 19.6 13.6 20.4 12.4 19.8 C11.2 19.4 11 18.2 11.8 17.6 Z"
        fill-opacity="0.26"></path>
    </g>
    <!-- Rayed crater -->
    <circle cx="19.6" cy="8.6" r="0.9" stroke-width="0.7" stroke-opacity="0.75"></circle>
    <path
      d="M21.2 7.6 L22.2 7 M21.4 9.4 L22.6 9.8 M18.2 7.4 L17.4 6.6"
      stroke-width="0.6"
      stroke-opacity="0.55"></path>
    <!-- Shade hatching -->
    <path
      d="M22.6 17 C21.4 19.4 19.4 21.2 17 22.2 M20.4 21.4 C19.4 22.2 18.2 22.8 17 23.2 M23.8 14 C23.6 14.8 23.4 15.4 23 16.2"
      stroke-width="0.7"
      stroke-opacity="0.55"></path>
    <!-- Cloud wisps -->
    <path
      d="M3.2 27.4 C6.4 26 9.2 28.2 12.4 27.2 C14.2 26.6 15.8 26.6 17.6 27.2"
      stroke-width="1.05"></path>
    <path
      d="M15.2 30 C18.2 29 20.8 30.6 23.8 29.8 C25.4 29.4 27 29.4 28.8 30"
      stroke-width="0.8"
      stroke-opacity="0.65"></path>
  </g>
  <path
    d="M25.58 10.91 A10.2 10.2 0 0 1 12.51 23.98 A10.9 10.9 0 0 0 25.58 10.91 Z"
    fill="currentColor"></path>
  <circle cx="4.4" cy="6.2" r="0.75" fill="currentColor" fill-opacity="0.7"></circle>
  <circle cx="28.2" cy="21" r="0.55" fill="currentColor" fill-opacity="0.55"></circle>
</svg>
