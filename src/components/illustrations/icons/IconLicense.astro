---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Licence, engraved: a certificate with lines of script and a scalloped
       seal with ribbon tails. Themes through currentColor. -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path
      d="M3.4 3.6 L17.6 3 C18.4 3 19 3.6 19 4.4 L19.4 13.4 C17 11.6 13.4 12.6 12.6 15.6 C12.2 17.4 12.6 19.2 13.8 20.3 L4.2 20.8 C3.4 20.8 2.8 20.2 2.8 19.4 L2.4 4.8 C2.4 4.1 2.8 3.6 3.4 3.6 Z"
      fill="currentColor"
      fill-opacity="0.11"
      stroke="none"></path>
    <path
      d="M19.3 11.6 L19 4.4 C19 3.6 18.4 3 17.6 3 L3.4 3.6 C2.8 3.6 2.4 4.1 2.4 4.8 L2.8 19.4 C2.8 20.2 3.4 20.8 4.2 20.8 L11.8 20.4"
      stroke-width="1"></path>
    <path d="M5 5.4 L16.8 4.9 M5.2 18.6 L10.6 18.4" stroke-width="0.5" stroke-opacity="0.45"></path>
    <path
      d="M6 8.4 L15.8 8 M6.1 11 L13 10.7 M6.2 13.6 L10.4 13.4 M6.3 16 L9 15.9"
      stroke-width="0.7"
      stroke-opacity="0.7"></path>
    <!-- Ribbon tails -->
    <path
      d="M15.4 19.4 L14.2 23.2 L16.4 22 L17.5 22.9 L17.8 20.2 M19.4 20.2 L20.3 22.8 L21 21.7 L22.7 22.5 L21 19"
      fill="currentColor"
      fill-opacity="0.3"
      stroke-width="0.8"></path>
    <!-- Seal -->
    <path
      d="M17.6 12.5 L18.7 13.2 L20 13.1 L20.5 14.3 L21.6 15 L21.3 16.3 L21.8 17.5 L20.8 18.4 L20.5 19.7 L19.2 19.8 L18.2 20.6 L17 20 L15.7 20.2 L15 19.1 L13.8 18.6 L13.9 17.3 L13.2 16.2 L14 15.2 L14.1 13.9 L15.4 13.5 L16.3 12.6 Z"
      fill="currentColor"
      fill-opacity="0.34"
      stroke-width="0.85"></path>
    <circle cx="17.55" cy="16.55" r="2" stroke-width="0.6" stroke-opacity="0.75"></circle>
  </g>
  <circle cx="17.55" cy="16.55" r="0.7" fill="currentColor" fill-opacity="0.8"></circle>
</svg>
