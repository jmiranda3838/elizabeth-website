---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Crown, engraved: three curved points tipped with pearls over a jewelled
       band, each point faceted light and dark along its ridge. Themes through
       currentColor. -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path
      d="M8 26.4 L5.8 14 C8.4 17.2 10.8 19.6 13.4 21.2 C16 17.6 18.4 13.6 20 9.2 C21.6 13.6 24 17.6 26.6 21.2 C29.2 19.6 31.6 17.2 34.2 14 L32 26.4 C24.6 28.6 15.4 28.6 8 26.4 Z"
      fill="currentColor"
      fill-opacity="0.12"
      stroke-width="1.55"></path>
    <!-- Shaded facets -->
    <path
      d="M20 9.2 C21.6 13.6 24 17.6 26.6 21.2 L25.4 27.6 C23.6 27.9 21.8 28 20 28 Z M34.2 14 L32 26.4 C30.9 26.7 29.8 27 28.6 27.2 C29.6 23 31.4 18.4 34.2 14 Z M5.8 14 C8.4 17.2 10.8 19.6 13.4 21.2 L12.6 27.4 C11.8 27.3 11 27.1 10.2 26.9 C9.4 22.6 8 18.2 5.8 14 Z"
      fill="currentColor"
      fill-opacity="0.2"
      stroke="none"></path>
    <path
      d="M20 12.4 V27.6 M9.9 26.6 C9.2 22.8 8.2 19.4 6.8 16.4 M28.9 26.9 C29.8 23.2 31.2 19.6 33.2 16.4"
      stroke-width="0.8"
      stroke-opacity="0.5"></path>
    <!-- Band -->
    <path
      d="M8 26.4 C15.4 28.6 24.6 28.6 32 26.4 L31.4 31.4 C24.6 33.4 15.4 33.4 8.6 31.4 Z"
      fill="currentColor"
      fill-opacity="0.28"
      stroke-width="1.55"></path>
    <!-- Pearls -->
    <g fill="currentColor" fill-opacity="0.3" stroke-width="1.25">
      <circle cx="5.6" cy="11.8" r="1.8"></circle>
      <circle cx="20" cy="6.6" r="2.1"></circle>
      <circle cx="34.4" cy="11.8" r="1.8"></circle>
    </g>
  </g>
  <path
    d="M31.4 31.4 C24.6 33.4 15.4 33.4 8.6 31.4 C15.6 32.6 24.6 32.5 31.4 31.4 Z"
    fill="currentColor"></path>
  <path d="M20 28.3 L21.7 30.3 L20 32.3 L18.3 30.3 Z" fill="currentColor" fill-opacity="0.85"
  ></path>
  <circle cx="13.2" cy="29.7" r="0.95" fill="currentColor" fill-opacity="0.8"></circle>
  <circle cx="26.6" cy="29.7" r="0.95" fill="currentColor" fill-opacity="0.8"></circle>
</svg>
