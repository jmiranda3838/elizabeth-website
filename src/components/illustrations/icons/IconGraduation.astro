---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Mortarboard, engraved: a shaded board over a soft cap, with a tassel
       falling from the button. Themes through currentColor. -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <path
      d="M5.8 11.2 V15.6 C5.8 17.6 8.6 19.2 12 19.2 C15.4 19.2 18.2 17.6 18.2 15.6 V11.2"
      fill="currentColor"
      fill-opacity="0.28"
      stroke-width="1"></path>
    <path
      d="M14 17 C15.2 16.8 16.2 16.3 16.9 15.6 M14.2 15.2 C15.4 15 16.3 14.5 16.9 13.8"
      stroke-width="0.6"
      stroke-opacity="0.55"></path>
    <path
      d="M12 4.2 L22.6 8.8 L12 13.6 L1.4 8.8 Z"
      fill="currentColor"
      fill-opacity="0.14"
      stroke-width="1"></path>
    <path d="M12 13.6 L22.6 8.8 L12 4.2 Z" fill="currentColor" fill-opacity="0.12" stroke="none"
    ></path>
    <path d="M12 8.8 L19.8 10.2 C20 12 20 13.6 19.8 15.2" stroke-width="0.8"></path>
    <path d="M19.8 15.2 L18.9 18.6 M19.8 15.2 L19.7 19 M19.8 15.2 L20.7 18.6" stroke-width="0.6"
    ></path>
  </g>
  <path d="M1.4 8.8 L12 13.6 L22.6 8.8 L12 12.8 Z" fill="currentColor"></path>
  <circle cx="12" cy="8.8" r="0.85" fill="currentColor"></circle>
  <circle cx="19.8" cy="15.2" r="0.6" fill="currentColor"></circle>
</svg>
