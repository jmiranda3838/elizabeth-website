---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- A fern fiddlehead: a stalk that thins as it coils, with two folded leaflets -->
  <path
    d="M9.4 22.4 C9.6 17.6 8 13.4 8.4 9.4"
    stroke="currentColor"
    stroke-width="2.3"
    stroke-linecap="round"></path>
  <path
    d="M8.4 9.4 C8.8 4.6 14.4 2.4 17.6 5.6 C20.4 8.6 18.4 13.4 14.6 13.2"
    stroke="currentColor"
    stroke-width="1.9"
    stroke-linecap="round"></path>
  <path
    d="M14.6 13.2 C11.6 13 10.8 9.4 13.2 8.2 C14.8 7.4 16.2 8.8 15.4 10.2"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"></path>
  <circle cx="14.2" cy="10.2" r="1" fill="currentColor"></circle>
  <path
    d="M9 15.4 C6.8 15.2 5 13.8 4.2 11.6 C6.8 11.4 8.8 12.8 9 15.4 Z"
    fill="currentColor"
    fill-opacity="0.4"></path>
  <path
    d="M9.6 18.6 C11.4 18.4 13 17.2 13.6 15.2 C11.4 15 9.8 16.4 9.6 18.6 Z"
    fill="currentColor"
    fill-opacity="0.28"></path>
  <path
    d="M9 15.4 C6.8 15.2 5 13.8 4.2 11.6 C6.8 11.4 8.8 12.8 9 15.4 Z M9.6 18.6 C11.4 18.4 13 17.2 13.6 15.2 C11.4 15 9.8 16.4 9.6 18.6 Z"
    stroke="currentColor"
    stroke-width="0.8"
    stroke-linejoin="round"></path>
</svg>
