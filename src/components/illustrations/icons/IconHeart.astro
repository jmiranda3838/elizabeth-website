---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Heart, engraved: one pen stroke that runs on past the cleft, a little
       lopsided, its shadow side hatched and inked heavier, with a leafy sprig
       laid beside it. Themes through currentColor. -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- Heart: one pen stroke, begun at the cleft and run past it -->
    <path
      d="M21.6 10.6 C20 6.6 16 4.2 12 5 C7.6 6 5.4 10.2 6.2 14.8 C7.4 21.6 14 27.4 21 33.4 C27.8 28 35.4 22.6 36.6 15.2 C37.4 10.4 34.6 6 30.2 5.4 C26.4 5 23 7 21.6 10.6 Z"
      fill="currentColor"
      fill-opacity="0.14"
      stroke="none"></path>
    <path
      d="M21.6 10.6 C20 6.6 16 4.2 12 5 C7.6 6 5.4 10.2 6.2 14.8 C7.4 21.6 14 27.4 21 33.4 C27.8 28 35.4 22.6 36.6 15.2 C37.4 10.4 34.6 6 30.2 5.4 C26.4 5 23 7 21.6 10.6 C21 12.4 21 14.2 21.8 15.8"
      stroke-width="1.5"></path>
    <!-- Hatching on the shadow side, and where the right lobe tucks under the left -->
    <path
      d="M31.4 16.9 Q33.2 17 34.9 16.4 M29.6 19 Q31.8 19.2 34 18.5 M27.9 21.1 Q30.4 21.3 32.9 20.5 M26.3 23.2 Q29 23.4 31.4 22.6 M25 25.3 Q27.4 25.5 29.6 24.7 M23.8 27.4 Q25.8 27.5 27.6 26.8 M22.8 29.4 Q24.2 29.5 25.4 28.9 M21.9 31.3 L22.9 31.1"
      stroke-width="0.75"
      stroke-opacity="0.62"></path>
    <path
      d="M23 12.4 L24.8 12.1 M23.1 14.4 L25.6 14 M23.6 16.4 L25.4 16.1"
      stroke-width="0.7"
      stroke-opacity="0.55"></path>
    <!-- Sprig laid beside it -->
    <path d="M19 37.4 C14 36.4 9.4 33 6 27.4" stroke-width="1.1"></path>
    <g fill="currentColor" fill-opacity="0.45" stroke-width="0.9">
      <path d="M14.6 35.9 C12.8 38.4 10.4 39.2 8.2 38.6 C9.6 36.2 12 35.2 14.6 35.9 Z"></path>
      <path d="M10.6 33 C8.6 35 6.2 35.4 4 34.4 C5.6 32.4 8 31.8 10.6 33 Z"></path>
      <path d="M8.2 30.5 C6.2 31.6 4 31.2 2.6 29.4 C4.4 28.2 6.6 28.6 8.2 30.5 Z"></path>
      <path d="M6 27.4 C4.2 25.8 3.6 23.6 4.4 21.2 C6.4 22.8 7 25 6 27.4 Z"></path>
      <path d="M12.4 34.3 C11.4 32.4 11.8 30.6 13.6 29.4 C14.6 31.2 14.2 33 12.4 34.3 Z"></path>
    </g>
  </g>
</svg>
<path d="M36.6 15.2 C35.4 22.6 27.8 28 21 33.4 C26.6 27.8 33.2 22.6 36.6 15.2 Z" fill="currentColor"
></path>
