---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Two cups side by side, engraved: a round teacup and a taller one, each
       with its own thread of steam, set down on the same table. Themes through
       currentColor. -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- Table -->
    <path d="M1.2 21.2 Q12 22.4 22.8 21.2" stroke-width="0.6" stroke-opacity="0.55"></path>
    <!-- Round cup -->
    <path d="M3.5 12.4 C1.4 12.2 1.2 15.6 4.3 15.6" stroke-width="1"></path>
    <path
      d="M3.2 11 C3.2 15.2 4.6 18.2 7.2 18.2 C9.8 18.2 11.2 15.2 11.2 11"
      fill="currentColor"
      fill-opacity="0.14"
      stroke-width="1"></path>
    <ellipse
      cx="7.2"
      cy="11"
      rx="4"
      ry="1.25"
      fill="currentColor"
      fill-opacity="0.3"
      stroke-width="0.75"></ellipse>
    <path d="M2.6 19.6 C4.6 20.5 9.8 20.5 11.8 19.6" stroke-width="1"></path>
    <path d="M9.4 13.4 C9.3 14.8 8.9 15.8 8.2 16.6" stroke-width="0.6" stroke-opacity="0.6"></path>
    <!-- Tall cup -->
    <path d="M20.5 11.2 C22.8 11 23 15 19.9 15.2" stroke-width="1"></path>
    <path
      d="M13.1 9.6 C13.1 13.4 13.6 16.4 14.6 18.4 H19.3 C20.3 16.4 20.8 13.4 20.8 9.6"
      fill="currentColor"
      fill-opacity="0.26"
      stroke-width="1"></path>
    <ellipse
      cx="16.95"
      cy="9.6"
      rx="3.85"
      ry="1.2"
      fill="currentColor"
      fill-opacity="0.3"
      stroke-width="0.75"></ellipse>
    <path d="M12.6 19.8 C14.4 20.6 19.6 20.6 21.4 19.8" stroke-width="1"></path>
    <path d="M15 12 L18.9 12 M15.2 13.6 L18.8 13.6" stroke-width="0.6" stroke-opacity="0.55"></path>
    <!-- Steam -->
    <path d="M6.6 8.4 C5.6 7.2 7.8 6.4 6.8 5 C6.2 4.2 6.6 3.4 7.2 2.8" stroke-width="0.8"></path>
    <path d="M9 8 C8.4 7.2 9.6 6.6 9.2 5.6" stroke-width="0.7" stroke-opacity="0.7"></path>
    <path d="M17 7 C18 5.8 15.8 5 16.8 3.6 C17.4 2.8 17 2 16.4 1.4" stroke-width="0.8"></path>
  </g>
  <path d="M11.2 11 C11.2 15.2 9.8 18.2 7.2 18.2 C9.4 17.6 10.5 15 10.6 11.4 Z" fill="currentColor"
  ></path>
  <path
    d="M20.8 9.6 C20.8 13.4 20.3 16.4 19.3 18.4 H18.5 C19.6 16.2 20.1 13.4 20.2 10 Z"
    fill="currentColor"></path>
</svg>
