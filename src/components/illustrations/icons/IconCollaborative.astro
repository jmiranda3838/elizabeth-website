---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 24 24"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Two cups shared, engraved: a teacup on its saucer and a taller mug with a
       tea tag, set down side by side, their steam leaning together. Themes
       through currentColor. -->
  <ellipse cx="12" cy="21" rx="10.8" ry="1.5" fill="currentColor" fill-opacity="0.13"></ellipse>
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- Teacup on its saucer -->
    <path
      d="M12.9 19.2 C12.2 20.6 2.4 20.8 1.5 19.3 C1.4 18.7 2.6 18.3 4.2 18.1 M10.6 18.1 C11.9 18.3 12.9 18.6 12.9 19.2"
      stroke-width="0.9"></path>
    <path d="M2.75 13.4 C0.8 13 0.6 16.2 3.45 16.4" stroke-width="1"></path>
    <path
      d="M2.6 12.3 C2.7 15.6 4.2 18 5.9 18.8 H8.9 C10.6 18 12.1 15.6 12.2 12.3 A4.8 1.5 0 0 1 2.6 12.3 Z"
      fill="currentColor"
      fill-opacity="0.16"
      stroke="none"></path>
    <path d="M2.6 12.3 C2.7 15.6 4.2 18 5.9 18.8 H8.9 C10.6 18 12.1 15.6 12.2 12.3" stroke-width="1"
    ></path>
    <ellipse
      cx="7.4"
      cy="12.3"
      rx="4.8"
      ry="1.5"
      fill="currentColor"
      fill-opacity="0.1"
      stroke-width="0.9"></ellipse>
    <path
      d="M3.9 12.5 C4.6 13.4 10.2 13.4 10.9 12.5 C10 11.9 4.8 11.9 3.9 12.5 Z"
      fill="currentColor"
      fill-opacity="0.4"
      stroke="none"></path>
    <path
      d="M9.7 14.5 L11.3 14.3 M9.5 15.7 L10.9 15.5 M9 16.9 L10.1 16.7"
      stroke-width="0.5"
      stroke-opacity="0.65"></path>
    <!-- Mug -->
    <path d="M20.7 12.2 C23.6 11.8 23.7 16.8 20.4 16.9" stroke-width="1"></path>
    <path
      d="M13.5 10.5 C13.5 13.8 13.8 17 14.4 19.7 C15.8 20.5 18.8 20.5 20.2 19.7 C20.7 17 21 13.8 21 10.5 A3.75 1.25 0 0 1 13.5 10.5 Z"
      fill="currentColor"
      fill-opacity="0.28"
      stroke="none"></path>
    <path
      d="M13.5 10.5 C13.5 13.8 13.8 17 14.4 19.7 C15.8 20.5 18.8 20.5 20.2 19.7 C20.7 17 21 13.8 21 10.5"
      stroke-width="1"></path>
    <ellipse
      cx="17.25"
      cy="10.5"
      rx="3.75"
      ry="1.25"
      fill="currentColor"
      fill-opacity="0.12"
      stroke-width="0.9"></ellipse>
    <path
      d="M14.6 10.7 C15.2 11.4 19.3 11.4 19.9 10.7 C19.2 10.2 15.3 10.2 14.6 10.7 Z"
      fill="currentColor"
      fill-opacity="0.4"
      stroke="none"></path>
    <path
      d="M14.05 17.1 C15.6 17.9 18.9 17.9 20.5 17.1 M14.25 18.2 C15.7 19 18.8 19 20.35 18.2"
      stroke-width="0.5"
      stroke-opacity="0.6"></path>
    <!-- Tea tag -->
    <path d="M15.5 11.5 C15.3 12.6 15.5 13.4 15.4 14.2" stroke-width="0.5"></path>
    <path
      d="M14.7 14.2 H16.2 V16.2 H14.7 Z"
      fill="currentColor"
      fill-opacity="0.5"
      stroke-width="0.5"></path>
    <!-- Steam, leaning together -->
    <path d="M7.4 9.6 C6.2 8.2 9 7.2 8.2 5.4 C7.6 4 8.8 2.4 10.6 1.6" stroke-width="0.8"></path>
    <path
      d="M17 7.8 C18.2 6.6 15.4 5.9 15.8 4.4 C16 3.6 15.2 2.8 14 2.6"
      stroke-width="0.7"
      stroke-opacity="0.85"></path>
    <path d="M9.8 9.2 C9.3 8.4 10.5 7.8 10.2 6.8" stroke-width="0.55" stroke-opacity="0.6"></path>
  </g>
  <path
    d="M12.2 12.3 C12.1 15.6 10.6 18 8.9 18.8 C10.4 17.6 11.4 15.4 11.6 12.6 Z"
    fill="currentColor"></path>
  <path
    d="M21 10.5 C21 13.8 20.7 17 20.2 19.7 C19.9 19.9 19.6 20 19.3 20.1 C19.9 17.2 20.3 14 20.4 10.9 Z"
    fill="currentColor"></path>
</svg>
