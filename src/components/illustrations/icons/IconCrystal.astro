---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 32 32"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Quartz cluster, engraved: one tall point and two leaning shards on a
       scrap of matrix, faces shaded light to dark. Themes through currentColor. -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- Left shard -->
    <path
      d="M5 12.8 L8.9 15.8 L11.3 21.4 L11.4 25.4 L7.2 26 L3.5 17 Z"
      fill="currentColor"
      fill-opacity="0.1"
      stroke-width="1.25"></path>
    <path
      d="M6.3 17.5 L8.9 15.8 L11.3 21.4 L11.4 25.4 L9.4 25.7 Z"
      fill="currentColor"
      fill-opacity="0.2"
      stroke="none"></path>
    <path
      d="M5 12.8 L6.3 17.5 L9.4 25.7 M3.5 17 L6.3 17.5 L8.9 15.8"
      stroke-width="0.7"
      stroke-opacity="0.75"></path>
    <!-- Right shard -->
    <path
      d="M26.8 14.6 L28.7 19.2 L25.8 26.4 L20.7 25.6 L20.9 21.2 L23.4 17.4 Z"
      fill="currentColor"
      fill-opacity="0.1"
      stroke-width="1.25"></path>
    <path
      d="M25.7 19.8 L28.7 19.2 L25.8 26.4 L23.6 26 Z"
      fill="currentColor"
      fill-opacity="0.28"
      stroke="none"></path>
    <path
      d="M26.8 14.6 L25.7 19.8 L23.6 26 M23.4 17.4 L25.7 19.8 L28.7 19.2"
      stroke-width="0.7"
      stroke-opacity="0.75"></path>
    <!-- Tall point -->
    <path
      d="M16.6 2.8 L21.5 9.8 L20.7 25.6 L11.4 25.4 L11.1 9.2 Z"
      fill="currentColor"
      fill-opacity="0.1"
      stroke-width="1.25"></path>
    <path
      d="M15.3 11.2 L21.5 9.8 L20.7 25.6 L15.1 25.5 Z"
      fill="currentColor"
      fill-opacity="0.24"
      stroke="none"></path>
    <path d="M16.6 2.8 L21.5 9.8 L15.3 11.2 Z" fill="currentColor" fill-opacity="0.12" stroke="none"
    ></path>
    <path
      d="M16.6 2.8 L15.3 11.2 L15.1 25.5 M11.1 9.2 L15.3 11.2 L21.5 9.8"
      stroke-width="0.7"
      stroke-opacity="0.75"></path>
    <!-- Striations -->
    <path
      d="M13 13.6 V20.4 M12.9 22.4 V23.6 M17.4 13.4 L19.6 12.9 M17.4 15.6 L19.5 15.1 M17.3 17.8 L19.4 17.3 M17.3 20 L19.3 19.5 M17.2 22.2 L19.2 21.7"
      stroke-width="0.6"
      stroke-opacity="0.5"></path>
    <!-- Matrix -->
    <path
      d="M2.4 28.8 C4.2 26.8 5.6 26.1 7.2 26 L11.4 25.4 L20.7 25.6 L25.8 26.4 C27.4 26.6 28.6 27.4 29.8 29"
      stroke-width="1.05"></path>
    <path
      d="M8.6 28.4 q1.6 -0.6 3.2 0 M18.4 28.2 q1.8 -0.6 3.4 0.2 M13.6 29.6 q1.4 -0.4 2.6 0"
      stroke-width="0.7"
      stroke-opacity="0.55"></path>
  </g>
  <path d="M21.5 9.8 L20.7 25.6 L20 25.6 L20.6 11 Z" fill="currentColor"></path>
  <path
    d="M26 3.2 C26.2 4.9 26.7 5.4 28.4 5.6 C26.7 5.8 26.2 6.3 26 8 C25.8 6.3 25.3 5.8 23.6 5.6 C25.3 5.4 25.8 4.9 26 3.2 Z"
    fill="currentColor"
    fill-opacity="0.8"></path>
</svg>
