---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Seedling, engraved: two unequal leaves and a furled shoot on a leaning
       stem, rising from a mound of soil. Themes through currentColor. -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- Soil -->
    <path
      d="M6.6 34.6 C10.6 31.4 15 30.4 20 30.6 C25.4 30.8 29.8 31.8 33.6 34.8 Z"
      fill="currentColor"
      fill-opacity="0.22"
      stroke="none"></path>
    <path d="M6.6 34.6 C10.6 31.4 15 30.4 20 30.6 C25.4 30.8 29.8 31.8 33.6 34.8" stroke-width="1.2"
    ></path>
    <path d="M3.4 35.8 Q20 37.8 36.6 35.8" stroke-width="0.9" stroke-opacity="0.55"></path>
    <!-- Stem -->
    <path d="M20 30.6 C19.4 26.4 20.8 22 19.6 16.4" stroke-width="1.6"></path>
    <!-- Left leaf, the larger -->
    <path
      d="M20 23.8 C14.4 24.2 8.8 21 6 13.8 C12.8 13.4 18.8 17 20 23.8 Z"
      fill="currentColor"
      fill-opacity="0.3"
      stroke-width="1.3"></path>
    <path
      d="M18.6 22 C15.4 19.4 11.8 16.8 8 14.8 M15.6 19.8 L15.4 17.6 M15.6 19.8 L13.4 21 M12.4 17.4 L12 15.6 M12.4 17.4 L10.4 18.4"
      stroke-width="0.8"
      stroke-opacity="0.7"></path>
    <!-- Right leaf -->
    <path
      d="M19.8 19 C21 12.8 26.2 8.8 33.4 9.2 C32.6 15.8 27 19.8 19.8 19 Z"
      fill="currentColor"
      fill-opacity="0.15"
      stroke-width="1.3"></path>
    <path
      d="M21.4 17.6 C24.6 15 28.2 12.4 32 10.4 M24.6 15.2 L24.6 13 M24.6 15.2 L26.8 16.2 M28 12.8 L28.2 11 M28 12.8 L30 13.6"
      stroke-width="0.8"
      stroke-opacity="0.7"></path>
    <!-- Furled shoot -->
    <path
      d="M19.6 16.4 C17.6 13.4 17 9.6 18 5.6 C20.2 8.8 20.6 12.6 19.6 16.4 Z"
      fill="currentColor"
      fill-opacity="0.42"
      stroke-width="1.1"></path>
  </g>
  <!-- Heavier underside of each leaf -->
  <path d="M20 23.8 C14.4 24.2 8.8 21 6 13.8 C9.4 20 14.6 23 20 23.8 Z" fill="currentColor"></path>
  <path d="M33.4 9.2 C32.6 15.8 27 19.8 19.8 19 C26.4 18.8 31.4 15.2 33.4 9.2 Z" fill="currentColor"
  ></path>
  <circle cx="13.4" cy="33.2" r="0.65" fill="currentColor" fill-opacity="0.7"></circle>
  <circle cx="24.6" cy="33" r="0.65" fill="currentColor" fill-opacity="0.7"></circle>
  <circle cx="28.4" cy="33.8" r="0.5" fill="currentColor" fill-opacity="0.6"></circle>
</svg>
