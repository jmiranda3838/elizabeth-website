---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 40 40"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Seedling, engraved: a large lifted leaf, a smaller drooping one and a
       furled new leaf on a leaning stem, the soil cut through to show its
       roots. Themes through currentColor. -->
  <g stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
    <!-- Soil, cut through -->
    <path
      d="M4.6 30.8 C8 29.4 11 30.6 14 29.8 C16.4 29.2 18.6 30 20.6 29.6 C24 28.8 27 30.2 30 29.6 C32.4 29.2 34.4 30 35.8 30.6 C31.8 33.6 26.6 35.4 20.4 35.4 C14.2 35.4 8.6 33.8 4.6 30.8 Z"
      fill="currentColor"
      fill-opacity="0.2"
      stroke="none"></path>
    <path
      d="M4.6 30.8 C8 29.4 11 30.6 14 29.8 C16.4 29.2 18.6 30 20.6 29.6 C24 28.8 27 30.2 30 29.6 C32.4 29.2 34.4 30 35.8 30.6"
      stroke-width="1.2"></path>
    <!-- Roots -->
    <path d="M20.3 30 C20.8 32.6 19.6 35 20.5 38" stroke-width="1"></path>
    <path
      d="M20.4 32.2 C18 32.8 16.2 34.2 15 36.2 M20.2 34.2 C22.6 34.6 24.2 35.8 25.2 37.6 M20.2 36.2 C19 36.8 18.2 37.6 17.8 38.6"
      stroke-width="0.75"
      stroke-opacity="0.75"></path>
    <!-- Left leaf, small and drooping -->
    <path
      d="M18.9 22.8 C16 18.4 10.6 16.6 6.4 18 C5 18.6 3.8 19.8 3.2 21.6 C8.6 19.6 14.2 20.2 18.9 22.8 Z"
      fill="currentColor"
      fill-opacity="0.14"
      stroke="none"></path>
    <path
      d="M18.9 22.8 C14.2 20.2 8.6 19.6 3.2 21.6 C7.4 25.6 13.8 26.2 18.9 22.8 Z"
      fill="currentColor"
      fill-opacity="0.36"
      stroke="none"></path>
    <path
      d="M18.9 22.8 C16 18.4 10.6 16.6 6.4 18 C5 18.6 3.8 19.8 3.2 21.6 C7.4 25.6 13.8 26.2 18.9 22.8 Z"
      stroke-width="1.25"></path>
    <path
      d="M18.9 22.8 C14.2 20.2 8.6 19.6 3.2 21.6 M15.6 21.2 L13.6 19 M12.2 20.4 L10.2 18.4 M8.8 20.2 L7.2 18.8"
      stroke-width="0.75"
      stroke-opacity="0.75"></path>
    <!-- Right leaf, large and lifted -->
    <path
      d="M20.6 17.6 C20.6 12 25.6 6.8 32.6 5.4 C33.8 5.2 35 5.2 36 5.6 C30.2 9.6 25 14.4 20.6 17.6 Z"
      fill="currentColor"
      fill-opacity="0.14"
      stroke="none"></path>
    <path
      d="M20.6 17.6 C25 14.4 30.2 9.6 36 5.6 C35.4 12.4 29.2 18.6 20.6 17.6 Z"
      fill="currentColor"
      fill-opacity="0.36"
      stroke="none"></path>
    <path
      d="M20.6 17.6 C20.6 12 25.6 6.8 32.6 5.4 C33.8 5.2 35 5.2 36 5.6 C35.4 12.4 29.2 18.6 20.6 17.6 Z"
      stroke-width="1.25"></path>
    <path
      d="M20.6 17.6 C25 14.4 30.2 9.6 36 5.6 M23.8 15.2 L24.4 11.6 M27 12.4 L27.8 9.2 M30.4 9.6 L31.2 7.2 M25.6 13.8 L28.6 14.8 M28.8 11 L31.4 11.6"
      stroke-width="0.75"
      stroke-opacity="0.75"></path>
    <!-- New leaf, still furled -->
    <path
      d="M20 12.8 C17.6 10.6 17 7.2 18.4 3.8 C20.8 6.4 21.4 9.8 20 12.8 Z"
      fill="currentColor"
      fill-opacity="0.42"
      stroke-width="1.05"></path>
  </g>
  <!-- Stem, thick at the foot -->
  <path
    d="M19 30 C18.6 26.8 17.8 23.8 18.5 20.6 C19.1 17.8 20.2 15.4 19.7 12.6 L20.5 12.5 C21.4 15.4 20.7 18 20.1 20.8 C19.6 23.8 20.8 26.8 21.5 30 Z"
    fill="currentColor"></path>
  <!-- Inked undersides -->
  <path d="M3.2 21.6 C7.4 25.6 13.8 26.2 18.9 22.8 C14 24.8 8.4 24.6 3.2 21.6 Z" fill="currentColor"
  ></path>
  <path d="M36 5.6 C35.4 12.4 29.2 18.6 20.6 17.6 C27.8 17.4 33.6 12.4 36 5.6 Z" fill="currentColor"
  ></path>
  <circle cx="11" cy="32.2" r="0.65" fill="currentColor" fill-opacity="0.7"></circle>
  <circle cx="27.6" cy="32" r="0.7" fill="currentColor" fill-opacity="0.7"></circle>
  <circle cx="31.2" cy="31.6" r="0.5" fill="currentColor" fill-opacity="0.6"></circle>
</svg>
