---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

const r = (n: number) => Math.round(n * 10) / 10;
const HEAD = { x: 138, y: 112 };

type V3 = [number, number, number];
const add = (a: V3, b: V3, k = 1): V3 => [a[0] + b[0] * k, a[1] + b[1] * k, a[2] + b[2] * k];
const norm = (a: V3): V3 => {
  const l = Math.hypot(a[0], a[1], a[2]) || 1;
  return [a[0] / l, a[1] / l, a[2] / l];
};
const cross = (a: V3, b: V3): V3 => [
  a[1] * b[2] - a[2] * b[1],
  a[2] * b[0] - a[0] * b[2],
  a[0] * b[1] - a[1] * b[0],
];
// A small seeded generator, so the drawing is the same on every build
let state = 20261117;
const rand = () => {
  state = (state * 1664525 + 1013904223) % 4294967296;
  return state / 4294967296;
};
const P = (o: V3, v: V3) => `${r(o[0] + v[0])} ${r(o[1] + v[1])}`;

/* One seed, in 3D around the origin `o` (screen x right, y down, z toward the
   viewer) and drawn flat: the beak runs from the achene out along `d`, with a
   slight bow, and ends in a parachute of hairs that open as a shallow cone.
   Side-on seeds read as fans, seeds facing the viewer as little stars. */
function seed(o: V3, base: V3, d: V3, len: number, hair: number, k: number) {
  const tip = add(base, d, len);
  const bow = (rand() - 0.5) * len * 0.08;
  const mid = add(add(base, d, len * 0.5), [-d[1], d[0], 0], bow);
  const beak = `M${P(o, base)}Q${P(o, mid)} ${P(o, tip)}`;
  const u = norm(cross(d, Math.abs(d[2]) > 0.9 ? [1, 0, 0] : [0, 0, 1]));
  const v = cross(d, u);
  let hairs = "";
  const spin = rand() * Math.PI * 2;
  for (let i = 0; i < k; i++) {
    const phi = spin + (i / k) * Math.PI * 2 + (rand() - 0.5) * 0.5;
    const ring = add(
      [u[0] * Math.cos(phi), u[1] * Math.cos(phi), u[2] * Math.cos(phi)],
      v,
      Math.sin(phi),
    );
    const c = 1.08 + rand() * 0.22; // opening angle of the parachute
    const hd = norm(
      add([d[0] * Math.cos(c), d[1] * Math.cos(c), d[2] * Math.cos(c)], ring, Math.sin(c)),
    );
    const hl = hair * (0.8 + rand() * 0.32);
    // each hair leaves along the beak, then relaxes outward
    const ctrl = add(tip, norm(add(d, hd, 1.4)), hl * 0.55);
    hairs += `M${P(o, tip)}Q${P(o, ctrl)} ${P(o, add(tip, hd, hl))}`;
  }
  return { beak, hairs, tip };
}

/* The clock: seeds spread evenly over a sphere (a Fibonacci lattice), less the
   windward quarter that has already blown and the underside where the stem
   meets the head. Drawn back, middle and front, each a little stronger. */
const O: V3 = [HEAD.x, HEAD.y, 0];
const layers = [
  { beak: "", hairs: "" },
  { beak: "", hairs: "" },
  { beak: "", hairs: "" },
];
const achenes: [number, number, number][] = [];
const N = 128;
for (let i = 0; i < N; i++) {
  const y = 1 - ((i + 0.5) / N) * 2;
  const rad = Math.sqrt(1 - y * y);
  const th = i * 2.39996 + 0.4;
  const d = norm([
    Math.cos(th) * rad + (rand() - 0.5) * 0.12,
    y + (rand() - 0.5) * 0.12,
    Math.sin(th) * rad + (rand() - 0.5) * 0.12,
  ]);
  const deg = (Math.atan2(d[1], d[0]) * 180) / Math.PI;
  const flat = Math.hypot(d[0], d[1]);
  // the blown quarter, up and to the right, with a ragged, thinning edge
  const lo = -104 + rand() * 18;
  const hi = -14 - rand() * 22;
  if (flat > 0.25 && deg > lo && deg < hi) continue;
  if (flat > 0.25 && deg > lo - 18 && deg < hi + 16 && rand() < 0.4) continue;
  // where the stem joins, a few seeds already gone elsewhere, and some of
  // those facing straight out, which would only crowd the middle
  if (d[1] > 0.86 || rand() < 0.06 || (d[2] > 0.8 && rand() < 0.6)) continue;
  const base = add([0, 0, 0], d, 5.4);
  const len = 29 + rand() * 7;
  const layer = d[2] < -0.25 ? 0 : d[2] < 0.35 ? 1 : 2;
  const s = seed(O, base, d, len, 7.6 + rand() * 1.8, layer === 0 ? 7 : 8);
  layers[layer].beak += s.beak;
  layers[layer].hairs += s.hairs;
  if (d[2] > 0.3) achenes.push([r(O[0] + base[0]), r(O[1] + base[1]), r(Math.atan2(d[1], d[0]))]);
}

// Seeds on the wind, nearest first: [x, y of the achene, angle°, tilt toward us°, size]
const adrift = [
  [186, 96, -62, 18, 1],
  [214, 70, -38, -26, 0.96],
  [236, 108, -74, 40, 0.9],
  [262, 50, -52, -10, 0.86],
  [286, 88, -30, 30, 0.8],
  [300, 30, -66, -34, 0.74],
].map(([x, y, deg, tilt, s], i) => {
  const a = (deg * Math.PI) / 180;
  const t = (tilt * Math.PI) / 180;
  const d: V3 = [Math.cos(a) * Math.cos(t), Math.sin(a) * Math.cos(t), Math.sin(t)];
  return { ...seed([x, y, 0], [0, 0, 0], d, 19 * s, 8.6 * s, 9), x, y, deg, s, i };
});

// Toothed leaves of the rosette: [rotation°, length, mirrored, fill]
const leaves: [number, number, number, string][] = [
  [-74, 74, 1, "#a9bcb0"],
  [68, 70, -1, "#96aca0"],
  [-46, 62, 1, "#96aca0"],
  [40, 58, -1, "#b5c7ba"],
  [-98, 50, -1, "#b5c7ba"],
  [94, 48, 1, "#a9bcb0"],
];
// One "lion's tooth" leaf from its base at the origin, pointing up, length 100:
// the lobes point back toward the crown, as they do on the real plant
const TOOTH_LEFT =
  "M0 0 C-1.6 -8 -2.4 -13 -3 -18 C-7 -17 -11 -14 -15 -10 C-13 -18 -9 -25 -4.6 -29 C-5.4 -33 -6 -37 -6.6 -41 C-11 -40 -16 -37 -21 -32 C-18 -42 -13 -50 -7.6 -54 C-8 -58 -8.4 -62 -8.6 -66 C-13 -65.6 -17 -63 -21 -59 C-19 -68 -15 -75 -9 -79 C-8 -88 -5 -95 0 -100";
const TOOTH =
  TOOTH_LEFT +
  " C5 -95 8 -88 9 -80 C14 -75 18 -69 20 -61 C16 -65 12 -67 8.4 -67 C8.2 -63 7.8 -59 7.4 -55 C13 -51 17 -44 20 -35 C15 -39 10.6 -41.6 6.4 -42 C5.8 -38 5.2 -34 4.6 -30 C9 -26 12.6 -20 14 -12 C10.6 -16 6.8 -18.4 3 -19 C2.4 -13 1.6 -8 0 0 Z";
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 320 300"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- A dandelion clock with a quarter of its seeds already gone on the wind: a
       rosette of toothed leaves, a hollow stem, the half-bare seed head, a
       closed bud beside it, and six seeds drifting off (each a .dandelion-seed
       group, so a page may let them bob). -->
  <defs>
    <radialGradient id="dc-puff" cx="46%" cy="44%" r="56%">
      <stop offset="0" stop-color="#fff" stop-opacity="0.95"></stop>
      <stop offset="0.6" stop-color="#fff" stop-opacity="0.62"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="dc-halo">
      <stop offset="0" stop-color="#fff" stop-opacity="0.7"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="dc-stem" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#b5c7ba"></stop>
      <stop offset="0.7" stop-color="#a9bcb0"></stop>
      <stop offset="1" stop-color="#d7b3a8"></stop>
    </linearGradient>
  </defs>

  <!-- Ground -->
  <ellipse cx="150" cy="276" rx="118" ry="9" fill="#60665a" fill-opacity="0.07"></ellipse>
  <path
    d="M34 280 C70 268 108 264 150 265 C196 266 240 270 286 280 C240 284 80 284 34 280 Z"
    fill="#e9d6cc"></path>
  <path
    d="M34 280 C70 268 108 264 150 265 C196 266 240 270 286 280"
    stroke="#d0b4a6"
    stroke-width="1"
    stroke-linecap="round"
    stroke-dasharray="46 7 20 9 70 8"></path>

  <!-- Rosette -->
  {
    leaves.map(([rot, len, flip, fill]) => (
      <g
        transform={`translate(132 270) rotate(${rot}) scale(${r((len / 100) * flip)} ${r(len / 100)})`}
      >
        <path d={TOOTH} fill={fill} />
        <path d={`${TOOTH_LEFT} L0 0 Z`} fill="#60665a" fill-opacity="0.1" />
        <path
          d="M0 -2 C0.6 -34 -0.6 -66 0 -96"
          stroke="#f1f5f3"
          stroke-opacity="0.8"
          stroke-width="1.6"
          stroke-linecap="round"
        />
      </g>
    ))
  }
  <path
    d="M96 272 l-4 -9 M100 272 l0 -11 M104 272 l4 -8 M176 273 l-3 -8 M180 273 l1 -10 M184 273 l4 -7 M222 276 l-3 -7 M226 276 l1 -9"
    stroke="#96aca0"
    stroke-width="1"
    stroke-linecap="round"></path>

  <!-- Bud on a short stem, still closed -->
  <path
    d="M134 268 C120 246 104 228 96 204"
    stroke="url(#dc-stem)"
    stroke-width="3.4"
    stroke-linecap="round"></path>
  <path
    d="M96 206 C88 200 86 188 92 178 C96 172 100 172 104 178 C108 188 104 200 96 206 Z"
    fill="#a9bcb0"></path>
  <path
    d="M96 206 C100 198 102 188 100 176 C104 176 106 180 105 186 C105 196 101 202 96 206 Z"
    fill="#60665a"
    fill-opacity="0.12"></path>
  <path
    d="M92 178 C94 172 96 168 98 166 C99 169 101 173 104 178 M95 204 C90 206 86 204 84 200 M98 205 C102 208 106 206 108 202"
    stroke="#7f9689"
    stroke-width="1"
    stroke-linecap="round"></path>
  <path d="M95 170 C96 166 98 164 99 163 C100 165 101 168 101 171 Z" fill="#f9c8c2"></path>

  <!-- Main stem -->
  <path
    d="M132 268 C140 228 126 176 137 120"
    stroke="url(#dc-stem)"
    stroke-width="4.6"
    stroke-linecap="round"></path>
  <path
    d="M130.6 262 C137 226 124.6 176 135.2 124"
    stroke="#fff"
    stroke-opacity="0.5"
    stroke-width="1.1"
    stroke-linecap="round"></path>

  <!-- Seed head: the far side of the clock, the bracts and bare receptacle,
       then the near side over them -->
  <circle cx={HEAD.x - 7} cy={HEAD.y + 7} r="43" fill="url(#dc-puff)"></circle>
  <g stroke-linecap="round">
    <path d={layers[0].beak} stroke="#b3c3b7" stroke-width="0.5"></path>
    <path d={layers[0].hairs} stroke="#c3d0c6" stroke-width="0.4"></path>
  </g>
  <!-- bracts folded back under the head -->
  <path
    d="M132 119 C125 124 121 131 120.6 139 C126 135.6 131 130 134.6 122 Z M138 120 C136.6 127 137.6 135 140.6 142 C142.6 135 142.8 127 140.8 120 Z M144 118 C149.6 123 153.4 130 154.4 138 C149 134.6 145 129 141.4 121 Z"
    fill="#a3b7aa"></path>
  <path
    d="M127 125 C124.6 129 123 133 122.6 137 M139 124 C139 130 139.6 135 140.6 139 M148 123 C150.6 127 152.4 131 153 135"
    stroke="#f1f5f3"
    stroke-opacity="0.55"
    stroke-width="0.7"
    stroke-linecap="round"></path>
  <!-- the receptacle, pitted where seeds have left -->
  <ellipse cx={HEAD.x} cy={HEAD.y} rx="6.6" ry="6" fill="#ecdccb"></ellipse>
  <ellipse cx={HEAD.x} cy={HEAD.y} rx="6.6" ry="6" stroke="#b99c8c" stroke-width="0.7"></ellipse>
  <path
    d="M141 108.6 h0.1 M143.2 111.4 h0.1 M140.4 112.2 h0.1 M142.2 114.6 h0.1 M138.6 109.4 h0.1"
    stroke="#b99c8c"
    stroke-width="1.2"
    stroke-linecap="round"></path>
  <g stroke-linecap="round">
    <path d={layers[1].beak} stroke="#a3b3a7" stroke-width="0.5"></path>
    <path d={layers[1].hairs} stroke="#afbfb3" stroke-width="0.42"></path>
  </g>
  <g fill="#b8817e" fill-opacity="0.7">
    {
      achenes.map(([x, y, a]) => (
        <ellipse
          cx={x}
          cy={y}
          rx="0.6"
          ry="1.5"
          transform={`rotate(${r((a * 180) / Math.PI + 90)} ${x} ${y})`}
        />
      ))
    }
  </g>
  <g stroke-linecap="round">
    <path d={layers[2].beak} stroke="#8e9f93" stroke-width="0.55"></path>
    <path d={layers[2].hairs} stroke="#95a69a" stroke-width="0.45" stroke-opacity="0.8"></path>
  </g>

  <!-- Seeds on the wind -->
  {
    adrift.map((s) => (
      <g class="dandelion-seed" style={`--i:${s.i}`}>
        <circle cx={r(s.tip[0] + s.x)} cy={r(s.tip[1] + s.y)} r={r(9 * s.s)} fill="url(#dc-halo)" />
        <path d={s.hairs} stroke="#8e9f93" stroke-width="0.6" stroke-linecap="round" />
        <path d={s.beak} stroke="#8e9f93" stroke-width="0.8" stroke-linecap="round" />
        <ellipse
          cx={s.x}
          cy={s.y}
          rx={r(1.3 * s.s)}
          ry={r(3 * s.s)}
          transform={`rotate(${s.deg + 90} ${s.x} ${s.y})`}
          fill="#b8817e"
        />
      </g>
    ))
  }
</svg>
