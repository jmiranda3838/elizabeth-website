  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="dw-wall" x1="0" y1="60" x2="0" y2="610" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#f7ede5"></stop>
      <stop offset="0.5" stop-color="#f2e3d8"></stop>
      <stop offset="0.84" stop-color="#ead8cc"></stop>
      <stop offset="1" stop-color="#dccfc0"></stop>
    </linearGradient>
    <radialGradient id="dw-wash">
      <stop offset="0" stop-color="#fdf6ef" stop-opacity="0.6"></stop>
      <stop offset="1" stop-color="#fdf6ef" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="dw-stain">
      <stop offset="0" stop-color="#dcc0b0" stop-opacity="0.22"></stop>
      <stop offset="1" stop-color="#d9bcab" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="dw-sky" x1="0" y1="150" x2="0" y2="456" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#efc3b0"></stop>
      <stop offset="0.5" stop-color="#f8dcc8"></stop>
      <stop offset="1" stop-color="#fff2dc"></stop>
    </linearGradient>
    <radialGradient id="dw-sun" cx="578" cy="446" r="200" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fffdf6"></stop>
      <stop offset="0.2" stop-color="#fff6e2" stop-opacity="0.95"></stop>
      <stop offset="0.55" stop-color="#ffeccf" stop-opacity="0.5"></stop>
      <stop offset="1" stop-color="#ffe6c8" stop-opacity="0"></stop>
    </radialGradient>
    <linearGradient id="dw-soffit" x1="0" y1="150" x2="0" y2="300" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#d49d86" stop-opacity="0.6"></stop>
      <stop offset="1" stop-color="#d49d86" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="dw-reveal" x1="465" y1="0" x2="735" y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fde7cd"></stop>
      <stop offset="0.5" stop-color="#f1cfb8"></stop>
      <stop offset="1" stop-color="#cbab99"></stop>
    </linearGradient>
    <linearGradient id="dw-door" x1="652" y1="0" x2="727" y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#adbfb2"></stop>
      <stop offset="0.55" stop-color="#93a99b"></stop>
      <stop offset="1" stop-color="#788f83"></stop>
    </linearGradient>
    <linearGradient
      id="dw-door-foot"
      x1="0"
      y1="430"
      x2="0"
      y2="566"
      gradientUnits="userSpaceOnUse"
    >
      <stop offset="0" stop-color="#5f7468" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#5f7468" stop-opacity="0.36"></stop>
    </linearGradient>
    <linearGradient id="dw-spill" x1="0" y1="566" x2="0" y2="700" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff4dc" stop-opacity="0.8"></stop>
      <stop offset="0.6" stop-color="#fff1d8" stop-opacity="0.42"></stop>
      <stop offset="1" stop-color="#fff1d8" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="dw-ground" x1="0" y1="590" x2="0" y2="700" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#cfd6c2"></stop>
      <stop offset="0.5" stop-color="#dee1d0"></stop>
      <stop offset="0.86" stop-color="#eeeee6"></stop>
      <stop offset="1" stop-color="#f7f6f5"></stop>
    </linearGradient>
    <linearGradient id="dw-fade" x1="0" y1="656" x2="0" y2="700" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#f7f6f5" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#f7f6f5"></stop>
    </linearGradient>
    <linearGradient id="dw-pot" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#e2b49c"></stop>
      <stop offset="0.45" stop-color="#d49b83"></stop>
      <stop offset="1" stop-color="#b97f6a"></stop>
    </linearGradient>
    <linearGradient id="dw-tin" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#d3dcda"></stop>
      <stop offset="0.5" stop-color="#b7c5c4"></stop>
      <stop offset="1" stop-color="#97a9aa"></stop>
    </linearGradient>
    {roseLeaves.map((d, i) => <path id={`dw-rose-leaves-${i}`} d={d} />)}
    <clipPath id="dw-opening">
      <path d="M465 566 V285 A135 135 0 0 1 735 285 V566 Z"></path>
    </clipPath>

    <!-- A rose bloom, a bud, a hollyhock flower and leaf, a bistro chair: each used several times -->
    <g id="dw-rose">
      <path
        d="M0 -13 C6 -15 12 -11 12 -5 C16 -1 15 7 9 9 C8 14 0 16 -4 12 C-10 14 -15 8 -13 3 C-17 -2 -13 -10 -7 -10 C-6 -13 -3 -14 0 -13 Z"
        fill="#f8cfc8"></path>
      <path
        d="M-13 3 C-9 2 -8 -3 -7 -10 M12 -5 C8 -3 7 3 9 9 M-4 12 C-2 8 4 8 9 9"
        stroke="#dba59f"
        stroke-width="0.7"
        stroke-linecap="round"></path>
      <path
        d="M0 -8.5 C5 -9.5 9 -5 8 -1 C10.5 3 7 8 2 8 C-2 10 -8 8 -8 3 C-11 0 -9 -6 -5 -7 C-4 -9 -2 -9 0 -8.5 Z"
        fill="#efb3ac"></path>
      <path
        d="M0.5 -4.5 C3.5 -4.5 5 -2 4.5 0.5 C4 3.5 0.5 5 -2 3.5 C-4.5 2 -4.5 -2 -2.5 -3.5 C-1.5 -4.3 -0.5 -4.5 0.5 -4.5 Z"
        fill="#dd9c97"></path>
      <path
        d="M-2.6 -0.6 C-2.4 -3 1.6 -3.4 2.6 -1 C3.4 1.2 1 3 -0.6 2 C-1.8 1.2 -1 -0.6 0.4 -0.4"
        stroke="#b8817e"
        stroke-width="0.8"
        stroke-linecap="round"></path>
    </g>
    <g id="dw-bud">
      <path d="M0 0 C-3.4 -2.4 -3.6 -7.4 0 -10.5 C3.6 -7.4 3.4 -2.4 0 0 Z" fill="#eeb0aa"></path>
      <path d="M0 -10.5 C-1 -7 -0.8 -4 0 -1.5" stroke="#c98f8b" stroke-width="0.6"></path>
      <path
        d="M0 0.6 C-3 0 -4.4 -2.6 -4.2 -5 C-2.6 -4 -1.2 -2.4 0 0.6 C1.2 -2.4 2.6 -4 4.2 -5 C4.4 -2.6 3 0 0 0.6 Z"
        fill="#93a99b"></path>
    </g>
    <path
      id="dw-holly"
      d="M0 -12 C5 -13.5 10.5 -10 11 -5 C14.5 -1 13.5 6 8.5 8.5 C7 13 0 14.5 -4 11 C-9.5 12.5 -13.5 7 -12 2.5 C-15 -2 -12 -9 -6.5 -9.5 C-5.5 -12 -2.5 -12.8 0 -12 Z"
    ></path>
    <g id="dw-holly-leaf">
      <path
        d="M0 0 C6 -5 8 -13 16 -14 C19 -18 27 -17 28 -11 C33 -9 33 -1 28 1 C28 7 20 9 16 6 C10 9 4 6 0 0 Z"
        fill="#a3b5a5"></path>
      <path
        d="M1 0 C9 -2 18 -4 27 -9 M12 -2.4 C13 -6 15 -9 17 -12 M13 -2 C17 0 21 2 26 2"
        stroke="#86a091"
        stroke-width="0.6"
        stroke-linecap="round"></path>
    </g>
    <g id="dw-chair" stroke="#6d7a6f" stroke-linecap="round" stroke-linejoin="round">
      <!-- far legs first, fainter -->
      <path
        d="M-12 4 C-12 18 -12.5 30 -13 40 M12 4 C12 18 12.5 30 13 40"
        stroke-width="1.2"
        stroke-opacity="0.55"></path>
      <!-- back hoop with a small scrolled heart -->
      <path
        d="M-17 -2 C-23 -30 -25 -58 -18 -70 C-12 -80 0 -79 3 -68 C7 -54 6 -26 4 -3"
        stroke-width="1.7"></path>
      <path
        d="M-11 -6 C-16 -26 -17 -46 -12 -56 C-9 -62 -3 -61 -2 -54 C0 -44 0 -24 -1 -6"
        stroke-width="1"></path>
      <path
        d="M-7 -22 C-13 -28 -11 -38 -7 -36 C-5 -35 -6 -31 -7 -29 C-7 -33 -3 -37 -2 -33 C-1 -29 -4 -25 -7 -22 Z"
        stroke-width="0.9"></path>
      <!-- seat -->
      <ellipse cx="0" cy="0" rx="20" ry="5.6" fill="#dfe6dd" stroke-width="1.3"></ellipse>
      <path d="M-20 0.6 C-19 5.4 19 5.4 20 0.6" stroke-width="1.3"></path>
      <!-- near legs and stretcher -->
      <path d="M-17 3 C-18 18 -21 32 -24 44 M17 3 C18 18 21 32 24 44" stroke-width="1.6"></path>
      <ellipse cx="0" cy="26" rx="18.6" ry="3.6" stroke-width="0.9"></ellipse>
    </g>
  </defs>

  <!-- 1. Beyond the wall: treetops in the morning haze -->
  <g class="doorway-backdrop">
    <path d={farTrees.body} fill="#dbe3d8" fill-opacity="0.8"></path>
    <path d={farTrees.lights} fill="#e6ece2" fill-opacity="0.7"></path>
    <path d={bigTree.body} fill="#c3d0c4" fill-opacity="0.92"></path>
    <path d={bigTree.lights} fill="#d0dbcf" fill-opacity="0.8"></path>
    <path d={rightTree.body} fill="#c9d5c9" fill-opacity="0.9"></path>
    <path d={rightTree.lights} fill="#d7e1d5" fill-opacity="0.8"></path>
    <!-- Cypresses -->
    <path d="M294 262 C288 214 296 168 306 140 C316 168 326 214 320 262 Z" fill="#b9c8bc"></path>
    <path
      d="M306 146 C304 180 310 220 306 262"
      stroke="#a6b8aa"
      stroke-width="1"
      stroke-linecap="round"></path>
    <path d="M334 262 C330 226 336 194 343 176 C350 194 356 226 352 262 Z" fill="#c9d5ca"></path>
    <path d="M1150 262 C1143 206 1152 152 1163 122 C1174 152 1183 206 1176 262 Z" fill="#bccabf"
    ></path>
    <path
      d="M1163 130 C1160 170 1167 214 1163 262"
      stroke="#a9baad"
      stroke-width="1"
      stroke-linecap="round"></path>
    <path d="M-20 262 C-25 222 -18 186 -10 166 C-2 186 5 222 0 262 Z" fill="#c6d2c7"></path>
  </g>

  <!-- 2. The wall: lime plaster, a tiled coping, a raised gable over the door -->
  <g class="doorway-wall">
    <path
      d={`${WALL_TOP_L} ${GABLE} ${WALL_TOP_R.replace("M828 251", "")} V700 H-400 Z`}
      fill="url(#dw-wall)"></path>
    <!-- Uneven limewash, and weather stains -->
    <g fill="url(#dw-wash)">
      <ellipse cx="-200" cy="400" rx="190" ry="90"></ellipse>
      <ellipse cx="150" cy="380" rx="150" ry="80"></ellipse>
      <ellipse cx="600" cy="92" rx="150" ry="34"></ellipse>
      <ellipse cx="1010" cy="420" rx="170" ry="90"></ellipse>
      <ellipse cx="1400" cy="380" rx="200" ry="90"></ellipse>
      <ellipse cx="400" cy="250" rx="40" ry="60"></ellipse>
    </g>
    <g fill="url(#dw-stain)">
      <ellipse cx="-60" cy="300" rx="120" ry="44"></ellipse>
      <ellipse cx="260" cy="500" rx="110" ry="60"></ellipse>
      <ellipse cx="930" cy="296" rx="100" ry="40"></ellipse>
      <ellipse cx="1240" cy="480" rx="160" ry="70"></ellipse>
      <ellipse cx="1500" cy="300" rx="110" ry="40"></ellipse>
      <ellipse cx="800" cy="230" rx="30" ry="40"></ellipse>
    </g>
    <!-- Where plaster has let go: old brick showing through -->
    <g>
      <path
        d="M118 342 C124 332 140 330 152 334 C166 328 186 330 196 338 C206 344 204 358 196 364 C190 374 172 378 158 374 C144 378 128 374 122 364 C114 356 113 348 118 342 Z"
        fill="#e2cabb"></path>
      <g fill="#dbb6a3">
        <path d="M128 340 h20 v8 h-20 Z M152 339 h22 v8 h-22 Z M178 341 h16 v8 h-16 Z"></path>
        <path
          d="M122 351 h14 v8 h-14 Z M140 351 h22 v8 h-22 Z M166 351 h24 v8 h-24 Z"
          fill="#d3aa97"></path>
        <path d="M134 362 h20 v7 h-20 Z M158 362 h22 v7 h-22 Z" fill="#dfbfae"></path>
      </g>
      <path
        d="M118 342 C124 332 140 330 152 334 C166 328 186 330 196 338"
        stroke="#fbf3ec"
        stroke-width="1.4"
        stroke-linecap="round"></path>
      <path
        d="M1096 356 C1104 346 1120 346 1130 350 C1144 344 1162 348 1168 356 C1174 364 1170 376 1160 380 C1150 388 1132 388 1122 384 C1110 386 1098 380 1094 370 C1090 364 1092 360 1096 356 Z"
        fill="#e2cabb"></path>
      <g fill="#dbb6a3">
        <path d="M1104 354 h20 v8 h-20 Z M1128 353 h22 v8 h-22 Z"></path>
        <path
          d="M1098 365 h16 v8 h-16 Z M1118 365 h22 v8 h-22 Z M1144 365 h20 v8 h-20 Z"
          fill="#d3aa97"></path>
        <path d="M1112 376 h20 v6 h-20 Z M1136 376 h18 v6 h-18 Z" fill="#dfbfae"></path>
      </g>
      <path
        d="M1096 356 C1104 346 1120 346 1130 350 C1144 344 1162 348 1168 356"
        stroke="#fbf3ec"
        stroke-width="1.4"
        stroke-linecap="round"></path>
    </g>
    <!-- Hairline cracks and trowel marks -->
    <g stroke="#d2b9aa" stroke-width="0.8" stroke-linecap="round" stroke-opacity="0.85">
      <path d="M96 262 C100 284 92 300 98 322 C102 336 96 346 100 356"></path>
      <path d="M98 322 C106 328 112 330 118 340"></path>
      <path d="M1328 262 C1324 284 1332 304 1326 330 C1322 344 1330 352 1326 364"></path>
      <path d="M-280 262 C-276 280 -284 292 -280 310"></path>
      <path d="M560 70 C562 82 556 90 560 100"></path>
      <path d="M150 520 C190 516 230 520 270 516" stroke-dasharray="34 10 16 12"></path>
      <path d="M900 500 C960 496 1040 500 1110 496" stroke-dasharray="50 12 22 10"></path>
      <path d="M-360 440 C-300 436 -230 440 -170 437" stroke-dasharray="40 12 26 9"></path>
      <path d="M-120 330 C-80 327 -40 330 0 328" stroke-dasharray="26 9"></path>
      <path d="M1210 330 C1260 326 1320 330 1370 328" stroke-dasharray="40 10 18 8"></path>
      <path d="M1420 470 C1470 466 1530 470 1590 467" stroke-dasharray="30 10 50 12"></path>
      <path d="M390 228 C400 226 410 228 420 227 M780 232 C792 230 804 232 816 231"></path>
      {/* the stretch of wall a phone shows */}
      <path d="M334 262 C337 280 331 292 335 310 C338 322 333 330 336 342"></path>
      <path d="M335 310 C342 314 347 318 350 326"></path>
      <path d="M312 452 C330 449 350 452 368 450" stroke-dasharray="20 8 12 7"></path>
      <path d="M318 388 C330 386 342 388 352 387" stroke-dasharray="14 7"></path>
      <path d="M842 520 C858 518 876 520 894 518" stroke-dasharray="18 7 10 6"></path>
      <path d="M852 276 C866 274 880 276 892 275" stroke-dasharray="16 8"></path>
      <path d="M884 262 C881 276 887 286 884 298"></path>
    </g>
    <!-- Damp and moss where the wall meets the beds -->
    <path
      d="M-400 562 C-240 550 -100 566 60 556 C180 548 280 564 372 554 L433 560 V600 H-400 Z M767 560 L828 556 C950 566 1080 548 1200 558 C1340 566 1480 550 1600 560 V600 H767 Z"
      fill="#c6cfbd"
      fill-opacity="0.3"></path>

    <!-- Clay-tile coping along the low wall -->
    <g stroke-linecap="round">
      <path d={WALL_TOP_L} stroke="#d5a48d" stroke-width="12" stroke-dasharray="13 3.5"></path>
      <path d={WALL_TOP_R} stroke="#d5a48d" stroke-width="12" stroke-dasharray="13 3.5"></path>
      <g transform="translate(0 -3.4)">
        <path d={WALL_TOP_L} stroke="#eccbb9" stroke-width="3" stroke-dasharray="13 3.5"></path>
        <path d={WALL_TOP_R} stroke="#eccbb9" stroke-width="3" stroke-dasharray="13 3.5"></path>
      </g>
      <g transform="translate(0 8.6)" stroke="#d8bdad" stroke-width="2.6" stroke-opacity="0.8">
        <path d={WALL_TOP_L}></path>
        <path d={WALL_TOP_R}></path>
      </g>
    </g>
    <!-- Plaster moulding on the gable -->
    <path d={`M372 251 ${GABLE}`} stroke="#e6cfc1" stroke-width="5" stroke-linejoin="round"></path>
    <path d={`M372 251 ${GABLE}`} stroke="#c9a999" stroke-width="1.1" stroke-linejoin="round"
    ></path>
    <path
      d="M381 246 V214 C381 202 392 198 406 194 C432 186 438 164 442 146 C450 112 504 76 600 72 C696 76 750 112 758 146 C762 164 768 186 794 194 C808 198 819 202 819 214 V246"
      stroke="#dcc3b4"
      stroke-width="0.9"
      stroke-linejoin="round"></path>
  </g>

  <!-- 3. Bougainvillea coming over the top of the wall, right -->
  <g class="doorway-bougainvillea">
    <path d={bougMound.body} fill="#a3b5a5"></path>
    <path d={bougMound.lights} fill="#b9c8bb"></path>
    <path
      d={bougCanes.map((c) => c.d).join("")}
      stroke="#8c9a86"
      stroke-width="1.3"
      stroke-linecap="round"></path>
    <path d={boug.stalks} stroke="#8fa391" stroke-width="0.8" stroke-linecap="round"></path>
    {byTone(boug.leaves, ROSE_LEAF, 4).map((d, i) => <path d={d} fill={LEAF_TONES[i]} />)}
    {byTone(bracts, PETAL, 3).map((d, i) => <path d={d} fill={BRACT_TONES[i]} />)}
  </g>

  <!-- 4. Through the door: a sunlit garden, the path going on -->
  <g class="doorway-beyond" clip-path="url(#dw-opening)">
    <rect x="460" y="145" width="280" height="425" fill="url(#dw-sky)"></rect>
    <path
      d="M465 458 C492 442 520 440 548 450 C580 438 640 432 690 440 C710 442 726 448 735 452 V480 H465 Z"
      fill="#f1cfc0"></path>
    <path d="M465 566 V470 C520 462 680 462 735 470 V566 Z" fill="#eaeeda"></path>
    <path
      d="M465 486 V462 C470 448 486 442 498 450 C508 438 528 442 532 456 C544 454 554 462 556 472 C562 476 566 480 568 484 C540 480 500 482 465 486 Z"
      fill="#c9d6c5"></path>
    <path d="M486 470 C481 430 487 396 494 378 C501 396 507 430 502 470 Z" fill="#bccbbd"></path>
    <path
      d="M604 484 C612 478 622 474 632 472 C636 458 654 450 668 458 C680 446 704 452 706 466 C722 464 735 472 735 488 C700 482 650 480 604 484 Z"
      fill="#c9d6c5"></path>
    <path d="M498 566 C534 524 562 492 574 470 L594 470 C612 494 660 534 704 566 Z" fill="#fff7e6"
    ></path>
    <path
      d="M520 548 C540 546 560 548 580 546 M548 520 C562 518 580 520 596 518 M566 496 C576 495 588 496 598 495"
      stroke="#e9d5bd"
      stroke-width="1"
      stroke-linecap="round"></path>
    <g class="doorway-sun">
      <circle cx="578" cy="446" r="200" fill="url(#dw-sun)"></circle>
      <!-- rays, like the practice's rising-sun mark -->
      <path
        d="M578 404 V372 M556 410 L542 384 M600 410 L614 384 M540 424 L514 408 M616 424 L642 408 M532 444 L500 440 M624 444 L656 440"
        stroke="#fffaf0"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-opacity="0.75"></path>
      <circle cx="578" cy="446" r="22" fill="#fffdf6"></circle>
    </g>
    <rect x="460" y="145" width="280" height="160" fill="url(#dw-soffit)"></rect>
  </g>

  <!-- 5. The door, swung inward on its strap hinges -->
  <g class="doorway-door" clip-path="url(#dw-opening)">
    <g class="doorway-leaf">
      <path
        d="M727 566 V285 C727 226 712 172 688 165 C667 172 654 242 652 300 V553 Z"
        fill="url(#dw-door)"></path>
      <path
        d="M727 566 V285 C727 226 712 172 688 165 C667 172 654 242 652 300 V553 Z"
        fill="url(#dw-door-foot)"></path>
      <g stroke="#6c8276" stroke-width="0.9" stroke-opacity="0.7" stroke-linecap="round">
        <path d="M708 562.6 V208"></path>
        <path d="M689.5 559.4 V167"></path>
        <path d="M671 556.2 V200"></path>
      </g>
      <g stroke="#c6d3c8" stroke-width="0.7" stroke-opacity="0.75" stroke-linecap="round">
        <path d="M706.6 560 V214"></path>
        <path d="M688 557 V172"></path>
        <path d="M669.6 554 V206"></path>
      </g>
      <!-- A grille window, lit from behind -->
      <path
        d="M677 270 V246 C677 235 683 228 689 227 C696 229 702 237 702 248 V272 Z"
        fill="#ffeecd"></path>
      <path
        d="M677 270 V246 C677 235 683 228 689 227 C696 229 702 237 702 248 V272 Z M683.5 270.6 V233 M689.5 271 V227.5 M695.5 271.5 V231 M677 251 L702 252.6"
        stroke="#5d6a5f"
        stroke-width="1.1"
        stroke-linejoin="round"></path>
      <!-- Strap hinges, ring pull, studs -->
      <g fill="#5d6a5f">
        <path
          d="M727 335 L684 342.5 C680 341 675 343.5 673 347.5 C675 351.5 680 354 684 352.5 L727 346 Z"
        ></path>
        <path
          d="M727 504 L684 501 C680 499.5 675 502 673 505.5 C675 509.5 680 511.5 684 510 L727 515 Z"
        ></path>
        <ellipse cx="662" cy="432" rx="2.6" ry="4.4"></ellipse>
      </g>
      <ellipse cx="662" cy="440" rx="3.6" ry="6.4" stroke="#5d6a5f" stroke-width="1.3"></ellipse>
      <path
        d="M718 341.4 h0.1 M704 343.8 h0.1 M690 346.2 h0.1 M718 509 h0.1 M704 507.6 h0.1 M690 506.4 h0.1"
        stroke="#aebdb1"
        stroke-width="1.6"
        stroke-linecap="round"></path>
      <!-- The door's edge and top, catching the light -->
      <path
        d="M652 553 L646 550.8 V304 C648 246 661 176 685 166.4 L688 165 C667 172 654 242 652 300 Z"
        fill="#fff2d8"></path>
    </g>
  </g>

  <!-- The splayed reveal: lit on the left, in the door's shade on the right -->
  <path
    class="doorway-reveal"
    d="M465 566 V285 A135 135 0 0 1 735 285 V566"
    stroke="url(#dw-reveal)"
    stroke-width="15"
    clip-path="url(#dw-opening)"></path>

  <!-- 6. Dressed-stone surround: voussoirs, keystone, long-and-short jambs -->
  <path
    d="M424 566 V285 A176 176 0 0 1 776 285 V566 H735 V285 A135 135 0 0 0 465 285 V566 Z"
    fill="#c9a593"
