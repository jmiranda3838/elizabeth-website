const R_IN = 135;
const R_OUT = 167;
const STONE_TONES = ["#eaddd0", "#e4d5c7", "#ece1d5", "#e7d8ca", "#dfcfc0"];
const onArc = (deg: number, r: number): Pt => [
  CX + r * Math.cos(rad(deg)),
  SPRING - r * Math.sin(rad(deg)),
];
// Voussoirs: six each side of the keystone, none quite the same width
const bounds = [180, 166.5, 152, 138.5, 124, 110.5, 98, 82, 69.5, 56, 41.5, 28, 13.5, 0];
const voussoirs = bounds.slice(0, -1).flatMap((a0, i) => {
  if (i === 6) return [];
  const a1 = bounds[i + 1];
  const ro = R_OUT + jit(-2, 2.5);
  const [x0, y0] = onArc(a0, R_IN);
  const [x1, y1] = onArc(a1, R_IN);
  const [x2, y2] = onArc(a1, ro);
  const [x3, y3] = onArc(a0, ro);
  return [
    {
      d: `M${f(x0)} ${f(y0)} A${R_IN} ${R_IN} 0 0 1 ${f(x1)} ${f(y1)} L${f(x2)} ${f(y2)} A${f(ro)} ${f(ro)} 0 0 0 ${f(x3)} ${f(y3)} Z`,
