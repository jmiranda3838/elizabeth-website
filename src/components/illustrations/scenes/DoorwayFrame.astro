  [1520, 618, 12, 50],
  [-110, 614, 10, 44],
].flatMap(([bx, by, n, h]) =>
  Array.from({ length: n }, (_, i) => {
    const lean = -38 + (76 * (i + jit(0.2, 0.8))) / n;
    const len = h * jit(0.72, 1.08);
    const tx = bx + Math.sin(rad(lean)) * len;
    const ty = by - Math.cos(rad(lean)) * len;
    const mx = bx + Math.sin(rad(lean * 0.45)) * len * 0.55;
    const my = by - Math.cos(rad(lean * 0.45)) * len * 0.55;
    const k = jit(0.6, 0.72);
    return {
      stem: `M${f(bx + jit(-4, 4))} ${f(by)}Q${f(mx)} ${f(my)} ${f(tx)} ${f(ty)}`,
      spike: `M${f(mx + (tx - mx) * k)} ${f(my + (ty - my) * k)}L${f(tx)} ${f(ty)}`,
      tone: i % 3,
    };
  }),
);
const LAV_TONES = ["#8d9da5", "#a3aab8", "#7d9094"];

/* ---- Hollyhocks against the wall: [base x, base y, height, lean, petal, eye] */
const hollyhocks = (
  [
    [196, 608, 252, -5, "#f3bdb5", "#d28a84"],
    [234, 610, 204, 3, "#fbe1db", "#e3a29b"],
    [266, 608, 166, 8, "#e9aca5", "#c47b74"],
  ] as [number, number, number, number, string, string][]
).map(([bx, by, h, lean, petal, eye]) => {
  const tip: Pt = [bx + lean * 3, by - h];
  const ctl: Pt = [bx - lean * 1.5, by - h / 2];
  const at = (t: number): Pt => [
    (1 - t) * (1 - t) * bx + 2 * (1 - t) * t * ctl[0] + t * t * tip[0],
    (1 - t) * (1 - t) * by + 2 * (1 - t) * t * ctl[1] + t * t * tip[1],
  ];
  const n = Math.round(h / 23);
  const flowers = Array.from({ length: n }, (_, i) => {
    const t = 0.36 + (0.55 * i) / (n - 1);
    const [x, y] = at(t);
    const side = i % 2 ? 1 : -1;
    const r = 11 - 6.5 * (i / (n - 1));
    return { x: f(x + side * (r * 0.62)), y: f(y + jit(-2, 2)), s: f(r / 12), a: f(jit(0, 72)) };
  });
  const budDots = [0.93, 0.965, 1].map((t, i) => {
    const [x, y] = at(t);
    return { x: f(x + (i % 2 ? 2 : -2)), y: f(y), r: f(3.2 - i * 0.7) };
  });
  const leaves = [0.05, 0.13, 0.2, 0.28].map((t, i) => {
    const [x, y] = at(t);
    const side = i % 2 ? 1 : -1;
    return { x: f(x), y: f(y), s: f(1.25 - i * 0.2), a: side > 0 ? jit(-25, 5) : jit(175, 205) };
  });
  return {
    stalk: `M${bx} ${by}Q${f(ctl[0])} ${f(ctl[1])} ${f(tip[0])} ${f(tip[1])}`,
    flowers,
    budDots,
    leaves,
    petal,
    eye,
  };
});

/* ---- Flagstones: three rows widening toward the viewer ------------------- */
const rows = [
  { y0: 623, y1: 644, x0: 402, x1: 798, n: 5 },
  { y0: 648, y1: 672, x0: 376, x1: 824, n: 4 },
  { y0: 677, y1: 706, x0: 346, x1: 854, n: 4 },
];
const flags = rows.flatMap((r, ri) => {
  const cuts = Array.from({ length: r.n + 1 }, (_, i) =>
    i === 0 || i === r.n
      ? r.x0 + ((r.x1 - r.x0) * i) / r.n
      : r.x0 + ((r.x1 - r.x0) * (i + jit(-0.22, 0.22))) / r.n,
  );
  return cuts.slice(0, -1).map((a, i) => {
    const b = cuts[i + 1] - 6;
    const sk = (r.y1 - r.y0) * 0.35;
    const lean = ((a + b) / 2 - CX) / 60;
    const pts: Pt[] = [
      [a + jit(0, 3), r.y0 + jit(0, 3)],
      [(a + b) / 2 + jit(-8, 8), r.y0 + jit(-1.5, 1.5)],
      [b - jit(0, 3), r.y0 + jit(0, 3)],
      [b + lean * 0.4 * sk + jit(0, 2), r.y1 - jit(0, 3)],
      [(a + b) / 2 + lean * 0.3 * sk + jit(-8, 8), r.y1 + jit(-1.5, 1.5)],
      [a + lean * 0.4 * sk - jit(0, 2), r.y1 - jit(0, 3)],
    ];
    return {
      d: "M" + pts.map((p) => `${f(p[0])} ${f(p[1])}`).join("L") + "Z",
      lit: Math.abs((a + b) / 2 - 560) < 110 - ri * 12,
    };
  });
});

