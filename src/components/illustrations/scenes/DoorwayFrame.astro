---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

/* The doorway scene: a garden door standing ajar in a plastered courtyard wall,
   morning light spilling out over the steps.

   The drawing is 2000 x 700, but its x axis runs from -400 to 1600 so the door
   keeps round numbers: the opening is x 465-735, centred on 600. The middle
   600 units (x 300-900) are the part a phone shows; everything outside is the
   wider courtyard that desktop screens reveal.

   Stonework, door, lanterns and furniture are drawn by hand in the markup.
   Foliage is grown here from a fixed seed, so it is irregular but identical on
   every build, and is stamped into a handful of paths to keep the DOM small.
   DoorwayLight.astro is the matching overlay (lantern glow, drifting petals). */

type Pt = [number, number];
interface Leaf {
  x: number;
  y: number;
  a: number;
  s: number;
  tone: number;
}

let seed = 41;
const rnd = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};
const jit = (a: number, b: number) => a + (b - a) * rnd();
const f = (n: number) => Math.round(n * 10) / 10;
const rad = (deg: number) => (deg * Math.PI) / 180;

/** Stamp a closed shape (M p0, then cubic triplets) at a leaf's position, as path data */
function stamp(shape: Pt[], l: Leaf): string {
  const c = Math.cos(rad(l.a)) * l.s;
  const s = Math.sin(rad(l.a)) * l.s;
  const p = shape.map(([x, y]): Pt => [l.x + x * c - y * s, l.y + x * s + y * c]);
  // relative curves: the numbers stay short, which matters with hundreds of leaves
  let d = `M${f(p[0][0])} ${f(p[0][1])}`;
  for (let i = 1; i < p.length; i += 3) {
    const [ox, oy] = p[i - 1];
    d += "c" + [p[i], p[i + 1], p[i + 2]].map(([x, y]) => `${f(x - ox)} ${f(y - oy)}`).join(" ");
  }
  return d + "Z";
}
/** A leaf's midrib, as one short line */
function rib(l: Leaf): string {
  const c = Math.cos(rad(l.a)) * l.s;
  const s = Math.sin(rad(l.a)) * l.s;
  return `M${f(l.x + 0.6 * c)} ${f(l.y + 0.6 * s)}l${f(11.4 * c)} ${f(11.4 * s)}`;
}
/** A small rotated oval: one leaf-sized dab of foliage (wound the same way as the crown lobes) */
function dab(l: Leaf): string {
  const dx = Math.cos(rad(l.a)) * 6.2 * l.s;
  const dy = Math.sin(rad(l.a)) * 6.2 * l.s;
  const arc = `a${f(6.2 * l.s)} ${f(3.9 * l.s)} ${Math.round(l.a)} 1 1 `;
  return `M${f(l.x - dx)} ${f(l.y - dy)}${arc}${f(2 * dx)} ${f(2 * dy)}${arc}${f(-2 * dx)} ${f(-2 * dy)}Z`;
}
const byTone = (leaves: Leaf[], shape: Pt[], tones: number) =>
  Array.from({ length: tones }, (_, t) =>
    leaves
      .filter((l) => l.tone === t)
      .map((l) => stamp(shape, l))
      .join(""),
  );

// Leaf shapes, drawn pointing along +x from their stalk end
const ROSE_LEAF: Pt[] = [
  [0, 0],
  [2.6, -4],
  [8.2, -4.8],
  [13, -0.5],
  [9.2, 3.7],
  [3.4, 3.9],
  [0, 0],
];
const OLIVE_LEAF: Pt[] = [
  [0, 0],
  [3, -2.1],
  [8, -2.1],
  [11.5, 0],
  [8, 1.7],
  [3, 1.9],
  [0, 0],
];
const PETAL: Pt[] = [
  [0, 0],
  [-3.4, -2.6],
  [-3, -6.8],
  [0.6, -8.2],
  [3.6, -5.6],
  [3, -2],
  [0, 0],
];

/** A smooth stem through hand-placed points, plus a sampler (position + heading) */
function cane(pts: Pt[]) {
  const seg = (i: number): Pt[] => {
    const p0 = pts[Math.max(i - 1, 0)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(i + 2, pts.length - 1)];
    return [
      p1,
      [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6],
      [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6],
      p2,
    ];
  };
  let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const [, c1, c2, p] = seg(i);
    d += `C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p[0])} ${f(p[1])}`;
  }
  const at = (u: number) => {
    const x = Math.min(Math.max(u, 0), 0.9999) * (pts.length - 1);
    const i = Math.floor(x);
    const t = x - i;
    const m = 1 - t;
    const [a, b, c, e] = seg(i);
    const pos = (k: 0 | 1) =>
      m * m * m * a[k] + 3 * m * m * t * b[k] + 3 * m * t * t * c[k] + t * t * t * e[k];
    const der = (k: 0 | 1) =>
      3 * m * m * (b[k] - a[k]) + 6 * m * t * (c[k] - b[k]) + 3 * t * t * (e[k] - c[k]);
    return { x: pos(0), y: pos(1), ang: (Math.atan2(der(1), der(0)) * 180) / Math.PI };
  };
  return { d, at };
}
type Cane = ReturnType<typeof cane>;

/** Leaf sprays (a terminal leaflet and one or two pairs) alternating along a stem */
function sprays(c: Cane, n: number, size = 1, from = 0, to = 1) {
  const leaves: Leaf[] = [];
  let stalks = "";
  for (let i = 0; i < n; i++) {
    const u = from + ((i + jit(0.15, 0.85)) / n) * (to - from);
    const p = c.at(u);
    const side = i % 2 ? 1 : -1;
    const dir = p.ang + side * jit(46, 84);
    const len = jit(10, 18) * size;
    const tx = p.x + Math.cos(rad(dir)) * len;
    const ty = p.y + Math.sin(rad(dir)) * len;
    const s = jit(0.8, 1.2) * size;
    const tone = Math.floor(jit(0, 4));
    leaves.push({ x: tx, y: ty, a: dir + jit(-14, 14), s, tone });
    const pairs = rnd() < 0.5 ? 2 : 1;
    for (let k = 1; k <= pairs; k++) {
      const q = 1 - k * 0.4;
      const bx = p.x + Math.cos(rad(dir)) * len * q;
      const by = p.y + Math.sin(rad(dir)) * len * q;
      for (const sd of [-1, 1]) {
        leaves.push({ x: bx, y: by, a: dir + sd * jit(40, 66), s: s * jit(0.68, 0.9), tone });
      }
    }
    stalks += `M${f(p.x)} ${f(p.y)}L${f(tx)} ${f(ty)}`;
  }
  return { leaves, stalks };
}
const merge = (...parts: ReturnType<typeof sprays>[]) => ({
  leaves: parts.flatMap((p) => p.leaves),
  stalks: parts.map((p) => p.stalks).join(""),
});
const LEAF_TONES = ["#b9c8bb", "#9db1a4", "#86a091", "#a9ad9b"];

/** A tree or shrub crown: soft lobes, with leaf dabs feathering the silhouette */
function crown(lobes: number[][], dabsPerLobe = 16) {
  let body = "";
  const edge: Leaf[] = [];
  const lights: Leaf[] = [];
  for (const [cx, cy, rx, ry] of lobes) {
    body += `M${cx - rx} ${cy}A${rx} ${ry} 0 1 1 ${cx + rx} ${cy}A${rx} ${ry} 0 1 1 ${cx - rx} ${cy}Z`;
    for (let i = 0; i < dabsPerLobe; i++) {
      const th = jit(175, 365);
      const k = jit(0.9, 1.08);
      edge.push({
        x: cx + Math.cos(rad(th)) * rx * k,
        y: cy + Math.sin(rad(th)) * ry * k,
        a: th + 90 + jit(-40, 40),
        s: jit(0.7, 1.3),
        tone: 0,
      });
    }
    for (let i = 0; i < dabsPerLobe / 3; i++) {
      const th = jit(200, 320);
      const k = jit(0.25, 0.8);
      lights.push({
        x: cx + Math.cos(rad(th)) * rx * k,
        y: cy + Math.sin(rad(th)) * ry * k,
        a: jit(-50, 50),
        s: jit(0.6, 1),
        tone: 0,
      });
    }
  }
  return {
    body: body + edge.map(dab).join(""),
    lights: lights.map(dab).join(""),
  };
}

