---
interface Props {
  class?: string;
  style?: string;
  /** Crop to the ground line + root system only (no flower above ground) */
  rootsOnly?: boolean;
  [key: string]: unknown;
}
const { class: className = "", style = "", rootsOnly = false, ...rest } = Astro.props;

/* ---------------------------------------------------------------------------
   Roots are drawn as TAPERED FILLED shapes, computed here from centrelines:
   thick where they leave the surface, hair-thin at the tips. Each root is a
   chain of cubic Béziers (3n+1 points) with a start and end width.

   The scroll animation in index.astro dash-draws every `.roots-below path`.
   A filled shape cannot be dash-drawn, so the tapered roots sit in
   `.roots-flesh`, masked by `#roots-reveal`, whose wide white strokes follow
   the same centrelines and live inside `.roots-below`: as GSAP draws those
   strokes, the mask uncovers each root from the surface down. Fine root hairs
   are ordinary strokes in `.roots-below`, drawn directly. With no JS, or with
   reduced motion, the mask strokes are whole and every root shows.
   --------------------------------------------------------------------------- */
type Pt = [number, number];
interface Root {
  p: Pt[];
  w: [number, number];
  /** Branch: start on root [index] at this fraction of its length */
  from?: [number, number];
}

// Ordered surface-first, so the stagger grows the big roots before their branches.
const roots: Root[] = [
  // Taproot, wandering a little left as it dives
  {
    p: [
      [150, 181],
      [149, 205],
      [156, 228],
      [152, 252],
