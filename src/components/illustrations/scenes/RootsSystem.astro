const f1 = (n: number) => n.toFixed(1);

function bez(a: Pt, b: Pt, c: Pt, d: Pt, t: number): Pt {
  const m = 1 - t;
  return [
    m * m * m * a[0] + 3 * m * m * t * b[0] + 3 * m * t * t * c[0] + t * t * t * d[0],
    m * m * m * a[1] + 3 * m * m * t * b[1] + 3 * m * t * t * c[1] + t * t * t * d[1],
  ];
}

// Sample a chain of cubics into points, then let the younger part of the root
// wander a little (real roots never run as clean curves). The phase differs
// per root so no two wander alike.
function sample(p: Pt[], idx: number, perSeg = 22): Pt[] {
  const raw: Pt[] = [];
  for (let i = 0; i + 3 < p.length; i += 3) {
    for (let s = i === 0 ? 0 : 1; s <= perSeg; s++) {
      raw.push(bez(p[i], p[i + 1], p[i + 2], p[i + 3], s / perSeg));
    }
  }
  const lens = [0];
  for (let i = 1; i < raw.length; i++) {
    lens.push(lens[i - 1] + Math.hypot(raw[i][0] - raw[i - 1][0], raw[i][1] - raw[i - 1][1]));
  }
  const total = lens[lens.length - 1] || 1;
  return raw.map((pt, i) => {
    const a = raw[Math.max(0, i - 1)];
    const b = raw[Math.min(raw.length - 1, i + 1)];
    const tl = Math.hypot(b[0] - a[0], b[1] - a[1]) || 1;
    const nx = -(b[1] - a[1]) / tl;
    const ny = (b[0] - a[0]) / tl;
    const f = Math.pow(lens[i] / total, 1.2);
    const off =
      f * (1.5 * Math.sin(lens[i] / 7 + idx * 1.9) + 0.45 * Math.sin(lens[i] / 2.7 + idx * 4.3));
    return [pt[0] + nx * off, pt[1] + ny * off] as Pt;
  });
}

function centreline(p: Pt[]): string {
  let d = `M${p[0][0]} ${p[0][1]}`;
  for (let i = 1; i + 2 < p.length; i += 3) {
    d += ` C${p[i][0]} ${p[i][1]} ${p[i + 1][0]} ${p[i + 1][1]} ${p[i + 2][0]} ${p[i + 2][1]}`;
  }
  return d;
}

// Outline of a root whose width eases from w0 to w1 along its length.
// `shade` > 0 instead returns a narrow strip along the root's lower-right
// flank (the side away from the light), for a sense of roundness.
function taper(p: Pt[], idx: number, w0: number, w1: number, shade = 0): string {
  const pts = sample(p, idx);
  const lens = [0];
  for (let i = 1; i < pts.length; i++) {
    lens.push(lens[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
  }
  const total = lens[lens.length - 1];
  // One shadow side per root, from its overall direction
  const first = pts[0];
  const last = pts[pts.length - 1];
  const side = last[0] - first[0] - (last[1] - first[1]) >= 0 ? 1 : -1;
  const left: Pt[] = [];
  const right: Pt[] = [];
  pts.forEach((pt, i) => {
    const a = pts[Math.max(0, i - 1)];
    const b = pts[Math.min(pts.length - 1, i + 1)];
    const tx = b[0] - a[0];
    const ty = b[1] - a[1];
    const tl = Math.hypot(tx, ty) || 1;
    const nx = -ty / tl;
    const ny = tx / tl;
    // Thick at the crown, thinning quickly: roots taper fast
    const f = lens[i] / total;
    let hw = (w1 + (w0 - w1) * Math.pow(1 - f, 1.6)) / 2;
    let cx = pt[0];
    let cy = pt[1];
    if (shade) {
      const shift = hw * (1 - shade) * side;
      cx += nx * shift;
      cy += ny * shift;
      hw *= shade;
    }
    left.push([cx + nx * hw, cy + ny * hw]);
    right.push([cx - nx * hw, cy - ny * hw]);
  });
  const ring = left.concat(right.reverse());
  return "M" + ring.map((q) => `${f1(q[0])} ${f1(q[1])}`).join(" L") + " Z";
}

// Deterministic scatter for root hairs (same drawing on every build)
let seed = 7;
const rand = () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

// Fine root hairs: short, slightly curved strokes off each root, denser and
// longer toward the tips (where real roots carry their hairs).
function hairs(p: Pt[], idx: number, w0: number): string {
  const pts = sample(p, idx, 16);
  let d = "";
  // Hairs only on the younger, outer part of each root, sparse and irregular
  let i = Math.floor(pts.length * (w0 > 2.6 ? 0.5 : 0.35));
  while (i < pts.length - 1) {
    const [x, y] = pts[i];
    const [x2, y2] = pts[i + 1];
    const tx = x2 - x;
    const ty = y2 - y;
    const tl = Math.hypot(tx, ty) || 1;
    const ux = tx / tl;
    const uy = ty / tl;
    const count = rand() > 0.7 ? 2 : 1;
    for (let k = 0; k < count; k++) {
      const side = rand() > 0.5 ? 1 : -1;
      const ang = (0.5 + rand() * 0.7) * side;
      const len = 1.4 + rand() * 3.2 * (0.5 + i / pts.length);
      const hx = ux * Math.cos(ang) - uy * Math.sin(ang);
      const hy = ux * Math.sin(ang) + uy * Math.cos(ang);
      const ex = x + hx * len;
      const ey = y + hy * len;
      const cx = x + hx * len * 0.55 + ux * len * 0.3;
      const cy = y + hy * len * 0.55 + uy * len * 0.3;
      d += `M${f1(x)} ${f1(y)} Q${f1(cx)} ${f1(cy)} ${f1(ex)} ${f1(ey)} `;
    }
    i += 3 + Math.floor(rand() * 5);
  }
  return d.trim();
}

// Seat each branch exactly on its parent as drawn (after the parent's wander)
roots.forEach((r) => {
  if (!r.from) return;
  const [pi, t] = r.from;
  const pts = sample(roots[pi].p, pi);
  const q = pts[Math.round(t * (pts.length - 1))];
  const dx = q[0] - r.p[0][0];
  const dy = q[1] - r.p[0][1];
  r.p[0] = [+q[0].toFixed(1), +q[1].toFixed(1)];
  r.p[1] = [+(r.p[1][0] + dx * 0.6).toFixed(1), +(r.p[1][1] + dy * 0.6).toFixed(1)];
});

const shapes = roots.map((r, i) => ({
  body: taper(r.p, i, r.w[0], r.w[1]),
  shade: taper(r.p, i, r.w[0], r.w[1], 0.42),
  start: r.from ? r.p[0] : null,
  r0: r.w[0] / 2,
  line: centreline(r.p),
  reveal: r.w[0] + 4,
}));

// Group the hairs into a few strokes so the scroll stagger stays short
const hairGroups = ["", "", "", ""];
roots.forEach((r, i) => {
  hairGroups[i % 4] += " " + hairs(r.p, i, r.w[0]);
});

// Where each main root ends: a tiny root cap that blooms in last
const tips: Pt[] = roots.slice(0, 7).map((r) => r.p[r.p.length - 1]);
