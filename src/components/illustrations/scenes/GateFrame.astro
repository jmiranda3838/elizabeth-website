---
// Static gate structure: timber posts with caps and finials, the arbor arch,
// iron hinge knuckles, and a climbing rose. Shares the 0 0 800 400 viewBox with
// GateDoorLeft/GateDoorRight so the layers stack pixel-perfectly when absolutely
// positioned over each other. Line and timber are currentColor (garden-gate.css
// sets it); the rose, leaves and canes take palette colours from the
// .gate-rose-* / .gate-leaf / .gate-vine classes there.
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

type Leaf = [number, number, number, number?];
// [x, y, rotation, scale]: leaves along the canes, never in matched pairs
const leavesLeft: Leaf[] = [
  [46, 384, -100, 1.1],
  [52, 366, -20, 0.9],
  [74, 340, -150],
  [86, 312, 10, 0.85],
  [60, 262, 200, 1.05],
  [44, 232, -140, 0.9],
  [50, 196, -30],
  [80, 172, 20, 0.8],
  [86, 150, -60, 0.95],
  [60, 104, 160, 0.9],
  [104, 70, -30, 1.1],
  [136, 56, 160, 0.9],
  [150, 50, -40, 0.8],
  [190, 40, 150, 0.85],
  [232, 34, -20, 0.75],
  [252, 26, 170, 0.7],
];
const leavesRight: Leaf[] = [
  [754, 386, -80, 1],
  [748, 356, 200, 0.85],
  [718, 300, -160, 1],
  [744, 250, -10, 0.9],
  [754, 210, 30, 0.8],
  [724, 150, 190, 0.95],
  [740, 96, -20, 0.85],
  [700, 56, 200, 0.9],
  [664, 46, -30, 0.8],
  [628, 40, 160, 0.7],
];

type Rose = [number, number, number, number];
// [x, y, scale, rotation]: open blooms, a heavier cluster on the left shoulder
const roses: Rose[] = [
  [92, 82, 1.25, 10],
  [120, 62, 0.95, -30],
  [70, 132, 1, 40],
  [168, 44, 0.7, 70],
  [712, 78, 1.05, -20],
  [742, 172, 0.75, 30],
];
type Bud = [number, number, number];
const buds: Bud[] = [
  [58, 208, -20],
  [212, 33, 60],
  [690, 58, -60],
  [604, 50, 160],
  [760, 300, 10],
];

// --- Ground: the gate stands in a strip of earth and grass that runs past both
// posts and fades out, with a flagstone path leading up to the threshold. It is
// drawn below the 400 line (the SVG is overflow: visible in garden-gate.css), so
// the doors keep their shared viewBox.

// A small deterministic random so every build draws the same grass
let seed = 7;
const rand = () => {
  seed = (seed * 9301 + 49297) % 233280;
  return seed / 233280;
};

// One grass blade as a closed, tapering shape from a base on the ground; the
// tip arches over in the direction of its lean
const blade = (x: number, y: number, h: number, lean: number, w: number) => {
  const f = (n: number) => n.toFixed(1);
  return `M${f(x - w / 2)} ${y} C${f(x - w / 3 + lean * 0.1)} ${f(y - h * 0.45)} ${f(x + lean * 0.45)} ${f(y - h * 0.85)} ${f(x + lean)} ${f(y - h)} C${f(x + lean * 0.4 + w * 0.3)} ${f(y - h * 0.8)} ${f(x + w / 3 + lean * 0.12)} ${f(y - h * 0.4)} ${f(x + w / 2)} ${y} Z`;
};

type Tuft = [number, number, number, number]; // [centre x, spread, blades, height]
// Thick clumps at the post feet, sparse ones along the door bottoms, thinning
// out past the posts where the strip fades
const tufts: Tuft[] = [
  [-40, 22, 6, 9],
  [-4, 24, 9, 13],
  [30, 20, 12, 20],
  [56, 28, 16, 26],
  [86, 20, 12, 18],
  [112, 16, 6, 11],
  [160, 18, 5, 9],
  [232, 14, 4, 8],
  [306, 12, 4, 8],
  [498, 12, 4, 8],
  [566, 16, 5, 9],
  [640, 18, 5, 10],
  [690, 18, 8, 15],
  [716, 22, 12, 20],
  [742, 28, 16, 26],
  [772, 20, 12, 19],
  [806, 24, 9, 13],
  [842, 22, 6, 9],
];
const grassBack: string[] = [];
const grassFront: string[] = [];
for (const [cx, spread, n, h] of tufts) {
  for (let i = 0; i < n; i++) {
    const x = cx + (rand() - 0.5) * spread;
    const y = 401 + rand() * 3;
    const bh = h * (0.55 + rand() * 0.6);
    const lean = (x - cx) * 0.5 + (rand() - 0.5) * bh * 0.7;
    const w = 2.2 + rand() * 1.8;
    (i % 3 === 0 ? grassBack : grassFront).push(blade(x, +y.toFixed(1), bh, lean, w));
  }
}

// Flagstones in three rows widening toward the viewer, the threshold slab first.
// Each is an uneven oval: eight jittered rim points joined by curves through
// their midpoints. [centre x, centre y, half-width, half-height]
type Stone = [number, number, number, number];
const stones: Stone[] = [
  [400, 404.6, 62, 3.6],
  [356, 414.8, 40, 4.4],
  [446, 414.4, 42, 4.6],
  [320, 427.6, 37, 5.4],
  [399, 428.4, 35, 5.8],
  [478, 427.4, 39, 5.4],
];
const stoneRims = stones.map(([cx, cy, rx, ry]) =>
  Array.from({ length: 10 }, (_, i) => {
    const a = (i / 10) * Math.PI * 2 + 0.2 + (rand() - 0.5) * 0.25;
    // a squared-off oval (superellipse), each rim point pushed in or out a little
    const c = Math.cos(a);
    const sn = Math.sin(a);
    const k = 1 + (rand() - 0.5) * 0.16;
    return [
      cx + Math.sign(c) * Math.abs(c) ** 0.6 * rx * k,
      cy + Math.sign(sn) * Math.abs(sn) ** 0.75 * ry * k,
    ] as const;
  }),
);
const stonePath = (pts: readonly (readonly [number, number])[]) => {
  const mid = (i: number) => {
    const [x1, y1] = pts[i % pts.length];
    const [x2, y2] = pts[(i + 1) % pts.length];
    return `${((x1 + x2) / 2).toFixed(1)} ${((y1 + y2) / 2).toFixed(1)}`;
  };
  let d = `M${mid(0)}`;
  for (let i = 1; i <= pts.length; i++) {
    const [x, y] = pts[i % pts.length];
    d += ` Q${x.toFixed(1)} ${y.toFixed(1)} ${mid(i)}`;
  }
  return d + " Z";
};

// Tiny meadow flowers among the post-foot grass: [x, y, scale]
const daisies: [number, number, number][] = [
  [24, 392, 0.9],
  [104, 394, 0.75],
  [690, 393, 0.8],
  [778, 391, 1],
];
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 800 400"
  fill="none"
  preserveAspectRatio="xMidYMid meet"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <!-- One leaf: a blade with a curled tip, and its midrib -->
    <g id="gate-leaf">
      <path class="gate-leaf" d="M0 0 C2.6 -4.6 8.4 -6.4 14 -3.4 C11.4 0.6 5.6 2.6 0 0 Z"></path>
      <path class="gate-leaf-rib" d="M0.6 -0.3 C4.6 -1.8 8.6 -2.6 12.6 -3.1"></path>
    </g>
    <!-- One open rose: outer petals, inner cup, and the inked spiral of the heart -->
    <g id="gate-rose">
      <path
        class="gate-rose-outer"
        d="M-9.4 1.2 C-11.6 -5.4 -6 -10.4 -0.4 -9.6 C3.4 -11.2 9.8 -7.4 9.8 -1.6 C11.4 3.6 6.6 9.6 0.8 9.6 C-3.6 10.8 -9.6 7 -9.4 1.2 Z"
      ></path>
      <path
        class="gate-rose-mid"
        d="M-6.2 0.4 C-7 -4.4 -2.6 -7 0.8 -6.4 C4.6 -6.2 7 -3 6.2 1 C5.6 4.8 1.6 6.6 -1.4 6.2 C-4.4 5.8 -6.2 3.4 -6.2 0.4 Z"
      ></path>
      <path
        class="gate-rose-line"
        d="M-2.4 -0.8 C-2.6 -3.2 0.8 -4 2.4 -2.2 C3.8 -0.4 2.2 2.4 -0.4 2.1 C-2 1.8 -2.2 0.2 -0.8 -0.4 M-7.6 3.2 C-4.4 6.4 2.8 6.8 7 2.6 M-8.2 -2.8 C-6.4 -7 -1.4 -8.6 3 -7.6 M5.4 -5.6 C7.6 -4 8.6 -1.6 8.4 0.6"
      ></path>
    </g>
    <!-- A closed bud with its sepals -->
    <g id="gate-bud">
      <path class="gate-rose-mid" d="M0 0 C-3.6 -2.4 -3.4 -8 0 -10.4 C3.4 -8 3.6 -2.4 0 0 Z"></path>
      <path class="gate-leaf" d="M0 0 C-3 -1 -4.6 -3.6 -4.2 -6.4 C-2.4 -4.4 -1 -2.6 0 0 Z"></path>
      <path class="gate-leaf" d="M0 0 C3 -1 4.6 -3.6 4.2 -6.4 C2.4 -4.4 1 -2.6 0 0 Z"></path>
      <path class="gate-vine" d="M0 0 L0 4"></path>
    </g>
  </defs>

  <!-- Arbor arch: a curved timber beam springing from the post caps -->
  <g class="gate-arbor" stroke="currentColor" stroke-linejoin="round">
    <path
      d="M58 74 C190 16 610 16 742 74 L742 88 C610 32 190 32 58 88 Z"
      fill="currentColor"
      fill-opacity="0.08"
      stroke-width="1.3"
      stroke-opacity="0.8"></path>
    <!-- the beam's shadowed underside -->
    <path
      d="M58 84 C190 28 610 28 742 84 L742 88 C610 32 190 32 58 88 Z"
      fill="currentColor"
      fill-opacity="0.12"
      stroke="none"></path>
    <!-- grain running along the beam -->
    <g stroke-width="0.6" stroke-opacity="0.3" stroke-linecap="round">
      <path d="M120 58 C200 36 290 28 360 27" stroke-dasharray="70 8 40 12"></path>
      <path d="M430 28 C520 30 610 40 690 62" stroke-dasharray="50 10 80 9"></path>
      <path d="M90 74 C150 50 220 40 260 37" stroke-dasharray="30 7"></path>
      <path d="M540 38 C600 44 660 56 720 76" stroke-dasharray="44 9 22 8"></path>
    </g>
  </g>

  <!-- Posts: square timber with a bevelled cap and a ball finial -->
  {
    [50, 720].map((x) => (
      <g class="gate-post" stroke="currentColor" stroke-linejoin="round">
        <rect
          x={x}
          y="84"
          width="30"
          height="318"
          fill="currentColor"
          fill-opacity="0.08"
          stroke-width="1.4"
          stroke-opacity="0.8"
        />
        {/* the face turned away from the light */}
        <rect
          x={x + 21}
          y="84.7"
          width="8.3"
          height="316"
          fill="currentColor"
          fill-opacity="0.12"
          stroke="none"
        />
        {/* grain and a knot */}
        <g stroke-width="0.6" stroke-opacity="0.32" stroke-linecap="round">
          <path
            d={`M${x + 7} 96 C${x + 6} 160 ${x + 9} 220 ${x + 7} 300 C${x + 6} 340 ${x + 8} 370 ${x + 7} 398`}
            stroke-dasharray="80 9 50 7 120 10"
          />
          <path
            d={`M${x + 14} 110 C${x + 15} 170 ${x + 12} 210 ${x + 15} 250`}
            stroke-dasharray="40 8"
          />
          <path
            d={`M${x + 12} 284 C${x + 9} 290 ${x + 9} 298 ${x + 13} 302 C${x + 17} 298 ${x + 17} 290 ${x + 12} 284 Z M${x + 13} 304 C${x + 13} 330 ${x + 11} 360 ${x + 13} 396`}
          />
        </g>
        {/* cap */}
        <path
          d={`M${x - 5} 84 L${x - 2} 74 L${x + 32} 74 L${x + 35} 84 Z`}
          fill="currentColor"
          fill-opacity="0.14"
          stroke-width="1.2"
          stroke-opacity="0.8"
        />
        <path
          d={`M${x + 1} 74 L${x + 4} 69 L${x + 26} 69 L${x + 29} 74`}
          fill="currentColor"
          fill-opacity="0.1"
          stroke-width="1"
          stroke-opacity="0.7"
        />
        {/* finial: neck and ball, with a soft catch-light */}
        <path
          d={`M${x + 11} 69 C${x + 12} 66 ${x + 12} 64 ${x + 10.5} 62 L${x + 19.5} 62 C${x + 18} 64 ${x + 18} 66 ${x + 19} 69 Z`}
          fill="currentColor"
          fill-opacity="0.12"
          stroke-width="0.9"
          stroke-opacity="0.7"
        />
        <circle
          cx={x + 15}
          cy="54"
          r="8"
          fill="currentColor"
          fill-opacity="0.12"
          stroke-width="1.1"
          stroke-opacity="0.8"
        />
        <path
          d={`M${x + 15} 54 m4 1.5 a6 6 0 0 1 -7.5 5`}
          stroke-width="1.2"
          stroke-opacity="0.35"
          stroke-linecap="round"
        />
        <ellipse class="gate-catchlight" cx={x + 12.4} cy="51" rx="2.2" ry="1.5" stroke="none" />
      </g>
    ))
  }

  <!-- Iron hinge knuckles on the inner faces of the posts -->
  <g
    class="gate-iron"
    fill="currentColor"
    fill-opacity="0.55"
    stroke="currentColor"
    stroke-width="0.8"
  >
    <rect x="78" y="142.5" width="9" height="16" rx="2.5"></rect>
    <rect x="78" y="355" width="9" height="16" rx="2.5"></rect>
    <rect x="713" y="142.5" width="9" height="16" rx="2.5"></rect>
    <rect x="713" y="355" width="9" height="16" rx="2.5"></rect>
    <g fill="none" stroke-opacity="0.6">
      <path d="M78 150.5 H87 M78 363 H87 M713 150.5 H722 M713 363 H722"></path>
    </g>
  </g>

  <!-- Climbing rose: canes winding up both posts, the left far fuller -->
  <g class="gate-roses">
    <path
      class="gate-vine gate-vine-main"
      d="M42 400 C36 372 72 352 84 314 C94 282 48 266 45 228 C42 192 88 180 86 144 C84 118 58 106 68 86 C80 64 126 54 168 44 C200 37 236 30 268 27 C284 26 296 28 300 22 C302 18 297 15 294 18"
    ></path>
    <path
      class="gate-vine"
      d="M84 314 C96 300 104 292 100 280 M45 228 C34 220 30 210 36 200 M68 86 C60 78 56 66 64 58 C70 54 74 58 72 62 M168 44 C176 54 178 64 172 72"
    ></path>
    <path
      class="gate-vine gate-vine-main"
      d="M758 400 C764 352 724 332 718 292 C712 252 757 238 755 198 C753 160 719 142 723 106 C725 88 742 82 731 72 C714 56 682 50 652 45 C632 42 614 42 604 50"
    ></path>
    <path class="gate-vine" d="M718 292 C708 284 704 274 708 264 M731 72 C738 64 738 56 732 52"
    ></path>

    {
      [...leavesLeft, ...leavesRight].map(([x, y, r, s = 1]) => (
        <use href="#gate-leaf" transform={`translate(${x} ${y}) rotate(${r}) scale(${s})`} />
      ))
    }
    {
      buds.map(([x, y, r]) => (
        <use href="#gate-bud" transform={`translate(${x} ${y}) rotate(${r})`} />
      ))
    }
    {
      roses.map(([x, y, s, r]) => (
        <use href="#gate-rose" transform={`translate(${x} ${y}) rotate(${r}) scale(${s})`} />
      ))
    }
  </g>

  <!-- Ground: soft shadow, a strip of earth fading out at both ends, flagstones
       to the threshold, grass and a few small flowers at the post feet -->
  <g class="gate-ground">
    <defs>
      <linearGradient
        id="gate-earth-fill"
        x1="0"
        y1="399"
        x2="0"
        y2="440"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" class="gate-earth-stop" stop-opacity="0.95"></stop>
        <stop offset="0.45" class="gate-earth-stop" stop-opacity="0.6"></stop>
        <stop offset="1" class="gate-earth-stop" stop-opacity="0"></stop>
      </linearGradient>
      <linearGradient
        id="gate-earth-fade"
        x1="-90"
        y1="0"
        x2="890"
        y2="0"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" stop-color="#000"></stop>
        <stop offset="0.15" stop-color="#fff"></stop>
        <stop offset="0.85" stop-color="#fff"></stop>
        <stop offset="1" stop-color="#000"></stop>
      </linearGradient>
      <mask
        id="gate-earth-mask"
        maskUnits="userSpaceOnUse"
        x="-100"
        y="380"
        width="1000"
        height="80"
      >
        <rect x="-100" y="380" width="1000" height="80" fill="url(#gate-earth-fade)"></rect>
      </mask>
      <radialGradient
        id="gate-shadow"
        cx="400"
        cy="402"
        r="470"
        gradientTransform="translate(0 380) scale(1 0.055)"
        gradientUnits="userSpaceOnUse"
      >
        <stop offset="0" class="gate-shadow-stop" stop-opacity="0.2"></stop>
        <stop offset="0.75" class="gate-shadow-stop" stop-opacity="0.08"></stop>
        <stop offset="1" class="gate-shadow-stop" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <ellipse class="gate-ground-wash" cx="400" cy="402" rx="470" ry="26" fill="url(#gate-shadow)"
    ></ellipse>
    <!-- the earth strip, its top edge a little uneven -->
    <path
      class="gate-earth gate-ground-wash"
      fill="url(#gate-earth-fill)"
      mask="url(#gate-earth-mask)"
      d="M-90 401 C-20 399.4 40 401.6 110 400.4 C220 398.8 300 401.2 400 400.2 C500 399.4 600 401.4 690 400.2 C760 399.4 830 401.2 890 400.6 L890 440 L-90 440 Z"
    ></path>
    <!-- the ground line, inked in broken strokes -->
    <g class="gate-soil" stroke="currentColor" stroke-linecap="round">
      <path
        stroke-width="1.1"
        stroke-opacity="0.55"
        d="M-40 401.2 C20 399.8 60 401.4 110 400.5 C180 399.4 250 401 330 401 M470 401 C540 400.8 610 401.4 690 400.2 C740 399.6 800 401 842 400.8"
      ></path>
      <path
        stroke-width="0.7"
        stroke-opacity="0.35"
        d="M-70 401.6 L-52 401.3 M856 401 L874 401.4 M130 405 L144 404.6 M190 408 L198 407.8 M236 405.6 L252 405.2 M552 405.4 L566 405.8 M610 408 L620 407.7 M660 405 L676 404.6 M30 407 L44 406.6 M752 407 L768 407.4"
      ></path>
    </g>
    <!-- pebbles -->
    <g class="gate-pebble" stroke="currentColor" stroke-width="0.6" stroke-opacity="0.45">
      <ellipse cx="120" cy="409" rx="3" ry="1.6"></ellipse>
      <ellipse cx="214" cy="406.5" rx="2.2" ry="1.2"></ellipse>
      <ellipse cx="586" cy="407" rx="2.6" ry="1.4"></ellipse>
      <ellipse cx="672" cy="410" rx="3.2" ry="1.6"></ellipse>
      <ellipse cx="270" cy="412" rx="1.8" ry="1"></ellipse>
      <ellipse cx="536" cy="413" rx="2" ry="1.1"></ellipse>
    </g>
    <!-- flagstones -->
    <g
      class="gate-stone"
      stroke="currentColor"
      stroke-width="0.9"
      stroke-opacity="0.55"
      stroke-linejoin="round"
    >
      {stoneRims.map((pts) => <path d={stonePath(pts)} />)}
    </g>
    <!-- a shaded lower lip on each stone and the odd hairline crack -->
    <g
      class="gate-stone-shade"
      stroke="currentColor"
      stroke-linecap="round"
      stroke-width="0.6"
      stroke-opacity="0.32"
    >
      {
        stones.map(([x, y, rx, ry]) => (
          <path
            d={`M${x - rx * 0.62} ${y + ry * 0.55} C${x - rx * 0.2} ${y + ry * 0.85} ${x + rx * 0.3} ${y + ry * 0.82} ${x + rx * 0.66} ${y + ry * 0.5}`}
          />
        ))
      }
      <path d="M378 403.4 L386 405.2 L392 404.6 M332 426 L340 428.2 M462 413 L468 415.4 L474 415"
      ></path>
    </g>
    <!-- grass: the back blades darker, the front ones in sage -->
    <path class="gate-grass-back" d={grassBack.join(" ")}></path>
    <path class="gate-grass" d={grassFront.join(" ")}></path>
    <!-- the rose canes leaf out at their feet -->
    <use href="#gate-leaf" transform="translate(40 398) rotate(-142) scale(1.05)"></use>
    <use href="#gate-leaf" transform="translate(45 399) rotate(-62) scale(0.9)"></use>
    <use href="#gate-leaf" transform="translate(88 399) rotate(-58) scale(0.85)"></use>
    <use href="#gate-leaf" transform="translate(754 399) rotate(-124) scale(0.95)"></use>
    <use href="#gate-leaf" transform="translate(760 398) rotate(-38) scale(1.05)"></use>
    <!-- meadow flowers: five petals round a rose heart, on a short stem -->
    {
      daisies.map(([x, y, s]) => (
        <g transform={`translate(${x} ${y}) scale(${s})`}>
          <path class="gate-vine" d="M0 2 C0.6 5 -0.4 8 0.4 11" />
          {[0, 72, 144, 216, 288].map((a) => (
            <ellipse
              class="gate-daisy"
              cx="0"
              cy="-2.6"
              rx="1.5"
              ry="2.6"
              transform={`rotate(${a})`}
            />
          ))}
          <circle class="gate-daisy-heart" r="1.2" />
        </g>
      ))
    }
  </g>
</svg>
