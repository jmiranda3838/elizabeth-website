---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="-400 0 2000 700"
  preserveAspectRatio="xMidYMax slice"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- The moving light of the doorway scene, laid exactly over DoorwayFrame (same
       viewBox and fit): the glow of the two lanterns and a few rose petals carried
       out of the door. Kept apart so their slow animation never repaints the scene. -->
  <defs>
    <radialGradient id="dwl-glow">
      <stop offset="0" stop-color="#fff1cf" stop-opacity="0.6"></stop>
      <stop offset="0.35" stop-color="#ffe3b8" stop-opacity="0.34"></stop>
      <stop offset="1" stop-color="#ffdcae" stop-opacity="0"></stop>
    </radialGradient>
    <path id="dwl-petal" d="M0 0 C-3.4 -2.6 -3 -6.8 0.6 -8.2 C3.6 -5.6 3 -2 0 0 Z"></path>
  </defs>
  <circle class="candle-glow candle-glow-1" cx="804" cy="334" r="62" fill="url(#dwl-glow)"></circle>
  <circle class="candle-glow candle-glow-2" cx="408" cy="576" r="66" fill="url(#dwl-glow)"></circle>
  <g fill="#f4bdb5">
    <g class="doorway-petal doorway-petal-1">
      <use href="#dwl-petal" transform="translate(540 546) rotate(40)"></use>
    </g>
    <g class="doorway-petal doorway-petal-2">
      <use href="#dwl-petal" transform="translate(498 584) rotate(-70) scale(1.2)"></use>
    </g>
    <g class="doorway-petal doorway-petal-3" fill="#f9d2cb">
      <use href="#dwl-petal" transform="translate(570 600) rotate(120) scale(0.9)"></use>
    </g>
    <g class="doorway-petal doorway-petal-4">
      <use href="#dwl-petal" transform="translate(468 630) rotate(15) scale(1.3)"></use>
    </g>
    <g class="doorway-petal doorway-petal-5" fill="#f9d2cb">
      <use href="#dwl-petal" transform="translate(612 640) rotate(-140) scale(1.1)"></use>
    </g>
    <g class="doorway-petal doorway-petal-6">
      <use href="#dwl-petal" transform="translate(536 652) rotate(80) scale(1.4)"></use>
    </g>
  </g>
</svg>
