---
// Left gate door (hinges on the left post). Drawn at its real coordinates inside the shared
// 0 0 800 400 viewBox so it aligns with GateFrame; the whole SVG element is
// swung open in CSS via transform-origin at the hinge edge. The timber and iron
// come from gateDoorArt.ts (shared with the right door, which draws it mirrored).
import { buildDoor } from "./gateDoorArt";

interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;
const art = buildDoor(11);
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 800 400"
  fill="none"
  preserveAspectRatio="xMidYMid meet"
  xmlns="http://www.w3.org/2000/svg"
>
  <g stroke="currentColor" stroke-linejoin="round">
    <!-- Translucent backing so the door reads as substance and softly catches
         the garden light between the palings; styled from garden-gate.css. -->
    <path class="gate-door-panel" d={art.panel} stroke="none"></path>
    <!-- Palings, each a slightly different weathered tone -->
    {
      art.boards.map((b) => (
        <path
          d={b.d}
          fill="currentColor"
          fill-opacity={b.fo.toFixed(3)}
          stroke-width="0.9"
          stroke-opacity="0.5"
        />
      ))
    }
    <!-- Stiles -->
    {
      art.stiles.map((d) => (
        <path
          d={d}
          fill="currentColor"
          fill-opacity="0.11"
          stroke-width="1.1"
          stroke-opacity="0.75"
        />
      ))
    }
    <!-- Grain and knots -->
    <g stroke-width="0.5" stroke-opacity="0.22" stroke-linecap="round">
      {
        art.grain.map((d, i) => (
          <path
            d={d}
            stroke-dasharray={i % 3 === 0 ? "60 7 30 9" : i % 3 === 1 ? "90 10 20 6" : "40 8 70 11"}
          />
        ))
      }
      {art.knots.map((d) => <path d={d} stroke-opacity="0.5" />)}
    </g>
    <!-- Rails, standing proud of the palings, with their cast shadows -->
    {
      art.railShadows.map((d) => (
        <path d={d} fill="currentColor" fill-opacity="0.1" stroke="none" />
      ))
    }
    {
      art.rails.map((d) => (
        <path d={d} fill="currentColor" fill-opacity="0.12" stroke-width="1" stroke-opacity="0.7" />
      ))
    }
    <g fill="currentColor" fill-opacity="0.45" stroke="none">
      {art.nails.map(([x, y]) => <circle cx={x} cy={y} r="0.9" />)}
    </g>
    <!-- Forged strap hinges ending in scrolls -->
    <g class="gate-door-iron">
      {
        art.straps.map((d) => (
          <path d={d} fill="currentColor" fill-opacity="0.55" stroke-width="0.7" />
        ))
      }
      {
        art.scrolls.map((d) => (
          <path d={d} stroke-width="2" stroke-opacity="0.7" stroke-linecap="round" />
        ))
      }
      <g fill="currentColor" fill-opacity="0.85" stroke="none">
        {art.bolts.map(([x, y]) => <circle cx={x} cy={y} r="1.3" />)}
      </g>
    </g>
  </g>
</svg>
