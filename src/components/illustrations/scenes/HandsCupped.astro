---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

/* Two open hands, palms up, held side by side with a light resting in the hollow
   between them: the image of "I'm just being a conduit". Seen the way you see your
   own hands when you hold them out, thumbs outermost.

   Each hand is built from a hand-placed skeleton (five digit axes, a palm outline,
   three palm lines) and the right hand is the left one mirrored and then nudged, so
   the pair never reads as a reflection. All of it is lit by ONE radial gradient
   centred on the held light, so the palms glow and the fingertips fall into dusk.
   The page palette is used directly; this drawing is not themed through `color`. */

type Pt = [number, number];
interface DigitSpec {
  /** axis: base, bend (quadratic control), tip */
  b: Pt;
  c: Pt;
  t: Pt;
  /** half-width at the base and at the tip */
  w0: number;
  w1: number;
  /** crease positions along the axis, 0-1 */
  joints: number[];
  /** how far the base tucks under the palm */
  sink?: number;
  /** samples to skip where the edge line starts (the thumb's inner edge fades in) */
  trim?: number;
}
interface HandSpec {
  digits: DigitSpec[];
  palm: Pt[];
  palmEdge: Pt[];
  thenarEdge: Pt[];
  lines: Pt[][];
  wrist: Pt[][];
}

const f = (n: number) => Math.round(n * 10) / 10;
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

/** A smooth path through points (Catmull-Rom, written as cubics) */
function smooth(pts: Pt[], closed = false): string {
  const n = pts.length;
  const at = (i: number) => (closed ? pts[(i + n) % n] : pts[Math.max(0, Math.min(n - 1, i))]);
  let d = `M${f(pts[0][0])} ${f(pts[0][1])}`;
  const last = closed ? n : n - 1;
  for (let i = 0; i < last; i++) {
    const p0 = at(i - 1);
    const p1 = at(i);
    const p2 = at(i + 1);
    const p3 = at(i + 2);
    const c1: Pt = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2: Pt = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
  }
  return d + (closed ? "Z" : "");
}

const quad = (a: Pt, c: Pt, b: Pt, t: number): Pt => {
  const u = 1 - t;
  return [
    u * u * a[0] + 2 * u * t * c[0] + t * t * b[0],
    u * u * a[1] + 2 * u * t * c[1] + t * t * b[1],
  ];
};
const quadTan = (a: Pt, c: Pt, b: Pt, t: number): Pt => {
  const x = 2 * (1 - t) * (c[0] - a[0]) + 2 * t * (b[0] - c[0]);
  const y = 2 * (1 - t) * (c[1] - a[1]) + 2 * t * (b[1] - c[1]);
  const l = Math.hypot(x, y) || 1;
  return [x / l, y / l];
};

/** One finger or thumb, grown along its axis */
function digit({ b, c, t, w0, w1, joints, sink = 8, trim = 0 }: DigitSpec) {
  const N = 16;
  const near: Pt[] = [];
  const far: Pt[] = [];
  // Tapers to the tip; each pad swells a little and each joint pinches
  const width = (u: number) => {
    const edges = [0, ...joints, 1];
    let k = 0;
    while (k < edges.length - 2 && u > edges[k + 1]) k++;
    const local = (u - edges[k]) / (edges[k + 1] - edges[k]);
    return lerp(w0, w1, Math.pow(u, 1.15)) * (1 + 0.055 * Math.sin(Math.PI * local));
  };
  for (let i = 0; i <= N; i++) {
    const u = i / N;
    const p = quad(b, c, t, u);
    const tn = quadTan(b, c, t, u);
    const w = width(u);
    near.push([p[0] - tn[1] * w, p[1] + tn[0] * w]);
    far.push([p[0] + tn[1] * w, p[1] - tn[0] * w]);
  }
  const tipT = quadTan(b, c, t, 1);
  const cap: Pt[] = [];
  for (let a = 1; a < 8; a++) {
    const ang = (a / 8) * Math.PI;
    const cs = Math.cos(ang) * w1;
    const sn = Math.sin(ang) * w1 * 1.08;
    cap.push([t[0] - tipT[1] * cs + tipT[0] * sn, t[1] + tipT[0] * cs + tipT[1] * sn]);
  }
  const bt = quadTan(b, c, t, 0);
  const sunkNear: Pt = [near[0][0] - bt[0] * sink, near[0][1] - bt[1] * sink];
  const sunkFar: Pt = [far[0][0] - bt[0] * sink, far[0][1] - bt[1] * sink];
  const outline = [...near, ...cap, ...far.slice().reverse()];
  // Creases sag towards the palm, as they do on a finger curling up at you
  const creases = [0.03, ...joints].map((j, i) => {
    const p = quad(b, c, t, j);
    const tn = quadTan(b, c, t, j);
    const w = width(j) * (i === 0 ? 0.7 : 0.86);
    const sag = w * (i === 0 ? 0.22 : 0.34);
    return [
      [p[0] - tn[1] * w, p[1] + tn[0] * w],
      [p[0] - tn[0] * sag, p[1] - tn[1] * sag],
      [p[0] + tn[1] * w, p[1] - tn[0] * w],
    ] as Pt[];
  });
  return { outline, sunkNear, sunkFar, creases, trim };
}

function hand(spec: HandSpec, map: (p: Pt) => Pt) {
  const digits = spec.digits.map(digit);
  const thumb = digits.length - 1;
  return {
    palm: smooth(spec.palm.map(map), true),
    palmEdge: smooth(spec.palmEdge.map(map)),
    thenarEdge: smooth(spec.thenarEdge.map(map)),
    lines: spec.lines.map((l) => smooth(l.map(map))).join(""),
    wrist: spec.wrist.map((l) => smooth(l.map(map))).join(""),
    digits: digits.map((d, i) => {
      const o = d.outline.map(map);
      // The thumb's outline carries on from the ball of the thumb in one stroke
      const edge =
        i === thumb
          ? smooth([...spec.thenarEdge.map(map), ...o.slice(d.trim).reverse().slice(1)])
          : smooth(o);
      return {
        fill: smooth([map(d.sunkNear), ...o, map(d.sunkFar)]) + "Z",
        edge,
        creases: d.creases
          .slice(i === thumb ? 1 : 0)
          .map((cr) => cr.map(map))
          .map(([a, q, e]) => `M${f(a[0])} ${f(a[1])}Q${f(q[0])} ${f(q[1])} ${f(e[0])} ${f(e[1])}`)
          .join(""),
      };
    }),
  };
}

// Left hand, fingers up: thumb on the left, little finger on the right
const LEFT: HandSpec = {
  digits: [
    // little, ring, middle and index finger, then the thumb (drawn in this order)
    { b: [101, 117], c: [103.8, 93], t: [99.5, 70], w0: 8.4, w1: 6.6, joints: [0.43, 0.75] },
    { b: [82.5, 105], c: [85, 72], t: [81, 42], w0: 9.7, w1: 7.7, joints: [0.44, 0.76] },
    { b: [62, 101], c: [63, 62], t: [61.5, 28], w0: 10.3, w1: 8.1, joints: [0.45, 0.77] },
    { b: [41, 105], c: [39, 72], t: [43, 43], w0: 10, w1: 7.8, joints: [0.44, 0.76] },
    {
      b: [33, 168],
      c: [13, 142],
      t: [17, 104],
      w0: 11.6,
      w1: 8.4,
      joints: [0.52],
      sink: 4,
      trim: 3,
    },
  ],
  palm: [
    [46, 250],
    [43, 216],
    [34, 197],
    [25.5, 183],
    [21.8, 174.6],
    [29, 152],
    [31, 128],
    [32, 106],
    [44, 99],
    [62, 96],
    [82, 100],
    [98, 109],
    [110, 119],
    [115, 138],
    [116, 160],
    [111, 186],
    [100, 212],
    [97, 250],
  ],
  palmEdge: [
    [110, 121],
    [115, 138],
    [116, 160],
    [111, 186],
    [100, 212],
    [97, 244],
  ],
  thenarEdge: [
    [46, 244],
    [43, 216],
    [34, 197],
    [25.5, 183],
    [21.8, 174.6],
  ],
  lines: [
    // heart line, head line, life line
    [
      [108, 133],
      [92, 128],
      [72, 122],
      [55, 111],
    ],
    [
      [32, 128],
      [50, 129],
      [72, 139],
      [92, 153],
    ],
    [
      [37, 123],
      [53, 138],
      [61, 162],
      [59, 190],
      [53, 208],
    ],
  ],
  wrist: [
    [
      [47, 214],
      [62, 217],
      [80, 216],
      [96, 211],
    ],
    [
      [50, 221],
      [66, 224],
      [82, 223],
      [93, 219],
    ],
  ],
};

// Right hand: the same skeleton with its own finger lengths and bends
const RIGHT: HandSpec = structuredClone(LEFT);
Object.assign(RIGHT.digits[0], { c: [105, 96], t: [101.5, 73] });
Object.assign(RIGHT.digits[1], { t: [83, 45] });
Object.assign(RIGHT.digits[2], { c: [64.5, 66], t: [63, 31] });
Object.assign(RIGHT.digits[3], { c: [39, 76], t: [44.5, 47] });
Object.assign(RIGHT.digits[4], { c: [12, 146], t: [14, 107] });

// A fan of fine rays lifting off the light, long and short by turns like the logo's sunburst
const rays = [-72, -58, -45, -33, -21, -10, 1, 12, 23, 34, 47, 59, 73]
  .map((deg, i) => {
    const a = (deg * Math.PI) / 180;
    const dx = Math.sin(a);
    const dy = -Math.cos(a);
    const r0 = 25;
    const r1 = i % 2 ? 44 : 58 - Math.abs(deg) * 0.12;
    const w = 0.9;
    const p = (r: number, side: number) =>
      `${f(130 + dx * r - dy * side)} ${f(150 + dy * r + dx * side)}`;
    return `M${p(r0, -w)}L${p(r1, 0)}L${p(r0, w)}Z`;
  })
  .join("");

const turn = (deg: number, cx: number, cy: number) => {
  const r = (deg * Math.PI) / 180;
  const c = Math.cos(r);
  const s = Math.sin(r);
  return ([x, y]: Pt): Pt => [cx + (x - cx) * c - (y - cy) * s, cy + (x - cx) * s + (y - cy) * c];
};
// Each hand leans outward from the heel of its palm, so the pair opens like a bowl;
// the right hand sits a touch lower and overlaps the left along the little-finger edge
const leanL = turn(-9, 106, 190);
const leanR = turn(-11, 106, 190);
const hands = [
  hand(LEFT, (p) => {
    const q = leanL(p);
    return [q[0] + 27, q[1] - 4];
  }),
  hand(RIGHT, (p) => {
    const q = leanR(p);
    return [260 - (q[0] + 25), q[1] + 3];
  }),
];
---

<svg
  class={className}
  style={style}
  aria-hidden="true"
  {...rest}
  viewBox="0 0 260 250"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <!-- The held light, as it falls on skin: cream in the palms, rose at the knuckles,
         dusk at the fingertips and thumbs -->
    <radialGradient id="hc-skin" gradientUnits="userSpaceOnUse" cx="130" cy="150" r="150">
      <stop offset="0" stop-color="#fff3d8"></stop>
      <stop offset="0.2" stop-color="#f8d9aa"></stop>
      <stop offset="0.45" stop-color="#e3ad92"></stop>
      <stop offset="0.7" stop-color="#c48d86"></stop>
      <stop offset="1" stop-color="#96687a"></stop>
    </radialGradient>
    <!-- The beam from above, catching the fingertips -->
    <linearGradient id="hc-top" gradientUnits="userSpaceOnUse" x1="0" y1="14" x2="0" y2="96">
      <stop offset="0" stop-color="#ffe9c4" stop-opacity="0.62"></stop>
      <stop offset="1" stop-color="#ffe9c4" stop-opacity="0"></stop>
    </linearGradient>
    <radialGradient id="hc-rays" gradientUnits="userSpaceOnUse" cx="130" cy="150" r="60">
      <stop offset="0.35" stop-color="#fffaf0" stop-opacity="0.95"></stop>
      <stop offset="1" stop-color="#ffe9bd" stop-opacity="0"></stop>
    </radialGradient>
    <radialGradient id="hc-light">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset="0.5" stop-color="#fff5dc" stop-opacity="0.9"></stop>
      <stop offset="1" stop-color="#ffe9bd" stop-opacity="0"></stop>
    </radialGradient>
    <!-- The wrists dissolve into the dark instead of ending -->
    <linearGradient id="hc-fade" gradientUnits="userSpaceOnUse" x1="0" y1="186" x2="0" y2="246">
      <stop offset="0" stop-color="#fff"></stop>
      <stop offset="0.5" stop-color="#fff" stop-opacity="0.55"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </linearGradient>
    <mask id="hc-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="260" height="250">
      <rect width="260" height="250" fill="url(#hc-fade)"></rect>
    </mask>
  </defs>

  <g mask="url(#hc-mask)" stroke-linecap="round" stroke-linejoin="round">
    {
      hands.map((h, n) => (
        <g>
          <clipPath id={`hc-palm-${n}`}>
            <path d={h.palm} />
          </clipPath>
          <path d={h.palm} fill="url(#hc-skin)" />
          {/* Each form turns away from the light at its edge: a soft band of shade, kept inside the shape */}
          <path
            d={h.palmEdge}
            clip-path={`url(#hc-palm-${n})`}
            stroke="#8f5062"
            stroke-opacity="0.2"
            stroke-width="9"
          />
          <path
            d={h.thenarEdge}
            clip-path={`url(#hc-palm-${n})`}
            stroke="#8f5062"
            stroke-opacity="0.2"
            stroke-width="9"
          />
          <path d={h.palmEdge} stroke="#4a2f40" stroke-opacity="0.5" stroke-width="1.15" />
          <path d={h.lines} stroke="#8a5451" stroke-opacity="0.42" stroke-width="0.9" />
          <path d={h.wrist} stroke="#8a5451" stroke-opacity="0.3" stroke-width="0.8" />
          {h.digits.map((d, i) => (
            <>
              <clipPath id={`hc-digit-${n}-${i}`}>
                <path d={d.fill} />
              </clipPath>
              <path d={d.fill} fill="url(#hc-skin)" />
              <path d={d.fill} fill="url(#hc-top)" />
              <path
                d={d.edge}
                clip-path={`url(#hc-digit-${n}-${i})`}
                stroke="#8f5062"
                stroke-opacity="0.2"
                stroke-width="6.5"
              />
              <path d={d.edge} stroke="#4a2f40" stroke-opacity="0.52" stroke-width="1.1" />
              <path d={d.creases} stroke="#8a5451" stroke-opacity="0.55" stroke-width="0.9" />
            </>
          ))}
        </g>
      ))
    }
  </g>

  <!-- The light itself, resting where the two palms meet -->
  <path d={rays} fill="url(#hc-rays)"></path>
  <circle cx="130" cy="150" r="22" fill="url(#hc-light)"></circle>
</svg>
