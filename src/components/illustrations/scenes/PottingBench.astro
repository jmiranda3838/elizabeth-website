<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 1100 240"
  preserveAspectRatio="xMidYMax slice"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- A potting bench: terracotta pots at every stage (empties, seedlings, a
       pelargonium in flower, lavender, trailing ivy), a watering can, twine and
       a trowel. The bench runs far past the viewBox so the scene can sit centred
       on any width (the svg is overflow: visible). No lettering anywhere. -->
  <defs>
    <linearGradient id="pb-under" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#60665a" stop-opacity="0.2"></stop>
      <stop offset="0.45" stop-color="#60665a" stop-opacity="0.06"></stop>
      <stop offset="1" stop-color="#60665a" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="pb-can" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#b9c6c6"></stop>
      <stop offset="0.28" stop-color="#d3dddb"></stop>
      <stop offset="0.6" stop-color="#b0bebf"></stop>
      <stop offset="1" stop-color="#8fa1a4"></stop>
    </linearGradient>
    <!-- Roundness for every pot: a lit left shoulder falling to a shaded right flank -->
    <linearGradient id="pb-round" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="#8a5451" stop-opacity="0.12"></stop>
      <stop offset="0.17" stop-color="#fff" stop-opacity="0.26"></stop>
      <stop offset="0.44" stop-color="#fff" stop-opacity="0"></stop>
      <stop offset="0.58" stop-color="#8a5451" stop-opacity="0"></stop>
      <stop offset="1" stop-color="#8a5451" stop-opacity="0.36"></stop>
    </linearGradient>
    <radialGradient id="pb-twine" cx="38%" cy="34%" r="70%">
      <stop offset="0" stop-color="#ead9c6"></stop>
      <stop offset="1" stop-color="#cdb39c"></stop>
    </radialGradient>
    {
      pots.map((p) => (
        <>
          <clipPath id={`pb-b-${p.id}`}>
            <path d={p.body} />
          </clipPath>
        </>
      ))
    }
    <!-- Pelargonium leaf: a round, lobed leaf with a darker zone and radiating veins -->
    <g id="pb-gleaf">
      <path
        d="M0 0 C-7 -3 -17 -5 -21 -13 C-27 -16 -28 -24 -24 -29 C-26 -36 -20 -43 -13 -42 C-9 -49 -1 -50 4 -46 C10 -50 18 -46 19 -39 C26 -38 29 -30 25 -25 C29 -19 26 -11 19 -9 C15 -3 6 -2 0 0 Z"
      ></path>
      <path
        d="M0 -6 C-8 -8 -15 -12 -16 -19 C-19 -25 -15 -33 -8 -34 C-3 -39 6 -38 10 -33 C17 -31 19 -23 15 -18 C14 -11 7 -7 0 -6 Z"
        fill="#60665a"
        fill-opacity="0.13"></path>
      <path
        d="M0 -1 L-17 -17 M0 -1 L-10 -34 M0 -1 L3 -40 M0 -1 L15 -32 M0 -1 L20 -16"
        stroke="#60665a"
        stroke-opacity="0.32"
        stroke-width="0.7"
        stroke-linecap="round"></path>
    </g>
    <!-- One pelargonium floret: five uneven petals -->
