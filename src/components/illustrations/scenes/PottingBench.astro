      stroke-linecap="round"
      stroke-opacity="0.8"></path>
    <!-- spout and its brace -->
    <path d="M338 166 L388 107 L399 116 L344 192 Z" fill="#a3b3b5"></path>
    <path d="M344 192 L399 116 L394 112 L341 180 Z" fill="#7d9094" fill-opacity="0.45"></path>
