        const dx = tx - fx;
        const dy = ty - fy;
        const ang = (Math.atan2(dx, -dy) * 180) / Math.PI;
        const n = 6 + (i % 2);
        return (
          <g>
            <path
              d={`M${fx} ${fy} Q${r(fx + dx * 0.3 - dy * 0.04)} ${r(fy + dy * 0.5)} ${tx} ${ty}`}
              stroke={SAGE.deep}
              stroke-width="1"
              stroke-linecap="round"
            />
            <g transform={`translate(${tx} ${ty}) rotate(${r(ang)})`}>
              {Array.from({ length: n }, (_, k) => {
                const y = r(k * 4.4 - 4);
                const s = r(1.5 + Math.sin(((k + 0.6) / n) * Math.PI) * 1.9);
                return (
                  <>
                    <ellipse
                      cx={-s}
                      cy={y}
                      rx={s}
                      ry="2.3"
                      transform={`rotate(-24 ${-s} ${y})`}
                      fill={k % 2 ? "#c69491" : "#b98e9a"}
                    />
                    <ellipse
                      cx={s}
                      cy={r(y + 1.4)}
                      rx={s}
                      ry="2.3"
                      transform={`rotate(24 ${s} ${r(y + 1.4)})`}
                      fill={k % 2 ? "#a98592" : "#d0a3a3"}
                    />
                  </>
                );
              })}
              <ellipse cx="0" cy="-7" rx="1.6" ry="2.6" fill="#d0a3a3" />
            </g>
          </g>
        );
      })
    }
