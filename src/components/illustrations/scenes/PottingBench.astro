        d="M0 0 C-3.4 -2 -3.6 -6.4 0 -7.6 C3.6 -6.4 3.4 -2 0 0 C2.6 -3 6.8 -2.6 7.4 1.2 C5.6 4.6 1.8 3.4 0 0 C3 2.2 2.8 6.6 -0.8 7.4 C-4 5.8 -3 2 0 0 C-1.4 3.4 -5.6 4.2 -7.4 0.8 C-6.6 -2.8 -2.8 -2.6 0 0 Z"
        stroke="#c4807b"
        stroke-opacity="0.5"
        stroke-width="0.35"></path>
      <circle r="1.1" fill="#98605d" fill-opacity="0.7"></circle>
    </g>
  </defs>

  <!-- Bench: top surface, front edge with grain, and the shadow it throws on the
       section below (which shares this strip's paper colour) -->
  <g class="bench">
    <rect x="-900" y="219" width="2900" height="22" fill="#f7f6f5"></rect>
    <rect x="-900" y="219" width="2900" height="20" fill="url(#pb-under)"></rect>
