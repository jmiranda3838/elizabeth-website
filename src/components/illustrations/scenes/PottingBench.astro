// Chive flowers: a pom of fine florets, a long ring behind a shorter one, tipped darker
const chiveHeads = [
  [172, 100, 8.6],
  [196, 104, 7.4],
  [222, 112, 6.4],
].map(([x, y, rad], h) => {
  let back = "";
  let front = "";
  let tips = "";
  for (let i = 0; i < 16; i++) {
    const a = (i / 16) * Math.PI * 2 + h;
    const len = rad * (0.9 + ((i * 3 + h) % 4) * 0.06);
    const ex = r(x + Math.cos(a) * len);
    const ey = r(y + Math.sin(a) * len);
    back += `M${x} ${y}L${ex} ${ey}`;
    tips += `M${ex} ${ey}h0.1`;
    const b = a + 0.2;
    front += `M${x} ${y}L${r(x + Math.cos(b) * len * 0.62)} ${r(y + Math.sin(b) * len * 0.62)}`;
  }
  return { x, y, r: rad, back, front, tips };
});

// Pelargonium flower heads: florets packed in a loose spiral, outer ones first
const PINK = ["#f9c8c2", "#eeb4ad", "#dfa19b", "#f6d3cd"];
const florets = [
  [530, 34, 11, 1.45],
  [586, 20, 12, 1.5],
  [625, 58, 8, 1.25],
].flatMap(([hx, hy, n, s], h) =>
  Array.from({ length: n }, (_, i) => {
    const k = n - 1 - i;
    const a = k * 2.39996 + h * 1.3;
    const rad = Math.sqrt(k) * 3.9 * s;
    return {
      x: r(hx + Math.cos(a) * rad),
      y: r(hy + Math.sin(a) * rad * 0.8),
      rot: (k * 67 + h * 31) % 360,
      s: r(s * (1 - k * 0.012)),
      fill: PINK[(k + h) % 4],
    };
  }),
);

// Chives in the bulb pan: [foot x, tip x, tip y, bend]
