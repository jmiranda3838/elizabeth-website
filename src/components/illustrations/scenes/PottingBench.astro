      stroke="#b99c8c"
      stroke-width="0.7"
      stroke-opacity="0.8"></path>
  </g>

  <!-- Contact shadows on the bench top -->
  <g fill="#60665a" fill-opacity="0.13">
    {
      pots
        .filter((p) => p.base > 195)
        .map((p) => <ellipse cx={p.cx + 5} cy="201.5" rx={p.bot / 2 + 9} ry="3.4" />)
    }
    <ellipse cx="326" cy="201.5" rx="50" ry="3.8"></ellipse>
    <ellipse cx="764" cy="201.5" rx="27" ry="3.2"></ellipse>
    <ellipse cx="846" cy="201.8" rx="52" ry="2.6"></ellipse>
  </g>

  <!-- Watering can -->
  <g class="can" transform="translate(14 0)">
    <!-- back handle -->
    <path
      d="M276 140 C252 136 240 150 244 166 C247 180 258 187 272 186"
      stroke="#8fa1a4"
      stroke-width="5.5"
      stroke-linecap="round"></path>
    <path
      d="M275 139 C254 136 243 149 246 164"
      stroke="#d3dddb"
