// Pots with nothing planted: the mouth shows shadowed clay, not soil
const empty = ["s3", "w1", "w2", "w4", "w5"];

/* A simple asymmetric leaf drawn from its base, pointing up; placed with a transform. */
const leaf = (len: number, w: number) =>
  `M0 0 C${r(w * 0.95)} ${r(-len * 0.22)} ${r(w * 0.75)} ${r(-len * 0.78)} 0 ${-len} C${r(-w * 0.6)} ${r(-len * 0.74)} ${r(-w * 0.8)} ${r(-len * 0.28)} 0 0 Z`;
const half = (len: number, w: number) =>
  `M0 0 C${r(w * 0.95)} ${r(-len * 0.22)} ${r(w * 0.75)} ${r(-len * 0.78)} 0 ${-len} Q${r(w * 0.12)} ${r(-len * 0.5)} 0 0 Z`;

type L = [number, number, number, number, number, string]; // x, y, len, width, rotation, fill
