interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

/* Terracotta pots are built from a few measurements so every one shares the
   same construction (tapered body, thick rim, elliptical mouth) while differing
   in size, proportion and clay tone. base = y of the foot on the bench. */
interface Pot {
  id: string;
  cx: number;
  base: number;
  top: number; // rim width
  bot: number; // foot width
  h: number;
  rim: number; // rim band height
  clay: string;
  lip: string;
  open?: boolean; // false = nested pot: front lip only, nothing inside
  lean?: number;
}
const r = (n: number) => Math.round(n * 10) / 10;
function build(p: Pot) {
  const { cx, base, top: T, bot: B, h, rim: R } = p;
  const e = r(T * 0.075); // half-height of the mouth ellipse
  const ty = base - h + e; // y of the mouth centre
  const l = cx - T / 2;
  const rt = cx + T / 2;
  const by = ty + R; // where the rim band meets the body
  const body = `M${r(l + 5)} ${r(by - 2)} C${r(l + 6)} ${r(by + (base - by) * 0.4)} ${r(cx - B / 2 - 1)} ${r(base - 12)} ${r(cx - B / 2)} ${r(base - 3)} Q${cx} ${r(base + 4)} ${r(cx + B / 2)} ${r(base - 3)} C${r(cx + B / 2 + 1)} ${r(base - 12)} ${r(rt - 6)} ${r(by + (base - by) * 0.4)} ${r(rt - 5)} ${r(by - 2)} Z`;
  const rimFull = `M${l} ${ty} A${T / 2} ${e} 0 0 1 ${rt} ${ty} C${r(rt + 0.6)} ${r(ty + R * 0.5)} ${r(rt - 0.4)} ${r(by - 1)} ${r(rt - 1.5)} ${by} Q${cx} ${r(by + e * 2.1)} ${r(l + 1.5)} ${by} C${r(l + 0.4)} ${r(by - 1)} ${r(l - 0.6)} ${r(ty + R * 0.5)} ${l} ${ty} Z`;
  const rimFront = `M${l} ${ty} A${T / 2} ${e} 0 0 0 ${rt} ${ty} C${r(rt + 0.6)} ${r(ty + R * 0.5)} ${r(rt - 0.4)} ${r(by - 1)} ${r(rt - 1.5)} ${by} Q${cx} ${r(by + e * 2.1)} ${r(l + 1.5)} ${by} C${r(l + 0.4)} ${r(by - 1)} ${r(l - 0.6)} ${r(ty + R * 0.5)} ${l} ${ty} Z`;
  // Shadow the rim casts on the body
  const under = `M${l} ${r(by - 2)} Q${cx} ${r(by + e * 2.1 - 1)} ${rt} ${r(by - 2)} L${rt} ${r(by + 5)} Q${cx} ${r(by + e * 2.1 + 6)} ${l} ${r(by + 5)} Z`;
  // Two faint throwing rings round the belly
  const y1 = r(by + (base - by) * 0.42);
  const y2 = r(by + (base - by) * 0.7);
  const rings = `M${l} ${y1} Q${cx} ${r(y1 + e * 1.7)} ${rt} ${y1} M${l} ${y2} Q${cx} ${r(y2 + e * 1.5)} ${rt} ${y2}`;
  return { ...p, e, ty, by, body, rimFull, rimFront, under, rings };
}

