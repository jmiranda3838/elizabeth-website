          <>
            <ellipse cx={p.cx} cy={p.ty} rx={p.top / 2 - 3.6} ry={p.e - 1.4} fill="#a56f69" />
            <ellipse
              cx={p.cx}
              cy={r(p.ty + 1.4)}
              rx={p.top / 2 - 6.4}
              ry={r(p.e - 2.4)}
              fill={empty.includes(p.id) ? "#8a5451" : "#7c5f57"}
              fill-opacity={empty.includes(p.id) ? 0.5 : 1}
            />
          </>
        )}
        <path
          d={p.open === false ? p.rimFront : p.rimFull}
          stroke="#8a5451"
          stroke-width="0.8"
          stroke-opacity="0.32"
        />
      </g>
    ))
