---
import { buildGarland, type GarlandVariant } from "./garlandArt";

interface Props {
  class?: string;
  style?: string;
  /** "wide" for desktop (1440 units across), "narrow" for 768px and down (600 units) */
  variant?: GarlandVariant;
  [key: string]: unknown;
}
const { class: className = "", style = "", variant = "wide", ...rest } = Astro.props;
const art = buildGarland(variant);
const blurId = `garland-blur-${variant}`;
---

<svg
  class={className}
  style={style}
  aria-hidden="true"
  {...rest}
  viewBox={`0 0 ${art.width} ${art.height}`}
  preserveAspectRatio="xMidYMin meet"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Hero garland: two swags of foliage and garden roses on a twine, tied up in
       the middle and at both corners. Drawn by garlandArt.ts. The .hanging-bunch
       groups (tails, vines, lavender, the bow) are swayed from hero.css. -->
  <defs>
    <filter id={blurId} x="-10%" y="-40%" width="120%" height="200%">
      <feGaussianBlur stdDeviation={variant === "wide" ? 14 : 9}></feGaussianBlur>
    </filter>
    <Fragment set:html={art.defs} />
  </defs>
  <path
    class="garland-shadow"
    d={art.shadow}
    fill="#2b221b"
    fill-opacity="0.42"
    filter={`url(#${blurId})`}
    transform="translate(0 14)"></path>
  <g class="garland-string" stroke-linecap="round" set:html={art.twine} />
  {
    art.bunches
      .filter((b) => b.n !== 3)
      .map((b) => (
        <g transform={`translate(${b.x.toFixed(1)} ${b.y.toFixed(1)})`}>
          <g class={`hanging-bunch bunch-${b.n}`} set:html={b.html} />
        </g>
      ))
  }
  <g class="garland-foliage" set:html={art.body} />
  {
    art.bunches
      .filter((b) => b.n === 3)
      .map((b) => (
        <g transform={`translate(${b.x.toFixed(1)} ${b.y.toFixed(1)})`}>
          <g class={`hanging-bunch bunch-${b.n}`} set:html={b.html} />
        </g>
      ))
  }
</svg>
