            fill="#fff2d8"
          />
          <path
            d="M73 99 V39 M77 99.4 V44"
            stroke="#6f867a"
            stroke-width="0.7"
            stroke-opacity="0.7"
          />
          <path
            d="M80.6 64 L70 65.6 M80.6 88 L70 87"
            stroke="#5d6a5f"
            stroke-width="2"
            stroke-linecap="round"
          />
          <ellipse cx="68" cy="77" rx="1.3" ry="2.2" stroke="#5d6a5f" stroke-width="0.9" />
        </g>
        <path d="M38 100 V58 A22 22 0 0 1 82 58 V100" stroke="#c4a797" stroke-width="1" />
        <path
          d="M28 72 H38 M28 86 H38 M82 66 H92 M82 80 H92 M82 92 H92 M30.4 46 L40 51 M40.6 33 L46 41.6 M54 26.6 L55.6 36.4 M68 27.2 L65.6 36.8 M80.6 34.6 L74.6 42.6 M89.6 46 L80.6 51"
          stroke="#c9ae9e"
          stroke-width="0.8"
          stroke-linecap="round"
        />
        <path
          d="M24 104 C22 84 26 62 30 50 C35 36 46 26 60 23 C68 21.6 76 24 82 28"
          stroke="#8c9a86"
          stroke-width="1.3"
          stroke-linecap="round"
        />
        <path
          d="M24 92 C18 91 15 87 15.6 83 C20.6 84 23.6 87.6 24 92 Z M25 78 C31 78 34 74 34 70 C29 70 25.6 73.6 25 78 Z M27 64 C21 62 19 57 20.6 53.6 C25 55.6 27.6 59.6 27 64 Z M33 46 C39 47.6 43.6 45 44.6 41 C39.6 39.6 35 42 33 46 Z M44 31 C42 25.6 37.6 23.6 34 25 C35.6 29.6 39.6 32 44 31 Z M66 22.4 C68 17 72.6 15.6 76 17.4 C74 21.6 70.4 23.6 66 22.4 Z M78 26 C80 31.6 85 33 88.4 31 C86.4 26.6 82.4 24.6 78 26 Z"
