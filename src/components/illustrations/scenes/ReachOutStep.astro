---
interface Props {
  class?: string;
  style?: string;
  /** Which moment: a letter back, a phone call, or the door open */
  variant?: "letter" | "talk" | "begin";
  [key: string]: unknown;
}
const { class: className = "", style = "", variant = "letter", ...rest } = Astro.props;

// The telephone's coiled cord: loops traced along a curve from the handset's
// mouthpiece down to the side of the base (a prolate trochoid on a quadratic).
const coil = (() => {
  const [p0, p1, p2] = [
    [97, 75.5],
    [111, 84],
    [94.6, 96.6],
  ];
  const loops = 6.5;
  const r = 1.9;
  const steps = 160;
  const pts: string[] = [];
  for (let i = 0; i <= steps; i++) {
    const t = i / steps;
    const u = 1 - t;
    const x = u * u * p0[0] + 2 * u * t * p1[0] + t * t * p2[0];
    const y = u * u * p0[1] + 2 * u * t * p1[1] + t * t * p2[1];
    const dx = 2 * u * (p1[0] - p0[0]) + 2 * t * (p2[0] - p1[0]);
    const dy = 2 * u * (p1[1] - p0[1]) + 2 * t * (p2[1] - p1[1]);
    const len = Math.hypot(dx, dy) || 1;
    const [tx, ty, nx, ny] = [dx / len, dy / len, -dy / len, dx / len];
    // the loops shrink to nothing at each end so the cord meets its sockets cleanly
    const k = r * Math.min(1, t * 6, (1 - t) * 6);
    const a = 2 * Math.PI * loops * t;
    const px = x + k * (Math.sin(a) * tx + (1 - Math.cos(a)) * nx * 0.9);
    const py = y + k * (Math.sin(a) * ty + (1 - Math.cos(a)) * ny * 0.9);
    pts.push(`${px.toFixed(2)} ${py.toFixed(2)}`);
  }
  return "M" + pts.join(" L");
})();

// Finger holes round the dial, leaving the gap by the finger stop (lower right)
const dialHoles = Array.from({ length: 10 }, (_, i) => {
  const a = ((150 + i * 30) * Math.PI) / 180;
  return [(60 + 6.2 * Math.cos(a)).toFixed(2), (89.6 + 6.2 * Math.sin(a)).toFixed(2)];
});
