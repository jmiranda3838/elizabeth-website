---
interface Props {
  class?: string;
  style?: string;
  /** Which moment: a letter back, a phone call, or the door open */
  variant?: "letter" | "talk" | "begin";
  [key: string]: unknown;
}
const { class: className = "", style = "", variant = "letter", ...rest } = Astro.props;
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 120 120"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- Spot drawings for "what happens after you reach out" on the contact page,
       in the palette of the doorway scene above them. -->
  {
    variant === "letter" && (
      <g>
        {/* A reply: an opened envelope, the letter half out, a rose sprig beside it */}
        <ellipse cx="60" cy="106" rx="40" ry="3.4" fill="#d9c7b8" fill-opacity="0.5" />
        <g transform="rotate(-5 60 66)">
          <path
            d="M21 54 L57 27 C59 25.6 61 25.6 63 27 L99 54 V98 C99 100.4 97.4 102 95 102 H25 C22.6 102 21 100.4 21 98 Z"
            fill="#eedccf"
            stroke="#c4a595"
            stroke-width="1.2"
            stroke-linejoin="round"
          />
          <path d="M32 34 H88 V90 H32 Z" fill="#fffaf4" stroke="#dcc7b8" stroke-width="1" />
          <path
            d="M40 44 H66 M40 52 H80 M40 60 H76 M40 68 H70"
            stroke="#b9c8bb"
            stroke-width="1.7"
            stroke-linecap="round"
          />
          <path
            d="M21 55 L60 82 L99 55 V98 C99 100.4 97.4 102 95 102 H25 C22.6 102 21 100.4 21 98 Z"
            fill="#faf1e8"
            stroke="#c4a595"
            stroke-width="1.2"
            stroke-linejoin="round"
          />
          <path
            d="M22.4 100.6 L51 75.6 M97.6 100.6 L69 75.6"
            stroke="#d9c0b1"
            stroke-width="1"
            stroke-linecap="round"
          />
          <path
            d="M60 92 C52.4 86.6 54 80 57.8 80.4 C59.2 80.6 60 81.8 60 82.8 C60 81.8 60.8 80.6 62.2 80.4 C66 80 67.6 86.6 60 92 Z"
            fill="#c98f8b"
          />
        </g>
        <path
          d="M82 110 C88 98 96 88 104 76"
          stroke="#8fa391"
          stroke-width="1.3"
          stroke-linecap="round"
        />
        <path
          d="M86 102 C80 100 77 95 78 91 C83 92 86 96 86 102 Z M91 94 C97 95 101 100 101 104 C96 103 92 99 91 94 Z M94 89 C89 86 88 81 90 78 C94 80 96 84 94 89 Z M99 82 C105 82 109 86 109 90 C104 90 100 87 99 82 Z"
          fill="#9db1a4"
        />
        <path d="M104 76 C100 72 100 66 104.6 62.6 C108.6 66.4 108 72.4 104 76 Z" fill="#eeb0aa" />
        <path
          d="M104 77 C101 76 100 73 100.4 71 C102 72 103.2 74 104 77 C105 74 106.4 72.4 108 71.4 C108.2 73.6 107 76 104 77 Z"
          fill="#86a091"
        />
      </g>
    )
  }
  {
    variant === "talk" && (
      <g>
        {/* A phone call: a handset at rest, and two voices meeting above it */}
        <ellipse cx="60" cy="106" rx="42" ry="3.6" fill="#d9c7b8" fill-opacity="0.5" />
        <path
          d="M20 70 C12 76 12 86 19 90 C13 96 16 104 24 104"
