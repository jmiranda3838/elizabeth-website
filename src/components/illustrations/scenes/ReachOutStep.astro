          d="M42 55 C31.6 47.6 33.8 38.6 39 39.2 C40.8 39.4 42 41 42 42.4 C42 41 43.2 39.4 45 39.2 C50.2 38.6 52.4 47.6 42 55 Z"
          fill="#d99a94"
        />
      </g>
    )
  }
  {
    variant === "begin" && (
      <g>
        {/* A beginning: the same garden door as the hero, ajar, light on the step */}
        <defs>
          <linearGradient
            id="ros-sky"
            x1="0"
            y1="34"
            x2="0"
            y2="100"
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color="#f0c6b3" />
            <stop offset="0.6" stop-color="#fbe3cd" />
            <stop offset="1" stop-color="#fff5e2" />
          </linearGradient>
          <radialGradient id="ros-sun" cx="55" cy="84" r="30" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#fffdf6" />
            <stop offset="0.4" stop-color="#fff3da" stop-opacity="0.8" />
            <stop offset="1" stop-color="#ffeccf" stop-opacity="0" />
          </radialGradient>
          <clipPath id="ros-open">
            <path d="M38 100 V58 A22 22 0 0 1 82 58 V100 Z" />
          </clipPath>
        </defs>
        <path d="M14 106 H106 L110 113 H10 Z" fill="#e1d2c4" />
