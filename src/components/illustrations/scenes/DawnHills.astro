---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

/* The ground under the Reiki page's closing sunrise: four ranges of low hills, far
   to near, each one dissolving into morning mist before the next begins. The mist is
   the colour of the footer (--bg-secondary), so the page lands on it without a seam.
   Oaks gather on the two nearer ranges and a few cypresses break the line.

   The drawing is 2400 wide so it can be cropped (xMidYMax slice) rather than
   stretched; the horizon is y = 60. */

type Pt = [number, number];
const f = (n: number) => Math.round(n * 10) / 10;

const FAR: Pt[] = [
  [0, 58],
  [140, 50],
  [300, 56],
  [430, 46],
  [560, 52],
  [700, 60],
  [840, 54],
  [960, 44],
  [1080, 50],
  [1200, 58],
  [1330, 52],
  [1460, 42],
  [1600, 50],
  [1740, 58],
  [1880, 50],
  [2020, 44],
  [2160, 52],
  [2300, 58],
  [2400, 54],
];
const MID: Pt[] = [
  [0, 84],
  [160, 72],
  [330, 80],
  [480, 92],
  [640, 78],
  [800, 68],
  [960, 82],
  [1110, 94],
  [1260, 84],
  [1400, 72],
  [1560, 80],
  [1720, 94],
  [1880, 82],
  [2040, 70],
  [2200, 80],
  [2400, 90],
];
const NEAR: Pt[] = [
  [0, 118],
  [200, 104],
  [400, 116],
  [600, 132],
  [800, 120],
  [1000, 108],
  [1200, 122],
  [1400, 136],
  [1600, 122],
  [1800, 108],
  [2000, 118],
  [2200, 132],
  [2400, 122],
];
const FORE: Pt[] = [
  [0, 162],
  [300, 152],
  [600, 166],
  [900, 174],
  [1200, 162],
  [1500, 152],
  [1800, 164],
  [2100, 174],
  [2400, 164],
];

/** A crest line, drawn smoothly through its points */
function crest(pts: Pt[]): string {
  let d = `M0 ${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[Math.max(i - 1, 0)];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[Math.min(i + 2, pts.length - 1)];
    d += `C${f(p1[0] + (p2[0] - p0[0]) / 6)} ${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)} ${f(p2[1] - (p3[1] - p1[1]) / 6)} ${p2[0]} ${p2[1]}`;
  }
  return d;
}
/** A range: its crest, closed down to the bottom edge */
const range = (pts: Pt[]) => `${crest(pts)}V240H0Z`;
/** Height of a crest at x (straight between its points: close enough to seat a tree) */
function crestAt(pts: Pt[], x: number): number {
  const i = Math.max(
    0,
    pts.findIndex((p) => p[0] >= x),
  );
  const a = pts[Math.max(i - 1, 0)];
  const b = pts[i];
  return b[0] === a[0] ? a[1] : a[1] + ((b[1] - a[1]) * (x - a[0])) / (b[0] - a[0]);
}
const blob = (x: number, y: number, r: number) =>
  `M${f(x - r)} ${f(y)}a${f(r)} ${f(r * 0.86)} 0 1 0 ${f(2 * r)} 0a${f(r)} ${f(r * 0.86)} 0 1 0 ${f(-2 * r)} 0Z`;
/** An oak: a wide, low crown of uneven lobes on a short trunk, seated into the hill */
function oak(pts: Pt[], x: number, s: number): string {
  const y = crestAt(pts, x) + 3;
  return (
    // wound the same way as the lobes, so the trunk does not punch a hole in the crown
    `M${f(x + 1.1 * s)} ${f(y)}L${f(x + 0.8 * s)} ${f(y - 6 * s)}L${f(x - 0.6 * s)} ${f(y - 6 * s)}L${f(x - 1 * s)} ${f(y)}Z` +
    blob(x - 7.6 * s, y - 6.6 * s, 4.4 * s) +
    blob(x - 3.4 * s, y - 10.2 * s, 5.2 * s) +
    blob(x + 3.2 * s, y - 11 * s, 4.8 * s) +
    blob(x + 8.2 * s, y - 7.4 * s, 4.2 * s) +
    blob(x + 0.6 * s, y - 6.8 * s, 5.4 * s)
  );
}
/** Scrub: a low mound half sunk in the slope */
const scrub = (pts: Pt[], x: number, r: number) => blob(x, crestAt(pts, x) + r * 0.2, r);
/** A cypress: a slim flame */
function cypress(pts: Pt[], x: number, h: number): string {
  const y = crestAt(pts, x) + 3;
  const w = h * 0.13;
  return `M${f(x)} ${f(y - h)}C${f(x + w * 0.7)} ${f(y - h * 0.7)} ${f(x + w * 1.2)} ${f(y - h * 0.3)} ${f(x + w)} ${f(y)}H${f(x - w)}C${f(x - w * 1.2)} ${f(y - h * 0.3)} ${f(x - w * 0.7)} ${f(y - h * 0.7)} ${f(x)} ${f(y - h)}Z`;
}

// Trees are placed by hand: [x, size]
const midOaks: Pt[] = [
  [236, 0.8],
  [262, 1],
  [566, 0.9],
  [742, 1.05],
  [770, 0.8],
  [1012, 0.9],
  [1318, 1],
  [1344, 0.75],
  [1492, 0.95],
  [1798, 0.85],
  [1960, 1],
  [1986, 0.8],
  [2240, 0.9],
];
const midCypress: Pt[] = [
  [640, 22],
  [656, 16],
  [1428, 24],
  [1446, 17],
  [2080, 20],
];
const nearOaks: Pt[] = [
  [120, 1.5],
  [162, 1.2],
  [470, 1.4],
  [705, 1.25],
  [738, 1.6],
  [1090, 1.3],
  [1548, 1.55],
  [1590, 1.2],
  [1700, 1.35],
  [2010, 1.5],
  [2052, 1.15],
  [2300, 1.4],
];
const nearCypress: Pt[] = [
  [520, 34],
  [1130, 38],
  [1152, 27],
  [1880, 36],
];

const midScrub: Pt[] = [
  [420, 4],
  [905, 5],
  [1180, 4],
  [1640, 5],
  [2130, 4],
];
const nearScrub: Pt[] = [
  [300, 6],
  [880, 7],
  [1260, 6],
  [1420, 8],
  [1775, 6],
  [2180, 7],
];

const midTrees =
  midOaks.map(([x, s]) => oak(MID, x, s * 0.78)).join("") +
  midCypress.map(([x, h]) => cypress(MID, x, h)).join("") +
  midScrub.map(([x, r]) => scrub(MID, x, r)).join("");
const nearTrees =
  nearOaks.map(([x, s]) => oak(NEAR, x, s * 0.82)).join("") +
  nearCypress.map(([x, h]) => cypress(NEAR, x, h)).join("") +
  nearScrub.map(([x, r]) => scrub(NEAR, x, r)).join("");
// Grass tufts along the nearest swell
const tufts = [90, 260, 430, 610, 760, 980, 1150, 1290, 1480, 1660, 1830, 2020, 2190, 2330]
  .map((x, i) => {
    const y = crestAt(FORE, x) + 2;
    const h = 9 + (i % 3) * 3;
    return `M${x - 5} ${f(y)}q1 ${-h * 0.6} -3 ${-h}M${x - 1} ${f(y)}q0 ${-h * 0.8} 1 ${-h * 1.25}M${x + 3} ${f(y)}q1 ${-h * 0.6} 5 ${-h * 0.9}`;
  })
  .join("");
---

<svg
  class={className}
  style={style}
  aria-hidden="true"
  {...rest}
  viewBox="0 0 2400 240"
  preserveAspectRatio="xMidYMax slice"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id="dh-far" gradientUnits="userSpaceOnUse" x1="0" y1="42" x2="0" y2="150">
      <stop offset="0" stop-color="#dba57c"></stop>
      <stop offset="0.5" stop-color="#e9c6a6"></stop>
      <stop offset="1" style="stop-color: var(--bg-secondary, #f5f0ee)"></stop>
    </linearGradient>
    <linearGradient id="dh-mid" gradientUnits="userSpaceOnUse" x1="0" y1="68" x2="0" y2="176">
      <stop offset="0" stop-color="#cb8e76"></stop>
      <stop offset="0.5" stop-color="#e0b79e"></stop>
      <stop offset="1" style="stop-color: var(--bg-secondary, #f5f0ee)"></stop>
    </linearGradient>
    <linearGradient id="dh-near" gradientUnits="userSpaceOnUse" x1="0" y1="104" x2="0" y2="210">
      <stop offset="0" stop-color="#b47b7a"></stop>
      <stop offset="0.5" stop-color="#d4aba1"></stop>
      <stop offset="1" style="stop-color: var(--bg-secondary, #f5f0ee)"></stop>
    </linearGradient>
    <!-- The sun is behind the hills, so their crests catch a rim of light beneath it -->
    <linearGradient id="dh-rim" gradientUnits="userSpaceOnUse" x1="640" y1="0" x2="1760" y2="0">
      <stop offset="0" stop-color="#fff3d6" stop-opacity="0"></stop>
      <stop offset="0.5" stop-color="#fff3d6" stop-opacity="0.9"></stop>
      <stop offset="1" stop-color="#fff3d6" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="dh-fore" gradientUnits="userSpaceOnUse" x1="0" y1="150" x2="0" y2="236">
      <stop offset="0" stop-color="#a27680"></stop>
      <stop offset="0.45" stop-color="#cfabaa"></stop>
      <stop offset="1" style="stop-color: var(--bg-secondary, #f5f0ee)"></stop>
    </linearGradient>
  </defs>

  <path d={range(FAR)} fill="url(#dh-far)"></path>
  <path d={crest(FAR)} stroke="url(#dh-rim)" stroke-width="1.6"></path>
  <path d={midTrees} fill="#c58b75"></path>
  <path d={range(MID)} fill="url(#dh-mid)"></path>
  <path d={crest(MID)} stroke="url(#dh-rim)" stroke-width="1.1" stroke-opacity="0.6"></path>
  <path d={nearTrees} fill="#ab777a"></path>
  <path d={range(NEAR)} fill="url(#dh-near)"></path>
  <path d={crest(NEAR)} stroke="url(#dh-rim)" stroke-width="0.9" stroke-opacity="0.35"></path>
  <path d={tufts} stroke="#8f6474" stroke-opacity="0.7" stroke-width="1.2" stroke-linecap="round"
  ></path>
  <path d={range(FORE)} fill="url(#dh-fore)"></path>
</svg>
