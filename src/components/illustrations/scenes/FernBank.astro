// Wood sorrel: three heart leaflets on a hair-thin stalk. [x, y of leaf centre, size, foot x]
const sorrel = [
  [356, 208, 1, 362],
  [378, 214, 0.78, 374],
  [334, 216, 0.7, 340],
  [432, 212, 0.82, 428],
  [664, 212, 0.86, 668],
  [744, 206, 1, 738],
  [766, 214, 0.74, 770],
