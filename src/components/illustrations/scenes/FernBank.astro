  [808, 214, 0.76, 804],
  [60, 214, 0.9, 64],
  [1040, 212, 0.9, 1036],
];
// Little five-petalled woodland flowers. [x, y, size, foot x, foot y]
const blooms = [
  [404, 190, 1, 410, 224],
  [420, 200, 0.76, 416, 224],
  [690, 194, 0.9, 686, 224],
  [712, 204, 0.72, 714, 224],
  [140, 204, 0.8, 144, 226],
  [962, 200, 0.84, 958, 226],
];
---

<svg
  class={className}
  style={style}
  {...rest}
  viewBox="0 0 1100 240"
  preserveAspectRatio="xMidYMax slice"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
>
  <!-- A fern bank in spring: fiddleheads at every stage of unfurling (each one a
       living question mark) in front of open fronds, with wood sorrel and small
       flowers in the moss. The ground runs far past the viewBox so the scene can
       sit centred on any width (the svg is overflow: visible). -->
  <defs>
    <path
      id="fb-heart"
      d="M0 0 C-2.4 -1.6 -6.6 -3.4 -6.4 -7.4 C-6.2 -10.4 -2.4 -11 0 -8.2 C2.4 -11 6.2 -10.4 6.4 -7.4 C6.6 -3.4 2.4 -1.6 0 0 Z"
    ></path>
    <path
      id="fb-petal"
      d="M0 0 C-2.6 -2.2 -3 -6 0 -7.6 C3 -6 2.6 -2.2 0 0 Z"
      stroke="#c4807b"
      stroke-opacity="0.45"
      stroke-width="0.35"></path>
    <!-- New growth blushes bronze-pink at the coil and greens toward the crown -->
    <linearGradient id="fb-blush" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d9a59c" stop-opacity="0.9"></stop>
      <stop offset="0.26" stop-color="#d9a59c" stop-opacity="0.55"></stop>
      <stop offset="0.66" stop-color="#d9a59c" stop-opacity="0"></stop>
    </linearGradient>
    <linearGradient id="fb-hill" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eed6cb"></stop>
      <stop offset="1" stop-color="#f4e3da"></stop>
    </linearGradient>
    <linearGradient id="fb-moss" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#cfdcd1"></stop>
      <stop offset="1" stop-color="#e2e9e1"></stop>
    </linearGradient>
  </defs>

  <!-- Far rise -->
  <path
    d="M-900 241 V206 C-640 196 -380 212 -120 204 C20 200 120 190 240 192 C340 194 400 186 480 182 C560 178 640 180 720 188 C800 196 880 190 980 192 C1080 194 1160 204 1300 200 C1560 194 1800 208 2000 202 V241 Z"
    fill="url(#fb-hill)"></path>
  <path
    d="M240 192 C340 194 400 186 480 182 C560 178 640 180 720 188 C800 196 880 190 980 192"
    stroke="#e3c9bd"
    stroke-width="0.9"
    stroke-linecap="round"
    stroke-dasharray="70 9 30 12 120 10"></path>

  <!-- Open fronds behind -->
  {
    fronds.map((f) => (
      <g>
        <path d={f.down} fill={f.shade} />
        <path d={f.up} fill={f.tone} />
        <path d={f.rachis} stroke={SAGE.soft} stroke-width="1.1" stroke-linecap="round" />
      </g>
    ))
  }

  <!-- Moss -->
  <path
    d="M-900 241 V222 C-640 214 -380 228 -140 220 C0 216 90 206 200 206 C300 206 370 218 460 212 C510 208 590 206 650 210 C740 216 800 208 890 206 C980 204 1040 216 1140 218 C1400 222 1700 212 2000 220 V241 Z"
    fill="url(#fb-moss)"></path>
  <g stroke="#b9c8bc" stroke-width="0.9" stroke-linecap="round">
    <path
      d="M120 210 l-2 -5 M124 209.6 l0.6 -6 M128 209.4 l2.6 -4.6 M300 210.6 l-2 -4.6 M304 211 l0.6 -5.6 M470 211.6 l-2 -4.6 M474 211.4 l1 -5.6 M478 211 l3 -4 M640 209.6 l-2.4 -4.4 M644 209.8 l0.4 -5.6 M790 209 l-2 -5 M794 208.6 l1 -5.6 M798 208.4 l3 -4.4 M980 207.4 l-2 -4.6 M984 207.6 l0.8 -5.6"
    ></path>
  </g>

  <!-- Fiddleheads -->
  {
    croziers.map((c) => (
      <g>
        <path d={c.d} fill={c.tone} />
        <path d={c.d} fill="url(#fb-blush)" />
        <path d={c.d} stroke="#60665a" stroke-opacity="0.26" stroke-width="0.7" />
        <path
          d={c.edge}
          stroke="#eef3ef"
          stroke-opacity="0.42"
          stroke-width={r(c.w * 0.12)}
          stroke-linecap="round"
        />
        <path
          d={c.scales}
          stroke="#8a5451"
          stroke-opacity="0.34"
          stroke-width="0.8"
          stroke-linecap="round"
        />
        {c.nubs.map((n) => (
          <ellipse
            cx={n.x}
            cy={n.y}
            rx={r(3.3 * n.s)}
            ry={r(1.8 * n.s)}
            transform={`rotate(${n.rot} ${n.x} ${n.y})`}
            fill="#f3e1da"
            fill-opacity="0.9"
          />
        ))}
      </g>
    ))
  }

  <!-- Low fronds in front -->
  {
    nearFronds.map((f) => (
      <g>
        <path d={f.down} fill={f.shade} />
        <path d={f.up} fill={f.tone} />
        <path d={f.rachis} stroke={SAGE.deep} stroke-width="1" stroke-linecap="round" />
      </g>
    ))
  }

  <!-- Near ground: the paper of the section below, so the bank is the seam -->
  <path
    d="M-900 241 V228 C-600 220 -300 232 0 226 C200 222 330 216 460 220 C520 222 590 222 650 220 C780 216 900 224 1100 224 C1400 224 1700 218 2000 226 V241 Z"
    fill="#f7f6f5"></path>

  <!-- Flowers -->
  {
    blooms.map(([x, y, s, fx, fy], i) => (
      <g>
        <path
          d={`M${fx} ${fy} Q${r((x + fx) / 2 + (i % 2 ? 3 : -3))} ${r((y + fy) / 2)} ${x} ${y}`}
          stroke={SAGE.deep}
          stroke-width="0.9"
          stroke-linecap="round"
        />
        <g transform={`translate(${x} ${y}) scale(${s}) rotate(${i * 23})`}>
          {[0, 72, 144, 216, 288].map((a) => (
            <use href="#fb-petal" transform={`rotate(${a})`} fill={i % 2 ? "#f9c8c2" : "#f3d6d0"} />
          ))}
          <circle r="1.6" fill="#d0a08f" />
        </g>
      </g>
    ))
  }

  <!-- Wood sorrel -->
  {
    sorrel.map(([x, y, s, fx], i) => (
      <g>
        <path
          d={`M${fx} 228 Q${r((x + fx) / 2 + 1.5)} ${r(y + 9)} ${x} ${y}`}
          stroke={SAGE.mid}
          stroke-width="0.8"
          stroke-linecap="round"
        />
        <g transform={`translate(${x} ${y}) scale(${s}) rotate(${((i * 37) % 50) - 25})`}>
          <use href="#fb-heart" fill={SAGE.soft} transform="rotate(-118)" />
          <use href="#fb-heart" fill={SAGE.mid} transform="rotate(118)" />
          <use href="#fb-heart" fill={i % 2 ? SAGE.pale : SAGE.soft} />
          <path
            d="M0 0 V-7 M0 0 L-5.4 3 M0 0 L5.4 3"
            stroke="#60665a"
            stroke-opacity="0.3"
            stroke-width="0.5"
            stroke-linecap="round"
          />
        </g>
      </g>
    ))
  }

  <!-- Grass and a pebble or two along the near edge -->
  <g stroke={SAGE.mid} stroke-width="0.9" stroke-linecap="round">
    <path
      d="M246 224 l-3 -8 M250 224 l0 -10 M254 224 l4 -7 M500 222 l-3 -7 M504 222 l1 -9 M606 222 l-2 -8 M610 222 l2 -9 M614 222 l4 -6 M842 223 l-3 -7 M846 223 l1 -9 M1010 225 l-3 -7 M1014 225 l1 -9 M1018 225 l4 -6 M30 227 l-3 -7 M34 227 l1 -9"
    ></path>
  </g>
  <g>
    <ellipse cx="462" cy="223" rx="6.4" ry="3.2" fill="#e6d3c8"></ellipse>
    <path d="M457 222 q4 -2.2 9 -0.4" stroke="#fff" stroke-opacity="0.7" stroke-width="0.8"></path>
    <ellipse cx="640" cy="222.4" rx="4.6" ry="2.4" fill="#ddc6ba"></ellipse>
    <ellipse cx="648" cy="223.4" rx="3" ry="1.7" fill="#e6d3c8"></ellipse>
  </g>
</svg>
