].map((f) => frond(f));
// Low fronds in front of the stalks, nearer and so a tone deeper
const nearFronds = [
  { bx: 534, by: 226, tx: 410, ty: 150, bend: -34, n: 12, L: 21, tone: SAGE.soft, shade: SAGE.mid },
  { bx: 572, by: 226, tx: 708, ty: 146, bend: 36, n: 12, L: 21, tone: SAGE.soft, shade: SAGE.mid },
  { bx: 204, by: 228, tx: 142, ty: 170, bend: -18, n: 9, L: 18, tone: SAGE.soft, shade: SAGE.mid },
  { bx: 894, by: 228, tx: 966, ty: 160, bend: 20, n: 10, L: 19, tone: SAGE.soft, shade: SAGE.mid },
].map((f) => frond(f));

const croziers = [
  // middle clump: back pair first, then the two tall ones, then the newest
  { bx: 530, by: 226, cx: 497, cy: 138, R: 15, dir: 1, w: 10, sway: -4, tone: SAGE.soft },
  { bx: 578, by: 226, cx: 627, cy: 148, R: 13.5, dir: -1, w: 9.4, sway: 6, tone: SAGE.soft },
  { bx: 545, by: 228, cx: 547, cy: 62, R: 24, dir: 1, w: 15, sway: 9, tone: SAGE.mid },
  { bx: 566, by: 228, cx: 583, cy: 112, R: 19, dir: -1, w: 12.6, sway: -8, tone: SAGE.deep },
  {
    bx: 553,
