  },
  // far edges, seen only on very wide screens
  {
    bx: -150,
    by: 226,
    tx: -250,
    ty: 120,
    bend: -30,
    n: 14,
    L: 26,
    tone: SAGE.mist,
    shade: SAGE.pale,
  },
  {
    bx: -140,
    by: 226,
    tx: -60,
    ty: 130,
    bend: 26,
    n: 13,
    L: 24,
    tone: SAGE.pale,
    shade: SAGE.soft,
  },
  {
    bx: 1250,
    by: 226,
    tx: 1350,
    ty: 122,
    bend: 30,
    n: 14,
    L: 26,
    tone: SAGE.mist,
    shade: SAGE.pale,
  },
  {
    bx: 1240,
    by: 226,
    tx: 1160,
    ty: 132,
    bend: -26,
    n: 13,
    L: 24,
    tone: SAGE.pale,
    shade: SAGE.soft,
