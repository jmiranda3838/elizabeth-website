---
interface Props {
  class?: string;
  style?: string;
  [key: string]: unknown;
}
const { class: className = "", style = "", ...rest } = Astro.props;

type P = [number, number];
const r = (n: number) => Math.round(n * 10) / 10;

/* A tapering ribbon along a run of points: the stalk of a fern, thick at the
   crown and thinning into the coil. */
function ribbon(pts: P[], width: (t: number) => number) {
  const a: string[] = [];
  const b: string[] = [];
  pts.forEach(([x, y], i) => {
    const [px, py] = pts[Math.max(0, i - 1)];
    const [nx, ny] = pts[Math.min(pts.length - 1, i + 1)];
    const len = Math.hypot(nx - px, ny - py) || 1;
    const ox = (-(ny - py) / len) * (width(i / (pts.length - 1)) / 2);
    const oy = ((nx - px) / len) * (width(i / (pts.length - 1)) / 2);
    a.push(`${r(x + ox)} ${r(y + oy)}`);
    b.unshift(`${r(x - ox)} ${r(y - oy)}`);
  });
  return `M${a.join("L")}L${b.join("L")}Z`;
}

/* A fiddlehead: a stalk rising from (bx, by) into a coil centred on (cx, cy).
   dir 1 coils to the right, -1 to the left. */
interface Crozier {
  bx: number;
  by: number;
  cx: number;
  cy: number;
  R: number;
  dir: 1 | -1;
  w: number; // stalk width at the crown
  turns?: number;
  sway?: number;
  tone?: string;
}
function crozier(c: Crozier) {
  const { bx, by, cx, cy, R, dir, w, turns = 2.2, sway = 0 } = c;
  const jx = cx - dir * R; // where the stalk meets the coil
  const h = by - cy;
  const stalk: P[] = [];
  const N = 16;
  for (let i = 0; i <= N; i++) {
    const t = i / N;
    const u = 1 - t;
    const x =
      u * u * u * bx +
      3 * u * u * t * (bx + sway) +
      3 * u * t * t * (jx - dir * R * 0.1) +
      t * t * t * jx;
    const y =
      u * u * u * by +
      3 * u * u * t * (by - h * 0.4) +
      3 * u * t * t * (cy + h * 0.34) +
      t * t * t * cy;
    stalk.push([x, y]);
  }
  const coil: P[] = [];
  const nubs: { x: number; y: number; rot: number; s: number }[] = [];
  const total = turns * 2 * Math.PI;
  const steps = Math.round(total / 0.26);
  for (let i = 1; i <= steps; i++) {
    const th = (i / steps) * total;
    const rad = R * Math.exp(-0.125 * th);
    const x = cx + dir * rad * Math.cos(Math.PI + th);
    const y = cy + rad * Math.sin(Math.PI + th);
    coil.push([x, y]);
    // folded pinnae tucked on the inside of the first turn and a half
    if (i % 2 === 0 && th < Math.PI * 2.5 && rad > 5) {
      const inner = rad - w * 0.3 - 1.6;
      nubs.push({
        x: r(cx + dir * inner * Math.cos(Math.PI + th)),
        y: r(cy + inner * Math.sin(Math.PI + th)),
        rot: r(
          ((Math.atan2(Math.sin(Math.PI + th), dir * Math.cos(Math.PI + th)) * 180) / Math.PI) %
            360,
        ),
        s: r(0.5 + (rad / R) * 0.6),
      });
    }
  }
  const pts = [...stalk, ...coil];
  const split = stalk.length / pts.length;
  const width = (t: number) =>
    t < split ? w - (w * 0.36 * t) / split : w * 0.64 - w * 0.42 * ((t - split) / (1 - split));
  // lit edge of the stalk (the side away from the coil)
  const edge = stalk
    .map(([x, y], i) => {
      const [px, py] = stalk[Math.max(0, i - 1)];
      const [nx, ny] = stalk[Math.min(N, i + 1)];
      const len = Math.hypot(nx - px, ny - py) || 1;
      const k = (width((i / N) * split) / 2 - 1) * dir;
      return `${r(x + ((ny - py) / len) * k)} ${r(y - ((nx - px) / len) * k)}`;
    })
    .join("L");
  // papery scales: short ticks down both sides of the stalk
  let scales = "";
  for (let i = 1; i < N - 1; i++) {
    const [x, y] = stalk[i];
    const side = i % 2 ? 1 : -1;
    const k = width((i / N) * split) / 2;
    scales += `M${r(x + side * k * 0.45)} ${r(y)}l${r(side * k * 0.42)} ${r(1.6 + (i % 3) * 0.5)}`;
  }
  return { ...c, d: ribbon(pts, width), edge: `M${edge}`, scales, nubs };
}

/* An open frond: pinnae in pairs along an arching rachis, longest a third of the
   way up and dwindling to the tip. Returns one path per side so the two sides
   can take slightly different tones. */
interface Frond {
  bx: number;
  by: number;
  tx: number;
  ty: number;
  bend: number;
  n: number;
  L: number;
  tone: string;
  shade: string;
  opacity?: number;
}
function frond(f: Frond) {
  const { bx, by, tx, ty, bend, n, L } = f;
  const mx = (bx + tx) / 2;
  const my = (by + ty) / 2;
  const dl = Math.hypot(tx - bx, ty - by);
  const qx = mx + (-(ty - by) / dl) * bend;
  const qy = my + ((tx - bx) / dl) * bend;
  const at = (t: number): [number, number, number] => {
    const u = 1 - t;
    const x = u * u * bx + 2 * u * t * qx + t * t * tx;
    const y = u * u * by + 2 * u * t * qy + t * t * ty;
    const dx = 2 * u * (qx - bx) + 2 * t * (tx - qx);
    const dy = 2 * u * (qy - by) + 2 * t * (ty - qy);
    return [x, y, Math.atan2(dy, dx)];
  };
  const pinna = (x: number, y: number, ang: number, len: number, wd: number, flip: number) => {
    // a slightly sickle-shaped leaflet from (x, y) along `ang`
    const tr = (px: number, py: number) =>
      `${r(x + px * Math.cos(ang) - py * flip * Math.sin(ang))} ${r(y + px * Math.sin(ang) + py * flip * Math.cos(ang))}`;
    return `M${tr(0, 0)}C${tr(len * 0.2, -wd * 1.05)} ${tr(len * 0.74, -wd * 0.9)} ${tr(len, -wd * 0.1)}C${tr(len * 0.7, wd * 0.5)} ${tr(len * 0.24, wd * 0.62)} ${tr(0, 0)}Z`;
  };
  let up = "";
  let down = "";
  for (let i = 0; i < n; i++) {
    const t = 0.2 + (i / n) * 0.78;
    const [x, y, ang] = at(t);
    const prof = Math.pow(Math.sin(Math.PI * (0.16 + 0.84 * t)), 0.85);
    const len = L * (0.25 + 0.75 * prof) * (i % 2 ? 1 : 0.93);
    const wd = len * 0.17 + 1.1;
    const splay = 1.2 - t * 0.42;
    up += pinna(x, y, ang - splay, len, wd, 1);
    down += pinna(x, y, ang + splay, len * 0.96, wd, -1);
  }
  const [ex, ey, ea] = at(1);
  up += pinna(ex, ey, ea - 0.1, L * 0.22, 1.6, 1);
  return { ...f, up, down, rachis: `M${r(bx)} ${r(by)}Q${r(qx)} ${r(qy)} ${r(tx)} ${r(ty)}` };
}

const SAGE = { deep: "#7f9689", mid: "#96aca0", soft: "#a9bcb0", pale: "#c3d0c6", mist: "#d3ddd4" };

// Fronds, farthest first
const fronds = [
  // behind the middle clump
  { bx: 542, by: 222, tx: 352, ty: 92, bend: -44, n: 18, L: 31, tone: SAGE.mist, shade: SAGE.pale },
  { bx: 562, by: 222, tx: 770, ty: 100, bend: 46, n: 18, L: 31, tone: SAGE.mist, shade: SAGE.pale },
  { bx: 548, by: 222, tx: 452, ty: 38, bend: -30, n: 19, L: 30, tone: SAGE.pale, shade: SAGE.soft },
  { bx: 558, by: 222, tx: 668, ty: 50, bend: 34, n: 19, L: 30, tone: SAGE.pale, shade: SAGE.soft },
  // left and right clumps
  { bx: 212, by: 224, tx: 96, ty: 104, bend: -34, n: 15, L: 27, tone: SAGE.mist, shade: SAGE.pale },
  { bx: 222, by: 224, tx: 316, ty: 116, bend: 30, n: 14, L: 25, tone: SAGE.pale, shade: SAGE.soft },
  {
    bx: 886,
    by: 224,
    tx: 1004,
    ty: 108,
    bend: 34,
    n: 15,
    L: 27,
    tone: SAGE.mist,
    shade: SAGE.pale,
  },
  {
    bx: 876,
    by: 224,
    tx: 790,
    ty: 124,
    bend: -28,
    n: 14,
    L: 25,
