---
import { withBase } from "@/lib/withBase";
import BaseLayout from "../layouts/BaseLayout.astro";
import "@styles/pages/retreat.css";
import { RedRockHorizon } from "@illustrations/scenes";
import { Cairn, Clothespin, VortexSpiral } from "@illustrations/misc";
import { DesertAgave, JuniperSprig, PricklyPear } from "@illustrations/botanicals";

// The six things the flyer lists as included, in the flyer's own wording.
// Each gloss restates the item; none adds a fact.
const stops: { title: string; gloss: string; variant: 1 | 2 | 3 }[] = [
  {
    title: "Transformative Workshops",
    gloss: "Time to explore our relationships with ourselves and one another.",
    variant: 1,
  },
  {
    title: "Zen Meditation & Gentle Yoga",
    gloss: "Stillness for the mind, easy movement for the body.",
    variant: 2,
  },
  {
    title: "Group Hike to Vortex",
    gloss: "We head out together to one of Sedona's vortexes.",
    variant: 3,
  },
  {
    title: "Sound Bath for Deep Relaxation",
    gloss: "Nothing to do but rest and let the sound wash over you.",
    variant: 1,
  },
  {
    title: "Plant-Based Meals & Refreshments",
    gloss: "Good food and something to sip, all of it plant-based.",
    variant: 2,
  },
  {
    title: "E's Famous Gift Bags",
    gloss: "They're famous for a reason.",
    variant: 1,
  },
];

// Prayer-flag string the group photo hangs from. The cord runs along the print's top
// edge through the two clothespins, and from each top corner one run climbs away and
// off the edge of the page: y = −(a·d + b·d²) at distance d from the corner, drawn
// 1:1 in px (the runs never scale with the print, only shrink on phones, retreat.css).
// Measuring from the corner, not the pin, keeps the first flag FLAG_START px out from
// the print at every print width, so none tucks under the photo. Flags keep the
// traditional order (blue, white, red, green, yellow) left to right.
// Wherever the dotted trail passes under the string, retreat-trail.js clears the
// flags it would touch, so the path runs through a gap at every width.
const RUN = 2000; // run length in px, enough to leave the page at any width
const PIN_Y = 200; // the cord's height at the pin, inside each run's viewBox
const RUN_H = 250;
const RISE_A = 0.06;
const RISE_B = 0.000012;
const FLAG_START = 22; // first flag's centre: its inner edge (and swung hem) clear the print
const FLAG_GAP = 36;
const rise = (d: number) => RISE_A * d + RISE_B * d * d;
const runCord = (dir: 1 | -1) => {
  const x0 = dir === 1 ? 0 : RUN;
  const x2 = x0 + dir * RUN;
  const cy = PIN_Y - (RISE_A * RUN) / 2;
  return `M${x0} ${PIN_Y} Q${(x0 + x2) / 2} ${cy} ${x2} ${PIN_Y - rise(RUN)}`;
};
const runFlags = (dir: 1 | -1) => {
  const out = [];
  for (let k = 0, d = FLAG_START; d < RUN - 10; k++, d += FLAG_GAP) {
    const slope = RISE_A + 2 * RISE_B * d; // the cord's climb at this flag
    const tone = dir === 1 ? (k + 3) % 5 : (((2 - k) % 5) + 5) % 5;
    out.push({
      x: (dir === 1 ? d : RUN - d).toFixed(1),
      y: (PIN_Y - rise(d)).toFixed(1),
      angle: ((-dir * Math.atan(slope) * 180) / Math.PI).toFixed(2),
      // The breeze, mostly from the left: each flag's hem swings by its own amount
      // (a shear, so the sewn top edge stays on the cord) and drops a little more
      // or less as the cloth lifts
      skew: (3.5 + 5.5 * Math.sin(k * 1.7 + (dir === 1 ? 0.9 : 0))).toFixed(1),
      drop: (1 + 0.05 * Math.cos(k * 2.3 + (dir === 1 ? 0 : 1.4))).toFixed(3),
      tone,
      shape: "abc"[(k * 7 + (dir === 1 ? 1 : 0)) % 3],
      // Sun-faded, unevenly: a few flags have weathered paler than the rest
      worn: (k * 5 + (dir === 1 ? 2 : 0)) % 7 === 3,
    });
  }
  return out;
};
// The summit's last view: three strata of red rock in golden-hour light, far to near,
// echoing the hero. Each is its top edge (stroked) closed down to the svg's foot
// (filled). Nothing rises above y 70 of the 200-unit viewBox, the spire the summit
// section's bottom padding is measured against (retreat.css).
const ridgeFar =
  "M0 132 C40 131 80 129 110 126 L122 119 C126 114 132 112 140 112 L230 111 C238 111 242 114 245 119 L254 127 C300 131 360 131 420 129 C470 127 520 128 560 126 C600 124 638 120 664 112 C680 106 690 100 696 96 L700 85 L703 77 C704 75 706 75 707 77 L710 87 C712 90 715 91 718 88 L722 80 L725 73 C726 71 731 71 733 73 L737 80 C739 85 741 87 744 86 L747 83 L751 77 C753 74.5 756 74.5 757 77 L760 85 L763 92 C769 100 786 107 812 112 C846 122 900 126 960 126 C1030 126 1076 124 1106 121 L1118 114 C1122 110 1128 108 1136 108 L1248 107 C1258 107 1263 110 1266 115 L1276 125 C1320 130 1380 131 1440 131";
const ridgeMid =
  "M0 152 C30 151 60 148 84 143 L102 132 C106 126 110 121 116 119 L126 109 C129 104 134 102 142 102 L244 101 C248 101 250 104 254 104 C258 104 260 101 264 101 L302 101 C310 101 315 104 319 109 L330 122 C336 128 348 133 366 137 C420 145 480 149 540 149 C620 149 700 147 760 147 C840 147 920 148 990 147 C1040 146 1068 143 1088 137 L1104 125 C1108 119 1114 117 1122 117 L1208 116 C1214 116 1218 113 1224 113 L1234 114 C1242 114 1246 118 1250 123 L1260 135 C1290 143 1340 147 1380 148 C1410 149 1430 149 1440 149";
const ridgeNear =
  "M0 170 C60 164 120 159 180 160 C240 161 282 169 340 172 C440 176 560 173 660 175 C780 178 900 177 1000 173 C1080 170 1140 162 1200 160 C1262 158 1330 162 1380 165 C1410 167 1430 167 1440 167";
const toFoot = (edge: string) => `${edge} V200 H0 Z`;

const flagRuns = [
  { side: "left", cord: runCord(-1), flags: runFlags(-1) },
  { side: "right", cord: runCord(1), flags: runFlags(1) },
];

const email = "elizabetharmstrongtherapy@gmail.com";
const mailto = `mailto:${email}?subject=${encodeURIComponent("Relational Summit V registration")}`;
---

<BaseLayout
  title="Sedona Retreat | Elizabeth Armstrong Therapy"
  description="The Matter of Us, Relational Summit V: the fifth annual Sedona retreat Elizabeth Armstrong guides with a colleague, March 18–20, 2027. Workshops, Zen meditation and gentle yoga, a group hike to a vortex, a sound bath and plant-based meals."
>
  <div class="retreat-page">
    <!-- The trail: one dotted path from the trailhead in the hero down to the
         summit cairn. retreat-trail.js draws it through every [data-trail-point]
         and reveals it as you scroll. -->
    <svg class="trail-svg" aria-hidden="true" focusable="false">
      <defs>
        <mask id="trail-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="100%" height="100%">
          <path class="trail-reveal" d=""></path>
        </mask>
      </defs>
      <g mask="url(#trail-mask)">
        <path class="trail-bed" d=""></path>
        <path class="trail-dots" d=""></path>
      </g>
    </svg>

    <!-- ============================================================
         1. HERO: a red-rock horizon under a wide desert sky
         ============================================================ -->
    <section class="retreat-hero">
      <div class="retreat-hero-content">
        <p class="eyebrow retreat-eyebrow">March 18&ndash;20, 2027 in Sedona, Arizona</p>
        <h1 class="retreat-title">The Matter of Us</h1>
        <p class="retreat-subtitle">Relational Summit V: On Mattering, Belonging, and Becoming</p>
        <p class="retreat-lead">
          Three days in Sedona's red-rock country, for our fifth annual retreat.
        </p>
        <a href="#register" class="btn btn-lg retreat-btn">How to register</a>
      </div>

      <RedRockHorizon class="mesa-scene" aria-hidden="true" />
      <Cairn class="retreat-trailhead" variant={2} aria-hidden="true" />
      <span class="trail-point trail-start" data-trail-point aria-hidden="true"></span>
    </section>

    <!-- ============================================================
         2. WHAT THIS IS: in her words, beside a snapshot from the trail
         ============================================================ -->
    <section class="retreat-intro">
      <span class="retreat-sprig" aria-hidden="true"><JuniperSprig /></span>
      <div class="container retreat-intro-grid">
        <div class="retreat-intro-text reveal">
          <h2>A few days in the red rocks</h2>
          <p>
            Beyond talk therapy, this retreat is a chance to explore our relationships with
            ourselves and one another, out in nature, with a big dose of Sedona magic and a
            connection to energies bigger than ourselves.
          </p>
          <p>
            My colleague and I guide it together every year. This one is called The Matter of Us: a
            summit on mattering, belonging, and becoming.
          </p>
          <p>If it calls to you, I would love to have you there.</p>
        </div>

        <div class="retreat-gutter" aria-hidden="true">
          <span class="trail-point trail-bend trail-bend-a" data-trail-point></span>
          <span class="trail-point trail-bend trail-bend-b" data-trail-point></span>
        </div>

        <figure class="retreat-snapshot reveal stagger-2">
          <span class="snapshot-tape" aria-hidden="true"></span>
          <img
            src={withBase("/images/retreat-trail.jpg")}
            alt="Elizabeth and her colleague smiling on a red-dirt trail under a string of colorful prayer flags, with trees behind them"
            width="780"
            height="975"
            loading="lazy"
          />
          <figcaption>out on the red dirt</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============================================================
         3. THE TRAIL: six cairns, one for each thing that's included
         ============================================================ -->
    <section class="trail-section" aria-labelledby="trail-heading">
      <div class="container">
        <div class="trail-heading reveal">
          <h2 id="trail-heading">What's included</h2>
          <p>Everything along this trail comes with your spot.</p>
        </div>

        <ul class="trail-stops">
          {
            stops.map((stop, i) => (
              <li class={`trail-stop ${i % 2 === 0 ? "trail-stop-left" : "trail-stop-right"}`}>
                <span class="cairn-marker" aria-hidden="true">
                  <Cairn class="cairn-svg" variant={stop.variant} />
                  <span class="trail-point" data-trail-point data-trail-cairn />
                </span>
                <div class={`trail-stop-text reveal stagger-${(i % 2) + 1}`}>
                  <h3>{stop.title}</h3>
                  <p>{stop.gloss}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- ============================================================
         4. ON BELONGING: a print from a past summit, hung on prayer flags
         ============================================================ -->
    <section class="flagline-section">
      <div class="container flagline-grid">
        <div class="flagline-hang reveal">
          {
            /* Three cotton flags, each lifted by the wind differently: the body
               (filled with currentColor, so each tone is set from CSS), a fold
               in shadow, a sunlit fold, the sewn sleeve the cord runs through,
               the woodblock print (a jewel between lines of prayer) and a few
               frayed threads at the hem. */
          }
          <svg class="flagline-defs" width="0" height="0" aria-hidden="true" focusable="false">
            <defs>
              <g id="flagline-flag-a">
                <path
                  fill="currentColor"
                  stroke="#6b4234"
                  stroke-opacity="0.3"
                  stroke-width="0.6"
                  d="M-14 0 H14 C14.8 7 13.4 15 14.4 23 C15 28.5 13.8 32.5 14.2 35.2 C10 36.6 6.2 34.4 1.6 36 C-2.6 37.4 -8.2 35 -14.4 36.8 C-13.6 30.6 -15 22.4 -13.9 14.2 C-13.3 8.6 -14.5 4.2 -14 0 Z"
                ></path>
                <path
                  fill="#5b3326"
                  fill-opacity="0.13"
                  d="M2.5 0 C4.2 9 1.8 21 4.4 35.4 C6.2 34.9 7.8 34.7 9.6 34.9 C7.4 22 9.4 10 7.6 0 Z"
                ></path>
                <path
                  fill="#fffaf2"
                  fill-opacity="0.2"
                  d="M-9.6 0 C-8.4 11 -10.6 24 -8.8 36 L-5.6 35.4 C-7.4 23.6 -5.2 11 -6.4 0 Z"
                ></path>
              </g>
              <g id="flagline-flag-b">
                <path
                  fill="currentColor"
                  stroke="#6b4234"
                  stroke-opacity="0.3"
                  stroke-width="0.6"
                  d="M-14 0 H14 C13.4 6 14.9 13 14.1 20 C13.4 26.4 14.6 31 13.6 35.8 C9.4 34.6 5.6 36.6 0.8 35.4 C-3.8 34.2 -8.4 36.6 -14.2 35.6 C-14.8 29 -13.2 22 -14.3 15.6 C-15 9.6 -13.6 4.6 -14 0 Z"
                ></path>
                <path
                  fill="#5b3326"
                  fill-opacity="0.12"
                  d="M-5.4 0 C-3.2 11 -6.6 23 -3.6 35.2 C-1.6 35.6 0.4 35.6 2 35.4 C-0.8 23 1.8 11 0.2 0 Z"
                ></path>
                <path
                  fill="#5b3326"
                  fill-opacity="0.07"
                  d="M9 0 C10.4 10 8.6 22 10.6 34.9 L13.6 35.8 C14.6 31 13.4 26.4 14.1 20 C14.9 13 13.4 6 14 0 Z"
                ></path>
                <path
                  fill="#fffaf2"
                  fill-opacity="0.18"
                  d="M3.4 0 C5 10 2.8 22 4.8 35.6 L7.4 35.3 C5.6 22 7.8 10 6.2 0 Z"></path>
              </g>
              <g id="flagline-flag-c">
                <path
                  fill="currentColor"
                  stroke="#6b4234"
                  stroke-opacity="0.3"
                  stroke-width="0.6"
                  d="M-14 0 H14 C14.6 8.4 15.2 17 14.6 25 C14.2 29.6 15 32.6 14.8 34.6 C11 36.2 7.4 33.6 3 35.6 C-1.6 37.6 -6.4 34.8 -10.6 36.6 C-12.2 37.2 -13.6 36.4 -14.6 36 C-14 29 -13.2 20 -13.8 12 C-14.2 7 -14.2 3.4 -14 0 Z"
                ></path>
                <path
                  fill="#5b3326"
                  fill-opacity="0.12"
                  d="M-12 0 C-10.6 12 -12.8 25 -10.6 36.6 C-12.2 37.2 -13.6 36.4 -14.6 36 C-14 29 -13.2 20 -13.8 12 C-14.2 7 -14.2 3.4 -14 0 Z"
                ></path>
                <path
                  fill="#5b3326"
                  fill-opacity="0.1"
                  d="M6 0 C8.6 9 5.6 22 8.8 34.8 C10.6 34.6 12.2 34.8 14 34.9 C12 22 13.6 10 11.4 0 Z"
                ></path>
                <path
                  fill="#fffaf2"
                  fill-opacity="0.17"
                  d="M-4 0 C-2.4 12 -5 24 -2.8 36.4 L0.2 36.1 C-1.8 24 0.6 12 -0.8 0 Z"></path>
              </g>
              <g id="flagline-print">
                <rect x="-14" y="0" width="28" height="3.6" fill="#5b3326" fill-opacity="0.14"
                ></rect>
                <path
                  d="M-14 3.6 H14"
                  stroke="#5b3326"
                  stroke-opacity="0.2"
                  stroke-width="0.5"
                  stroke-dasharray="1.4 1.1"></path>
                <g
                  stroke="#4a2a1f"
                  stroke-opacity="0.38"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  fill="none"
                >
                  <path
                    stroke-width="0.6"
                    d="M-8.6 8.4 C-3 8 3 8.2 8.4 8.6 C8.8 14.6 8.6 21 8.2 27.4 C2.8 27.8 -3 27.6 -8.4 27.2 C-8.8 21 -8.6 14.6 -8.6 8.4 Z"
                  ></path>
                  <path
                    stroke-width="0.55"
                    stroke-dasharray="1.8 0.7 2.6 0.8 1.2 0.9"
                    d="M-6.6 10.8 H6.4 M-6.6 12.7 H6.4 M-6.6 22.8 H6.4 M-6.6 24.8 H6.4"></path>
                  <path
                    stroke-width="0.7"
                    d="M0 14.6 C2 16 2.6 17.8 0 20.6 C-2.6 17.8 -2 16 0 14.6 Z M-3.6 18.6 C-2.2 19.6 -1.4 19.6 -1 18.8 M3.6 18.6 C2.2 19.6 1.4 19.6 1 18.8"
                  ></path>
                </g>
              </g>
            </defs>
          </svg>
          {
            flagRuns.map((run) => (
              <svg
                class={`flagline-run flagline-run-${run.side}`}
                viewBox={`0 0 ${RUN} ${RUN_H}`}
                fill="none"
                aria-hidden="true"
                focusable="false"
              >
                {run.flags.map((f) => (
                  <g
                    class={`flagline-flag flagline-tone-${f.tone}${f.worn ? " flagline-worn" : ""}`}
                    transform={`translate(${f.x} ${f.y}) rotate(${f.angle}) skewX(${f.skew}) scale(1 ${f.drop})`}
                    data-flag
                  >
                    <use href={`#flagline-flag-${f.shape}`} />
                    <use href="#flagline-print" />
                    <path
                      class="flagline-thread"
                      d={
                        f.shape === "b"
                          ? "M-9 35.6 l-0.5 2.4 M5.6 35.8 l0.4 2"
                          : "M-6 36 l0.3 2.2 M9.4 35.4 l-0.4 2.3 M10.6 35.3 l0.2 1.6"
                      }
                    />
                  </g>
                ))}
                <path class="flagline-string" d={run.cord} />
                <path class="flagline-string-twist" d={run.cord} />
              </svg>
            ))
          }
          <svg
            class="flagline-span"
            viewBox="0 0 100 6"
            preserveAspectRatio="none"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path class="flagline-string" d="M0 1 Q50 4 100 1"></path>
          </svg>
          <figure class="flagline-print">
            <span class="flagline-clip flagline-clip-left" aria-hidden="true"
              ><Clothespin variant={1} /></span
            >
            <span class="flagline-clip flagline-clip-right" aria-hidden="true"
              ><Clothespin variant={2} /></span
            >
            <img
              src={withBase("/images/retreat-circle.jpg")}
              alt="Elizabeth and her colleague sitting on the wooden floor in front of a smiling group of guests from a past summit, in a bright studio with tall plants behind them"
              width="1056"
              height="752"
              loading="lazy"
            />
            <figcaption>a circle from a past summit</figcaption>
          </figure>
        </div>

        <div class="retreat-gutter flagline-gutter" aria-hidden="true">
          <span class="trail-point trail-bend trail-bend-c" data-trail-point></span>
          <span class="trail-point trail-bend trail-bend-d" data-trail-point></span>
        </div>

        <div class="flagline-text reveal stagger-2">
          <span class="flagline-spiral" aria-hidden="true"><VortexSpiral /></span>
          <h2>On belonging</h2>
          <p>Belonging is easier to feel than to explain.</p>
        </div>
      </div>
    </section>

    <!-- ============================================================
         5. THE DETAILS: a trail permit with a tear-off stub
         ============================================================ -->
    <section class="permit-section" aria-labelledby="permit-heading">
      <span class="permit-agave" aria-hidden="true"><DesertAgave /></span>
      <div class="container">
        <div class="permit-wrap">
          <span class="trail-point trail-bend permit-bend-top" data-trail-point aria-hidden="true"
          ></span>
          <span
            class="trail-point trail-bend permit-bend-bottom"
            data-trail-point
            aria-hidden="true"></span>

          <h2 id="permit-heading" class="permit-heading reveal">The details</h2>

          <div class="permit reveal stagger-1">
            <div class="permit-main">
              <p class="permit-kind">Summit pass</p>
              <p class="permit-title">The Matter of Us</p>
              <p class="permit-sub">Relational Summit V</p>
              <dl class="permit-fields">
                <div class="permit-field">
                  <dt>Place</dt>
                  <dd>Sedona, Arizona</dd>
                </div>
                <div class="permit-field">
                  <dt>Per guest</dt>
                  <dd>$649</dd>
                </div>
                <div class="permit-field">
                  <dt>Early bird</dt>
                  <dd>$549 if you register by January&nbsp;1, 2027</dd>
                </div>
                <div class="permit-field">
                  <dt>On your own</dt>
                  <dd>Transportation and lodging</dd>
                </div>
              </dl>
            </div>

            <div class="permit-stub">
              <span class="permit-stamp-wrap" aria-hidden="true">
                <svg class="permit-stamp" viewBox="0 0 120 120" focusable="false">
                  <defs>
                    <path id="permit-ring" d="M60 60 m-44 0 a44 44 0 1 1 88 0 a44 44 0 1 1 -88 0"
                    ></path>
                  </defs>
                  <circle cx="60" cy="60" r="56"></circle>
                  <circle cx="60" cy="60" r="33"></circle>
                  <text>
                    <textPath
                      href="#permit-ring"
                      startOffset="0"
                      textLength="272"
                      lengthAdjust="spacing"
                      >Relational Summit V &#10022; Sedona, Arizona &#10022;</textPath
                    >
                  </text>
                </svg>
                <span class="permit-stamp-spiral"><VortexSpiral /></span>
              </span>
              <p class="permit-valid">
                <span>Valid</span>
                March 18&ndash;20, 2027
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         6. THE SUMMIT: how to register, at golden hour
         ============================================================ -->
    <section class="summit-section" id="register" aria-labelledby="summit-heading">
      <svg
        class="summit-ridge"
        viewBox="0 0 1440 200"
        preserveAspectRatio="xMidYMax slice"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <defs>
          {
            /* Each stratum fades out toward the svg's foot, where the section lands on
               the footer's colour */
          }
          <linearGradient
            id="summit-far-fill"
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1="70"
            x2="0"
            y2="200"
          >
            <stop offset="0" stop-color="#ecb89e" stop-opacity="0.95"></stop>
            <stop offset="0.55" stop-color="#efc4ac" stop-opacity="0.75"></stop>
            <stop offset="1" stop-color="#f4d9c8" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient
            id="summit-mid-fill"
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1="100"
            x2="0"
            y2="200"
          >
            <stop offset="0" stop-color="#df9f83" stop-opacity="1"></stop>
            <stop offset="0.6" stop-color="#e7b298" stop-opacity="0.7"></stop>
            <stop offset="1" stop-color="#f0cdb9" stop-opacity="0"></stop>
          </linearGradient>
          <linearGradient
            id="summit-near-fill"
            gradientUnits="userSpaceOnUse"
            x1="0"
            y1="158"
            x2="0"
            y2="200"
          >
            <stop offset="0" stop-color="#d48f75" stop-opacity="0.95"></stop>
            <stop offset="0.55" stop-color="#e2a98f" stop-opacity="0.55"></stop>
            <stop offset="1" stop-color="#eec6b2" stop-opacity="0"></stop>
          </linearGradient>
          <clipPath id="summit-clip-far"><path d={toFoot(ridgeFar)}></path></clipPath>
          <clipPath id="summit-clip-mid"><path d={toFoot(ridgeMid)}></path></clipPath>
        </defs>

        <!-- 1. Far mesas and the summit's three spires, back-lit: a pale rim of light
             along the top -->
        <g class="summit-far">
          <path d={toFoot(ridgeFar)} fill="url(#summit-far-fill)"></path>
          <g class="summit-strata" clip-path="url(#summit-clip-far)">
            <path d="M126 118 C160 117 200 117 246 120" stroke-dasharray="34 6 14 8"></path>
            <path d="M694 98 C720 96 750 96 772 99" stroke-dasharray="14 4 22 5"></path>
            <path d="M716 86 C724 85 732 85 740 87" stroke-dasharray="9 3"></path>
