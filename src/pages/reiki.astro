---
import { withBase } from "@/lib/withBase";
import BaseLayout from "../layouts/BaseLayout.astro";
import "@styles/pages/reiki.css";
import {
  IconSun,
  IconCrescentMoon,
  IconFullMoon,
  IconStar,
  IconHandsOpen,
  IconCompass,
  IconHeart,
} from "@illustrations/icons";
import {
  HandsCupped,
  DaybreakSun,
  RisingSun,
  DawnHills,
  SedonaVignette,
} from "@illustrations/scenes";
import { HerbSprig, LavenderSprig } from "@illustrations/botanicals";
import { CtaVineLeft, CtaVineRight } from "@illustrations/frames";
---

<BaseLayout
  title="Reiki in Orange County | Elizabeth Armstrong Therapy"
  description="Gentle Reiki energy work in Orange County, offered by Elizabeth Armstrong — certified Reiki Master and licensed therapist. A separate, private-pay hour of rest: you stay fully clothed while your own system settles. Not psychotherapy."
>
  <div class="reiki-page">
    <!-- Daybreak: a single sun climbs the page's right edge as you scroll (GSAP-scrubbed),
         turning the whole page into one continuous dawn. It sits between each section's
         ground and its content (see "Layering" in reiki.css). -->
    <div class="daybreak" aria-hidden="true">
      <span class="daybreak-sun"><DaybreakSun class="daybreak-sun-art" /></span>
    </div>

    <!-- ============================================================
         1. CONDUIT HERO — the source: held light + a real beam
         ============================================================ -->
    <section class="conduit-hero">
      <div class="light-beam" aria-hidden="true"></div>
      <div class="conduit-motes" aria-hidden="true"></div>

      <div class="conduit-hero-content">
        <span class="conduit-hands" aria-hidden="true">
          <span class="conduit-orb"></span>
          <HandsCupped class="conduit-hands-svg" />
        </span>
        <p class="eyebrow">Energy Work</p>
        <h1 class="conduit-title">Reiki</h1>
        <p class="conduit-script">where the light comes in</p>
        <p class="conduit-lead">
          A gentle, hands-resting energy practice &mdash; and one of the more woo-woo things I love.
          You lie back, fully clothed, and rest while your own system does the settling.
        </p>
        <a href={withBase("/contact.html")} class="btn btn-primary btn-lg"
          >Schedule a Free Consultation</a
        >
      </div>
    </section>

    <!-- ============================================================
         2. ESSENCE — what Reiki is, and what it isn't (honest + spread,
            merged into one portrait-anchored centerpiece on the mauve dark)
         ============================================================ -->
    <section class="section section-lg essence-section">
      <div class="container">
        <div class="essence-grid">
          <div class="essence-intro reveal-left">
            <figure class="essence-photo">
              <img
                src={withBase("/images/reiki-honest.jpg")}
                alt="Elizabeth Armstrong sitting calmly outdoors, resting her chin on her hand"
                width="1400"
                height="933"
                loading="lazy"
              />
            </figure>
            <p class="eyebrow">My Practice</p>
            <h2>How I work with Reiki</h2>
            <p>
              Reiki is a gentle energy practice with Japanese roots. It moves stuck energy and
              brings the chakras back into balance. You rest, fully clothed and comfortable, while I
              place my hands lightly on or just above you. Along with light touch, I work with
              crystal placement, essential oils, tuning forks, and drumming.
            </p>
          </div>

          <div class="essence-spread reveal-right">
            <div class="spread-pane is-pane lit-card">
              <span class="spread-icon" aria-hidden="true"><IconHandsOpen /></span>
              <h3>What Reiki is</h3>
              <ul>
                <li>Energy work that clears blocks and restores balance</li>
                <li>Your own healing at work, with me as the conduit</li>
                <li>
                  Offered by a certified Reiki Master: certified in 2020, Master level since 2021
                </li>
                <li>A full session of deep rest, fully clothed</li>
              </ul>
            </div>

            <span class="spread-seam" aria-hidden="true"></span>

            <div class="spread-pane isnt-pane lit-card">
              <span class="spread-icon" aria-hidden="true"><IconCompass /></span>
              <h3>What to know before you book</h3>
              <ul>
                <li>Reiki is separate from psychotherapy, with its own sessions and fee.</li>
                <li>Sessions are private-pay and not billed to insurance.</li>
                <li>Reiki works alongside medical and mental health care, never in place of it.</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         4. THE CONDUIT QUOTE — her own words beside a lit, arched portrait
         ============================================================ -->
    <section class="section section-lg conduit-quote-section">
      <div class="container conduit-quote-inner">
        <div class="conduit-quote-portrait reveal">
          <div class="conduit-quote-door">
            <img
              class="conduit-quote-photo"
              src={withBase("/images/reiki-quote.jpg")}
              alt="Elizabeth smiling in a tan hat, standing in a sunlit garden"
              width="1600"
              height="1066"
              loading="lazy"
            />
          </div>
        </div>

        <figure class="conduit-quote reveal stagger-1">
          <blockquote>
            <p>
              <span class="conduit-quote-line">
                <span class="conduit-quote-open" aria-hidden="true">&ldquo;</span>I'm not healing
                you &mdash;
              </span>
              <span class="conduit-quote-line">you're healing you.</span>
              <span class="conduit-quote-line conduit-quote-gap">I'm just being a conduit,</span>
              <span class="conduit-quote-line"
                >like a straw.<span aria-hidden="true">&rdquo;</span></span
              >
            </p>
          </blockquote>
          <figcaption>Elizabeth</figcaption>
        </figure>
      </div>
    </section>

    <!-- ============================================================
         5. HOW A SESSION UNFOLDS — one daybreak timeline
         ============================================================ -->
    <section class="section section-lg light-steps-section">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow">What to Expect</p>
          <h2>How a session unfolds</h2>
        </div>

        <div class="light-steps">
          <span class="steps-thread" aria-hidden="true"></span>

          <div class="light-step reveal stagger-1">
            <span class="light-step-icon" aria-hidden="true"><IconCrescentMoon /></span>
            <span class="light-step-label">first light</span>
            <h3>Settle</h3>
            <p>
              You arrive, kick off your shoes, and get comfortable. We talk briefly about what
              brought you in and, if you like, set an intention for the session &mdash; some people
              like to choose an oracle card to be guided by. Then you let your shoulders drop.
            </p>
          </div>
          <div class="light-step reveal stagger-2">
            <span class="light-step-icon" aria-hidden="true"><IconHandsOpen /></span>
            <span class="light-step-label">the light moves through</span>
            <h3>Channel</h3>
            <p>
              You rest while I keep a light, unhurried touch and tend the space. There's nothing for
              you to do &mdash; no effort, no talking. I just hold the channel open; the quiet work
              underneath is yours.
            </p>
          </div>
          <div class="light-step reveal stagger-3">
            <span class="light-step-icon" aria-hidden="true"><IconSun /></span>
            <span class="light-step-label">full morning</span>
            <h3>Glow</h3>
            <p>
              We ease back out gently &mdash; a breath, a sip of water, no rush. Then we spend a few
              minutes debriefing: what you may have felt, and what I picked up on. Many people say
              they leave feeling softer than they came in.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         6. WHAT IT CAN FEEL LIKE — embodied sensation tiles
         ============================================================ -->
    <section class="section feel-section">
      <div class="container">
        <div class="section-heading reveal">
          <h2>What it can feel like</h2>
        </div>
        <p class="feel-intro reveal">
          Everyone's experience is their own, and some feel more than others &mdash; all of it is
          normal. But when I ask afterward, here's what people tend to say.
        </p>

        <div class="feel-grid">
          <div class="feel-card feel-warmth lit-card reveal stagger-1">
            <span class="feel-glyph" aria-hidden="true"><IconSun /></span>
            <h3>Warmth</h3>
            <p>A soft, spreading warmth where my hands rest, like sun through a window.</p>
          </div>
          <div class="feel-card feel-heavy lit-card reveal stagger-2">
            <span class="feel-glyph" aria-hidden="true"><IconFullMoon /></span>
            <h3>Heaviness</h3>
            <p>A pleasant heaviness, the way your body feels in the minutes before sleep.</p>
          </div>
          <div class="feel-card feel-quiet lit-card reveal stagger-3">
            <span class="feel-glyph" aria-hidden="true"><IconStar /></span>
            <h3>A quiet mind</h3>
            <p>The mental chatter going unusually still, even if just for the hour.</p>
          </div>
          <div class="feel-card feel-rest lit-card reveal stagger-4">
            <span class="feel-glyph" aria-hidden="true"><IconHeart /></span>
            <h3>Simple rest</h3>
            <p>
              Sometimes it's mostly an hour of real, uninterrupted rest &mdash; which is no small
              thing.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         7. ATMOSPHERIC BAND — a breathing pause in the light
         ============================================================ -->
    <section class="atmos-band">
      <img
        class="atmos-photo"
        src={withBase("/images/reiki-band.jpg")}
        alt=""
        width="1800"
        height="1200"
        loading="lazy"
        aria-hidden="true"
      />
      <div class="atmos-scrim" aria-hidden="true"></div>
      <div class="atmos-content reveal">
        <p class="atmos-line">
          No talking required. Nothing to perform. Nothing to fix.<br />Just a deliberate, unhurried
          hour to be still.
        </p>
      </div>
    </section>

    <!-- ============================================================
         8. REIKI + THERAPY — side by side, two separate rooms
         ============================================================ -->
    <section class="section section-lg bridge-section">
      <div class="container">
        <div class="section-heading reveal">
          <h2>Reiki and therapy, side by side</h2>
        </div>

        <div class="bridge-spread reveal">
          <figure class="bridge-photo">
            <img
              src={withBase("/images/reiki-bridge.jpg")}
              alt="Elizabeth Armstrong relaxing at home in warm lamplight"
              width="933"
              height="1400"
              loading="lazy"
            />
          </figure>

          <div class="bridge-panels">
            <div class="bridge-panel">
              <h3>The therapy room</h3>
              <p>
                If you're working through something tender, therapy is the place for that &mdash;
                the deeper, collaborative work of talk therapy, booked and paid for on its own.
              </p>
              <a href={withBase("/index.html")} class="bridge-link"
                >About the therapy side of my practice</a
              >
            </div>

            <span class="kintsugi-seam" aria-hidden="true"></span>

            <div class="bridge-panel">
              <h3>The Reiki room</h3>
              <p>
                Some people see me for both, and that's a beautiful thing &mdash; but they stay
                separate. Reiki can be a gentle companion to the deeper work, never a replacement
                for it.
              </p>
              <div class="reiki-fees-note">
                <span class="fees-label">About the fee</span>
                <p>
                  <strong>$100 for 60 minutes, or $125 for 75 minutes.</strong> A private-pay offering,
                  never billed to insurance. If you'd like to talk it through first, the free 15-minute
                  call is the same easy conversation whether you're curious about Reiki, therapy, or both.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         9. ON THE HORIZON — the annual Sedona retreat
         ============================================================ -->
    <section class="section horizon-section" id="retreat">
      <div class="container">
        <div class="section-heading reveal">
          <p class="eyebrow">Also Growing Here</p>
          <h2>On the horizon</h2>
        </div>
        <p class="horizon-intro reveal">
          Reiki is one of the more embodied ways I work, beyond the therapy room. Once a year, I
          also guide a retreat with my colleague &mdash; if it calls to you, mention it when we
          talk.
        </p>

        <div class="horizon-card reveal">
          <span class="horizon-card-art" aria-hidden="true"><SedonaVignette /></span>
          <span class="soon-chip">March 18&ndash;20, 2027</span>
          <h3>Annual Retreat</h3>
          <p class="horizon-card-nature">Sedona, Arizona&nbsp;&middot; our fifth year</p>
          <p>
            Beyond talk therapy, these retreats explore our relationships with ourselves and one
            another in nature &mdash; with a big dose of Sedona magic, and a connection to energies
            bigger than ourselves.
            <br />
            <a href={withBase("/retreat.html")} class="bridge-link">See the retreat details</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================================
         10. FULL-BLOOM CTA — sunrise over the horizon, the climax
         ============================================================ -->
    <section class="bloom-cta">
      <!-- Back to front: the sun (its disc carries the words), the hills it rises
           over, then the plants standing in front of both -->
      <RisingSun class="bloom-sun" />
      <DawnHills class="bloom-hills" />
      <span class="bloom-botanical bloom-botanical-1" aria-hidden="true"><HerbSprig /></span>
      <span class="bloom-botanical bloom-botanical-2" aria-hidden="true"><LavenderSprig /></span>
      <span class="bloom-vine bloom-vine-left" aria-hidden="true"><CtaVineLeft /></span>
      <span class="bloom-vine bloom-vine-right" aria-hidden="true"><CtaVineRight /></span>

      <div class="bloom-cta-content reveal">
        <h2>Curious is enough</h2>
        <p>
          Let's have a free 15-minute conversation about what you're looking for &mdash; ask me
          anything, skeptic questions warmly welcome. No commitment, no pressure, just a place to
          start.
        </p>
        <a href={withBase("/contact.html")} class="btn btn-primary btn-lg bloom-btn"
          >Schedule Your Free Consultation</a
        >
      </div>
    </section>
  </div>
</BaseLayout>

<!-- Daybreak on scroll — GSAP ScrollTrigger climbs the sun up the page's right edge,
     scrubbed to scroll position, and hands over to the closing sunrise. Bundled by
     Astro/Vite. (Mirrors the homepage roots system; under reduced motion the sun holds
     still in mid-sky and only steps aside for the closing sunrise.) -->
<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const page = document.querySelector(".reiki-page");
  const sun = document.querySelector<HTMLElement>(".daybreak-sun");
  const art = document.querySelector(".daybreak-sun-art");
  const finale = document.querySelector(".bloom-cta");

  if (page && sun && !prefersReduced) {
    // The element is a square with the disc at its centre (disc radius = 11.5% of the
    // side), so every position below is worked out for the centre.
    const headerH = () =>
      parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 0;
    const side = () => sun.offsetWidth;

    // From low in the hero's lower corner to just under the header: one continuous
    // daybreak. Brightens and shrinks as it rises.
    gsap.fromTo(
      sun,
      { y: () => window.innerHeight * 0.9 - side() / 2, scale: 1.12, opacity: 0.82 },
      {
        y: () => headerH() + 22 + side() * 0.105 - side() / 2,
        scale: 0.9,
        opacity: 1,
        ease: "none",
        scrollTrigger: {
          trigger: page,
          start: "top top",
          end: "bottom bottom",
          scrub: 1,
          invalidateOnRefresh: true,
        },
      },
    );

    // The closing section has its own sunrise, so this sun dissolves as that one arrives
    // (which also keeps it off the footer).
    if (art && finale) {
      gsap.to(art, {
        opacity: 0,
        ease: "none",
        scrollTrigger: { trigger: finale, start: "top 96%", end: "top 48%", scrub: true },
      });
    }

    // Keep positions honest as fonts/images settle and on resize.
    window.addEventListener("load", () => ScrollTrigger.refresh());
  } else if (sun && finale && "IntersectionObserver" in window) {
    // Reduced motion: no travel, but still never two suns at once
    new IntersectionObserver(([entry]) => sun.classList.toggle("is-set", entry.isIntersecting), {
      rootMargin: "0px 0px -20% 0px",
    }).observe(finale);
  }
</script>
