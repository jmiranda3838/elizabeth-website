---
import { withBase } from "@/lib/withBase";
import BaseLayout from "../layouts/BaseLayout.astro";
import { IconFiddlehead, PlusExpand } from "@illustrations/icons";
import { FernBank, MeadowHorizon } from "@illustrations/scenes";
---

<BaseLayout
  title="FAQs | Elizabeth Armstrong Therapy"
  description="Frequently asked questions about therapy with Elizabeth Armstrong, LMFT. Learn about sessions, fees, insurance, and what to expect."
>
  <!-- Page Hero -->
  <section class="page-hero page-hero-scene">
    <div class="container">
      <h1>Frequently Asked Questions</h1>
      <p class="lead">
        Everything you might want to know about working together. If you don't see your question
        here, please reach out.
      </p>
    </div>
    <FernBank class="page-hero-art" aria-hidden="true" />
  </section>

  <!-- FAQ Content -->
  <section class="section bg-paper">
    <div class="container container-narrow">
      <!-- Getting Started Section -->
      <div class="faq-section" id="getting-started">
        <h2><IconFiddlehead class="faq-mark" aria-hidden="true" />Getting Started</h2>
        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              How do I schedule a first appointment?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  The first step is scheduling a free 15-minute consultation. This gives us a chance
                  to talk briefly about what brings you to therapy and whether we might be a good
                  fit. You can request a consultation through my <a href={withBase("/contact.html")}
                    >contact page</a
                  > or by calling (949) 444-3899.
                </p>
                <p>
                  If we decide to move forward, we'll find a time for your first full session. I
                  typically have availability within 1-2 weeks.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              What happens in the first session?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  Our first session is about getting to know each other. I'll ask questions about
                  what brings you to therapy, your history, and what you're hoping to get out of our
                  work together. You'll also have space to ask me anything you'd like.
                </p>
                <p>
                  There's no pressure to share everything at once. We'll move at a pace that feels
                  comfortable for you. By the end of the session, we'll have a sense of direction
                  and can discuss how often we might meet.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              How do I know if you're the right therapist for me?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  The relationship between therapist and client is one of the most important factors
                  in successful therapy. That's why I offer a free consultation, so you can get a
                  sense of me before committing.
                </p>
                <p>
                  Pay attention to how you feel during our conversation. Do you feel heard?
                  Comfortable? Like you could open up to me? It's okay if you're nervous (that's
                  normal), but you should feel a basic sense of connection and trust.
                </p>
                <p>
                  If after a few sessions you feel we're not the right fit, I'm happy to help you
                  find another therapist who might be better suited to your needs.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Logistics Section -->
      <div class="faq-section" id="logistics">
        <h2><IconFiddlehead class="faq-mark" aria-hidden="true" />Logistics</h2>
        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              How long are sessions?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  Standard sessions are 50 minutes. A longer 90-minute session is also available for
                  individuals, couples, or families &mdash; helpful for deeper pieces of work.
                  We&rsquo;ll decide together what fits.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              How often will we meet?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  Most clients meet weekly, especially at the beginning of therapy. This frequency
                  helps build momentum and allows us to work more deeply. As therapy progresses and
                  you're feeling more stable, we may shift to every other week or monthly sessions.
                </p>
                <p>
                  Ultimately, the frequency is something we'll decide together based on your needs,
                  goals, and circumstances.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              Do you offer telehealth sessions?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  Yes! I offer secure video sessions for clients anywhere in California. Telehealth
                  makes therapy more accessible and fits into busy lives. Many clients find it just
                  as effective as in-person work.
                </p>
                <p>
                  I use a HIPAA-compliant platform to ensure your privacy. All you need is a private
                  space, a reliable internet connection, and a device with a camera.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              What is your cancellation policy?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  I ask for at least 24 hours' notice if you need to cancel or reschedule. Late
                  cancellations or missed sessions are charged the full session fee.
                </p>
                <p>
                  I understand that emergencies happen. If something truly unexpected comes up,
                  please reach out and we can discuss.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Fees & Insurance Section -->
      <div class="faq-section" id="fees">
        <h2><IconFiddlehead class="faq-mark" aria-hidden="true" />Fees & Insurance</h2>
        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              What are your fees?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>50-minute individual session: $185</p>
                <p>50-minute couple or family session: $225</p>
                <p>90-minute session (individual, couple, or family): $300</p>
                <p>
                  I offer a limited number of sliding-scale spots for those who need them. If cost
                  is a barrier, please mention it during our consultation and we can discuss
                  options. For the full breakdown, see my <a href={withBase("/fees.html")}
                    >Fees &amp; Insurance</a
                  > page.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              Do you accept insurance?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  I am an out-of-network provider, which means I don't bill insurance directly.
                  However, if you have out-of-network benefits, you may be able to receive partial
                  reimbursement for our sessions.
                </p>
                <p>
                  I can provide you with a superbill (a detailed receipt) that you can submit to
                  your insurance company for potential reimbursement. I recommend contacting your
                  insurance provider to ask about your out-of-network mental health benefits before
                  we begin.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              What forms of payment do you accept?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  I accept cash, check, major credit cards, and HSA cards. Payment is due at the
                  time of each session.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              What is a Good Faith Estimate?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  Under the No Surprises Act, you have the right to receive a "Good Faith Estimate"
                  explaining how much your care will cost. This estimate is based on the information
                  we have at the time and may change as treatment evolves.
                </p>
                <p>
                  I will provide you with a Good Faith Estimate before we begin therapy. If you have
                  questions about this, please don't hesitate to ask.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- About Therapy Section -->
      <div class="faq-section" id="about-therapy">
        <h2><IconFiddlehead class="faq-mark" aria-hidden="true" />About Therapy</h2>
        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              What is narrative therapy?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  Narrative therapy is based on the idea that we make sense of our lives through
                  stories. The stories we tell about ourselves, often shaped by our families,
                  culture, and experiences, influence how we see ourselves and what we believe is
                  possible.
                </p>
                <p>
                  In narrative therapy, we work to understand the stories that have been shaping
                  your life, separate you from the problems you're facing (you are not the problem),
                  and discover alternative stories that align with your values and hopes.
                </p>
                <p>
                  It's a respectful, non-pathologizing approach that honors your expertise on your
                  own life.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              How long does therapy take?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  There's no fixed timeline for therapy. Some people come for a few months to work
                  through a specific issue; others engage in longer-term work to address deeper
                  patterns. It depends on your goals, your situation, and how quickly things shift.
                </p>
                <p>
                  We'll check in regularly about how you're feeling and whether therapy is meeting
                  your needs. You're always in control of when to continue and when to end.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              Is what I share in therapy confidential?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  Yes, confidentiality is fundamental to therapy. What you share stays between us,
                  with a few legal exceptions that I'll explain fully before we begin (such as
                  imminent risk of harm to yourself or others, or suspected abuse of a child or
                  vulnerable adult).
                </p>
                <p>
                  For couples and family therapy, we'll discuss confidentiality boundaries at the
                  start so everyone understands how information will be handled.
                </p>
              </div>
            </div>
          </div>

          <div class="faq-item">
            <button class="faq-question" aria-expanded="false">
              Do you offer anything besides talk therapy?
              <PlusExpand class="faq-icon" />
            </button>
            <div class="faq-answer">
              <div class="faq-answer-content">
                <p>
                  Yes &mdash; I also offer <a href={withBase("/reiki.html")}>Reiki</a>, a gentle
                  energy practice that is separate from therapy: its own kind of session, with its
                  own private-pay fee, never billed to insurance, and never a substitute for medical
                  or psychological care.
                </p>
                <p>
                  Walk-and-talk therapy sessions by the ocean are available by request, and once a
                  year I guide <a href={withBase("/retreat.html")}>a retreat in Sedona</a> with my colleague
                  &mdash; if either calls to you, mention it when we talk.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Crisis Information -->
      <div class="crisis-callout">
        <h3>Important: Crisis & Emergency Information</h3>
        <p>
          Therapy is not appropriate for crisis situations. If you are in immediate danger or
          experiencing a mental health emergency, please take one of the following steps:
        </p>
        <p>
          <a href="tel:988"><strong>Call 988</strong></a> (Suicide & Crisis Lifeline, available 24/7)<br
          />
          <a href="tel:911"><strong>Call 911</strong></a> or go to your nearest emergency room<br />
          <a href="sms:741741"><strong>Text HOME to 741741</strong></a> (Crisis Text Line)
        </p>
        <p>
          Please do not use email or my contact form to communicate urgent matters, as I may not see
          messages immediately.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band cta-band-meadow">
    <div class="container">
      <h2>Still have questions?</h2>
      <p>
        I'm happy to answer any questions you have. Reach out for a free consultation and we can
        talk.
      </p>
      <a href={withBase("/contact.html")} class="btn btn-primary btn-lg">Get in Touch</a>
    </div>
    <MeadowHorizon class="cta-meadow" aria-hidden="true" />
  </section>

  <style is:global>
    /* === Pages: FAQ ===
       Each group is a small stack of index cards under a heading marked with a
       fiddlehead; the expand mark is a plus that becomes a seedling on a line. */
    .faq-section {
      margin-bottom: var(--space-12);
    }

    .faq-section h2 {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      margin-bottom: var(--space-5);
      padding-bottom: var(--space-3);
      border-bottom: 1px solid transparent;
      border-image: linear-gradient(
          90deg,
          var(--dusty-peach) 0%,
          rgba(208, 180, 166, 0.5) 45%,
          rgba(208, 180, 166, 0) 100%
        )
        1;
    }

    .faq-mark {
      flex-shrink: 0;
      width: 1.05em;
      height: 1.05em;
      color: var(--sage);
    }

    /* Alternate groups curl the other way, as fiddleheads do */
    .faq-section:nth-of-type(even) .faq-mark {
      transform: scaleX(-1);
      color: var(--muted-rose);
    }

    .faq-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .faq-item {
      position: relative;
      background-color: #fffdfb;
      border: 1px solid rgba(208, 180, 166, 0.5);
      border-radius: var(--radius-md);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.8) inset,
        0 1px 2px rgba(96, 102, 90, 0.05);
      overflow: hidden;
      transition:
        border-color var(--transition-base),
        box-shadow var(--transition-base);
    }

    /* A clay margin line down the left edge of the open card */
    .faq-item::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 3px;
      background-color: var(--muted-rose);
      opacity: 0;
      transition: opacity var(--transition-base);
    }

    .faq-item:hover,
    .faq-item.open {
      border-color: var(--dusty-peach);
      box-shadow:
        0 1px 0 rgba(255, 255, 255, 0.8) inset,
        0 6px 16px rgba(152, 96, 93, 0.09);
    }

    .faq-item.open::before {
      opacity: 1;
    }

    .faq-question {
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-5) var(--space-4) var(--space-6);
      font-family: var(--font-serif);
      font-size: var(--text-xl);
      font-weight: 500;
      line-height: 1.3;
      text-align: left;
      color: var(--text-primary);
      background-color: transparent;
      cursor: pointer;
      transition: background-color var(--transition-fast);
    }

    /* Hover tint only where there is a real pointer, so it does not stick after a tap */
    @media (hover: hover) {
      .faq-question:hover {
        background-color: var(--bg-accent);
      }
    }

    .faq-question:focus-visible {
      outline: 2px solid var(--misty-blue);
      outline-offset: -3px;
      border-radius: var(--radius-md);
    }

    .faq-item.open .faq-question {
      background: linear-gradient(180deg, var(--bg-accent) 0%, rgba(253, 242, 239, 0) 100%);
    }

    .faq-icon {
      width: 32px;
      height: 32px;
      flex-shrink: 0;
      color: var(--misty-blue);
      transition: color var(--transition-base);
    }

    .faq-question:hover .faq-icon,
    .faq-item.open .faq-icon {
      color: var(--clay-deep);
    }

    /* Open: the upright stroke folds away (plus becomes minus) and a seedling
       grows from the bar */
    .faq-icon .plus-v,
    .faq-icon .plus-sprout {
      transform-origin: 12px 12px;
      transition:
        transform var(--transition-base),
        opacity var(--transition-base);
    }

    .faq-icon .plus-sprout {
      transform: scale(0.3);
    }

    .faq-item.open .faq-icon .plus-v {
      transform: scaleY(0);
      opacity: 0;
    }

    .faq-item.open .faq-icon .plus-sprout {
      transform: scale(1);
      opacity: 1;
    }

    /* Closed panels are also hidden from keyboard focus. A transitioning
       visibility stays visible until the close animation has finished */
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      visibility: hidden;
      transition:
        max-height var(--transition-base),
        visibility var(--transition-base);
    }

    .faq-item.open .faq-answer {
      max-height: 1000px;
      visibility: visible;
    }

    .faq-answer-content a {
      color: var(--clay-deep);
      text-decoration: underline;
      text-underline-offset: 2px;
    }

    .faq-answer-content {
      padding: var(--space-2) var(--space-6) var(--space-6);
      font-size: var(--text-base);
      color: var(--text-secondary);
      line-height: 1.7;
    }

    .faq-answer-content p:last-child {
      margin-bottom: 0;
    }

    @media (max-width: 600px) {
      .faq-question {
        padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
        font-size: var(--text-lg);
      }

      .faq-answer-content {
        padding: var(--space-2) var(--space-5) var(--space-5);
      }

      .faq-icon {
        width: 28px;
        height: 28px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .faq-item,
      .faq-item::before,
      .faq-icon,
      .faq-icon .plus-v,
      .faq-icon .plus-sprout {
        transition: none;
      }
    }

    /* Crisis callout */
    .crisis-callout {
      padding: var(--space-6);
      background-color: var(--bg-accent);
      border-left: 4px solid var(--muted-rose);
      border-radius: 0 var(--radius-md) var(--radius-md) 0;
      margin-top: var(--space-8);
    }

    .crisis-callout h3 {
      color: var(--warm-clay);
      margin-bottom: var(--space-3);
    }

    .crisis-callout p {
      font-size: var(--text-sm);
      margin-bottom: var(--space-3);
    }

    .crisis-callout p:last-child {
      margin-bottom: 0;
    }

    .crisis-callout a:hover {
      color: var(--warm-clay);
    }

    .crisis-callout a:focus-visible {
      outline: 2px solid var(--misty-blue);
      outline-offset: 3px;
      border-radius: 2px;
    }

    /* Every answer prints, with or without the beforeprint script */
    @media print {
      .faq-answer {
        max-height: none;
        visibility: visible;
        transition: none;
      }
    }
  </style>
</BaseLayout>
